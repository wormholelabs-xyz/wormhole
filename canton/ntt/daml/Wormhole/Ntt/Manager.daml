-- | The NttManager and (single, threshold-1) Wormhole transceiver for Canton.
--
-- Deployment is permissionless and crankless (mirroring core 'RegisterEmitter'):
-- a deployer (@admin@) holding a disclosure to the operator's
-- 'NttManagerRegistry' exercises 'RegisterManager' directly — it allocates a
-- stable @managerId@ and creates the 'NttManager', with the @operator@'s
-- authority inherited from the registry signatory (no guardian crank). The
-- operator and admin co-sign the manager (mirroring 'Emitter'); neither has
-- power over transfer contents (those are gated by the token effect and VAA
-- verification).
--
-- Identities (both key-derived on-ledger, per 'Wormhole.Core.Bytes.derivedAddress'):
--   * transceiver address = keccak256(tag ‖ operator ‖ admin ‖ emitterId) — the
--     core 'Emitter' the deployment publishes through; the VAA emitter other
--     chains register. Derived by the watcher, not stored.
--   * manager address = keccak256(tag ‖ operator ‖ admin ‖ managerId)
--     ('nttManagerAddressFor'). The manager needs its own address on-ledger to
--     build/validate NTT payloads, so it is computed at registration and stored
--     in 'managerAddress' — NOT operator-supplied. @admin@ is part of the
--     preimage and co-signs, so a compromised operator cannot forge an existing
--     manager's address (it could consume that peer's inbound VAAs otherwise).
--
-- There are NO contract keys: every contract is resolved by an explicit
-- contract-id, disclosed by the deployment's disclosure service (README §4.7).
-- The 'NttManager' and its transceiver 'Emitter' churn (both are recreated by
-- their consuming choices), so a sender re-resolves the current cids per send —
-- the same fail-closed retry the core publish/replay paths use.
--
-- Send ('Transfer') rides the core bridge: it publishes via
-- 'Emitter.PublishMessage', so the guardian watcher observes an ordinary core
-- message (no NTT-specific watcher code). The sending @user@ is the sole
-- controller AND pays the message fee: 'PublishMessage' charges @messageFee@ to
-- its @payer@, and @user@'s authority reaches that charge because @user@
-- co-controls 'PublishMessage' as the payer (§ Fees). So a send is fully
-- user-driven — no admin/operator sign-off — and self-funded.
--
-- Receive is PERMISSIONLESS: any @executor@ (a relayer, the recipient, anyone)
-- submits an inbound VAA on the recipient's behalf. The choice is @nonconsuming@,
-- so the operator/admin authority every nested action needs is inherited from
-- 'NttManager''s signatories regardless of who submits — the executor's identity
-- carries no authority, only the disclosures it attaches. Replay protection is
-- the core per-consumer replay trie ('VerifyAndConsumeVAA', scoped to @admin@),
-- and the guardian trust root is authenticated by pinning the disclosed
-- 'CoreState''s @guardianGovernance@ to the anchor the admin committed at
-- deployment (see 'Receive'). It then enforces the configured peer, decodes,
-- binds the caller-supplied @recipient@ to the VAA's own @recipientAddress@ via
-- 'recipientAddressFor', and drives the token mint/unlock.
module Wormhole.Ntt.Manager where

import DA.Crypto.Text (keccak256, toHex)
import DA.Map (Map)
import DA.Map qualified as Map
import DA.Optional (fromSomeNote)

import Splice.Api.Token.AllocationV1 (Allocation)
import Splice.Api.Token.HoldingV1 (Holding)
import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Wormhole.Core.Bytes
import Wormhole.Core.Replay (ReplayNode)
import Wormhole.Core.State
  ( Emitter, CoreState
  , GetGuardianGovernance (..), VerifyAndConsumeVAA (..), PublishMessage (..) )
import Wormhole.Core.VAA ()   -- HasField instances for VAA record-dot access
import Wormhole.Ntt.Payload
import Wormhole.Ntt.Token

-- | A configured peer NTT deployment on another chain: its manager address (the
-- @recipientManager@/@sourceManager@ in the transceiver message) and its
-- transceiver address (the VAA emitter we must see inbound). Both 32 bytes.
data Peer = Peer with
    managerAddress     : Bytes32
    transceiverAddress : Bytes32
  deriving (Eq, Show)

normalizePeer : Peer -> Peer
normalizePeer p = Peer with
    managerAddress = normalizeHex p.managerAddress
    transceiverAddress = normalizeHex p.transceiverAddress

-- | Domain-separation tag for NTT manager addresses. Distinct from
-- 'Wormhole.Core.State.emitterAddressTag' so an emitter and a manager with the
-- same @(operator, admin, id)@ ordinals derive different addresses.
nttManagerAddressTag : Text
nttManagerAddressTag = "wormhole:ntt-manager:v1"

-- | The 32-byte NTT manager address of the 'NttManager' allocated at
-- @managerId@ for @(operator, admin)@.
nttManagerAddressFor : Party -> Party -> Int -> Bytes32
nttManagerAddressFor operator admin managerId =
  derivedAddress (DomainTag nttManagerAddressTag) operator admin (RegistryId managerId)

-- | Domain-separation tag for NTT recipient-address bindings. Distinct from
-- every other domain tag in this codebase so a recipient binding can never
-- collide with an emitter, manager, or governance address.
recipientAddressTag : Text
recipientAddressTag = "wormhole:ntt-recipient:v1"

-- | @keccak256(tag ‖ lp(utf8(recipientText)))@, where @lp@ is the 4-byte
-- big-endian length prefix ('lenPrefixed'). Text form split out from
-- 'recipientAddressFor' so tests can pin the encoding against a fixed string —
-- a live Party's fingerprint is nondeterministic, so it cannot be baked into a
-- static, pre-signed VAA fixture. Mirrors 'derivedAddressFromText'.
recipientAddressFromText : Text -> Bytes32
recipientAddressFromText recipientText =
  normalizeHex (keccak256 (toHex recipientAddressTag
    <> unLenPrefixed (lenPrefixed (toHex recipientText))))

-- | The 32-byte binding a sender must compute off-chain and put in an outbound
-- NTT transfer's @recipientAddress@ field to address @recipient@ on Canton.
-- 'Receive' recomputes this from the caller-supplied @recipient@ and checks it
-- against the VAA's own @recipientAddress@ -- see 'Receive' for the tradeoff
-- this makes against a registry indirection.
recipientAddressFor : Party -> Bytes32
recipientAddressFor recipient = recipientAddressFromText (partyToText recipient)

-- | Allocates monotonically increasing manager ids, one registry per operator.
-- Same non-uniqueness caveat as 'Wormhole.Core.State.EmitterRegistry': the
-- counter discipline is behavioral, but address integrity is cryptographic
-- (admin co-signature + admin in the address preimage). No contract key — a
-- deployer resolves the registry by a disclosed cid.
template NttManagerRegistry
  with
    operator : Party
    nextId   : Int
  where
    signatory operator

    -- | Stand up a deployment directly (crankless), mirroring core
    -- 'RegisterEmitter'. Any @admin@ holding a disclosure to this registry can
    -- register: the @operator@'s authority to co-sign the 'NttManager' is
    -- inherited from the registry signatory, so the guardian operator runs no
    -- crank. @admin@ first registers a core 'Emitter' (the transceiver) via the
    -- core flow and passes its cid here; it is fetched and bound at registration
    -- (owner = admin, operator = this operator), so the stored
    -- @transceiverEmitterId@ names exactly that emitter.
    --
    -- @guardianGovernance@ is the guardian trust anchor 'Receive' will pin. A
    -- malicious @admin@ setting a bogus anchor only breaks its OWN deployment
    -- (no authentic 'CoreState' carries that anchor, so its 'Receive's always
    -- fail); it cannot redirect inbound transfers to a forged guardian set,
    -- which would need a 'CoreState' co-signed by the real operator.
    choice RegisterManager : (ContractId NttManagerRegistry, ContractId NttManager)
      with
        admin                 : Party
        guardianGovernance    : Party
        transceiverEmitterCid : ContractId Emitter
        tokenCid              : ContractId NttToken
        mode                  : TokenMode
        tokenDecimals         : Int
      controller admin
      do
        transceiver <- fetch transceiverEmitterCid
        assertMsg "ntt: transceiver emitter is not owned by the admin"
          (transceiver.owner == admin)
        assertMsg "ntt: transceiver emitter is not from this operator"
          (transceiver.operator == operator)
        reg' <- create this with nextId = nextId + 1
        mgr <- create NttManager with
          operator
          admin
          guardianGovernance
          managerId = nextId
          managerAddress = nttManagerAddressFor operator admin nextId
          transceiverEmitterId = transceiver.emitterId
          tokenCid
          mode
          tokenDecimals
          peers = Map.empty
          outboundSequence = 0
        pure (reg', mgr)

template NttManager
  with
    operator             : Party
    admin                : Party
    guardianGovernance   : Party           -- guardian trust anchor 'Receive' pins on the CoreState
    managerId            : Int             -- registry-allocated; part of the address preimage
    managerAddress       : Bytes32         -- nttManagerAddressFor operator admin managerId
    transceiverEmitterId : Int             -- the deployment's transceiver Emitter (owner = admin)
    tokenCid             : ContractId NttToken
    mode                 : TokenMode
    tokenDecimals        : Int
    peers                : Map Int Peer     -- recipient / source chainId -> peer
    outboundSequence     : Int              -- next NttManagerMessage id
    -- (Inbound replay protection is the core per-consumer replay trie scoped to
    -- @admin@, not manager state — see 'Receive'.)
  where
    -- Admin co-signs (mirroring 'Emitter'): the manager address includes the
    -- admin, so a compromised operator cannot mint a manager carrying an
    -- existing deployment's address. Operator co-signs (its authority inherited
    -- from the registry at 'RegisterManager'). No contract key.
    signatory operator, admin

    -- | Register/replace a peer deployment. Controlled by @admin@; the operator
    -- authority to recreate this contract comes from it being the signatory.
    choice SetPeer : ContractId NttManager
      with
        chainId : Int
        peer    : Peer
      controller admin
      do create this with peers = Map.insert chainId (normalizePeer peer) peers

    -- | Outbound transfer. Trims the amount, locks/burns the token FROM @user@
    -- (the actual caller) via the seam, assembles the NTT message, publishes it
    -- via the deployment's transceiver 'Emitter', and advances the sequence.
    --
    -- Authorization: @user@ is the SOLE controller — no admin/operator sign-off.
    -- Exercising @Transfer@ consumes 'NttManager', whose signatories are
    -- @operator, admin@, and consuming a contract makes ITS signatories'
    -- authority available to everything nested in the choice body. So the nested
    -- @LockOrBurn@ (controller = the token's @manager@, i.e. @operator@) and
    -- @PublishMessage@ (controller = the transceiver 'Emitter's @owner@, i.e.
    -- @admin@) are both authorized by inherited signatory authority. The CIP-56
    -- factory underneath separately asserts the input holding's owner matches
    -- @user@, so a caller can never lock/burn a holding it doesn't control,
    -- regardless of what this choice's authority allows.
    --
    -- FEES: @user@ pays the message fee itself. 'PublishMessage' charges
    -- @messageFee@ to its @payer@; passing @payer = user@ works because @user@,
    -- as the payer, co-controls 'PublishMessage', so its authority reaches the
    -- fee's 'Allocation_ExecuteTransfer' (which draws the payer's own funds).
    -- The @user@ attaches a fee allocation for @messageFee@ from its own wallet
    -- (empty at fee 0); this is the same governance-set fee every core publish
    -- pays (README §4.2), so an NTT send is never fee-exempt.
    --
    -- VISIBILITY, not authorization, is the one real requirement: @user@ is not
    -- a stakeholder of 'NttManager', the transceiver 'Emitter', the token
    -- contract, or the 'CoreState', so a submission attaches those as explicit
    -- disclosures (a data attachment, not a signature) served by the
    -- deployment's disclosure service:
    -- <https://docs.digitalasset.com/build/3.4/sdlc-howtos/applications/develop/explicit-contract-disclosure.html>.
    -- In Daml Script, @'submitWithDisclosures'@ is the idiom.
    choice Transfer : ContractId NttManager
      with
        user                  : Party                 -- the token owner initiating this transfer; pays the fee
        transceiverEmitterCid : ContractId Emitter     -- this deployment's transceiver (disclosed)
        coreStateCid          : ContractId CoreState   -- for the message-fee read (disclosed)
        recipientChain        : Int
        recipientAddress      : Bytes32
        sourceToken           : Bytes32
        rawAmount             : Int
        nonce                 : Int
        consistencyLevel      : Int
        inputHoldingCids      : [ContractId Holding]   -- CIP-56 holdings to lock/burn
        feeAllocation         : Optional (ContractId Allocation, ExtraArgs)  -- messageFee; None at fee 0
        extraArgs             : ExtraArgs              -- CIP-56 registry choice context
      controller user
      do
        let peer = fromSomeNote ("ntt: no peer for chain " <> show recipientChain)
                     (Map.lookup recipientChain peers)
            trimmed = trimAmount rawAmount tokenDecimals
        -- The transceiver is caller-supplied (disclosed), so bind it to this
        -- deployment before publishing. A wrong emitter can only fail here.
        transceiver <- fetch transceiverEmitterCid
        assertMsg "ntt: transceiver emitter is not this deployment's"
          (transceiver.owner == admin
            && transceiver.operator == operator
            && transceiver.emitterId == transceiverEmitterId)
        -- Lock (custody) or burn the user's tokens via the token seam.
        exercise tokenCid LockOrBurn with
          sender = user, amount = trimmed, inputHoldingCids, extraArgs
        let ntt = NativeTokenTransfer with
              decimals = trimmed.decimals
              amount = trimmed.amount
              sourceToken = normalizeHex sourceToken
              recipientAddress = normalizeHex recipientAddress
              recipientChain
              additionalPayload = ""
            mm = NttManagerMessage with
              id = leftPadTo 32 (intToBytesN outboundSequence 8)
              sender = managerAddress
              payload = encodeNativeTokenTransfer ntt
            wm = WormholeTransceiverMessage with
              sourceManager = managerAddress
              recipientManager = peer.managerAddress
              managerPayload = encodeNttManagerMessage mm
              transceiverPayload = ""
        _ <- exercise transceiverEmitterCid PublishMessage with
               payload = encodeWormholeTransceiverMessage wm
               nonce
               consistencyLevel
               coreStateCid
               payer = user
               feeAllocation
        create this with outboundSequence = outboundSequence + 1

    -- | Inbound transfer, PERMISSIONLESS. Any @executor@ relays the VAA on the
    -- recipient's behalf. Verifies + claims the VAA atomically via the core
    -- 'VerifyAndConsumeVAA' (the per-consumer replay trie, scoped to @admin@ —
    -- so each deployment claims a VAA at most once and distinct VAAs never
    -- contend), then enforces the peer, decodes, binds @recipient@ to the VAA's
    -- own @recipientAddress@, and mints/unlocks.
    --
    -- AUTHORIZATION: @executor@ is the controller, but its identity carries no
    -- authority. This choice is @nonconsuming@, so its body inherits the
    -- signatory authority of 'NttManager' (@operator, admin@) — which is exactly
    -- what the nested actions need: @VerifyAndConsumeVAA@ / the replay
    -- @ConsumeDigest@ (controller/consumer = @admin@) and @MintOrUnlock@
    -- (controller = the token's @manager@, i.e. @operator@). So anyone can
    -- submit; the executor only supplies the disclosures (the 'CoreState', the
    -- covering 'ReplayNode', the token contract). (A concrete token whose
    -- holdings name the owner as a signatory additionally needs the recipient's
    -- authority or a CIP-56 transfer pre-approval to receive without submitting
    -- itself — an off-ledger orchestration concern, README §11.)
    --
    -- GUARDIAN TRUST ROOT: there is no caller-supplied core-state to substitute
    -- freely — the disclosed @coreStateCid@ is authenticated by pinning its
    -- @guardianGovernance@ to the anchor @admin@ committed at deployment (via
    -- 'GetGuardianGovernance'). A 'CoreState' requires only some (operator, gg)
    -- signature pair, so pinning the OPERATOR would not stop a compromised
    -- operator forging one under a throwaway gg; pinning @guardianGovernance@
    -- (the guardians' k-of-n external threshold, unforgeable by a hot operator
    -- key) does. This mirrors EVM NTT verifying against an immutable core
    -- address and reuses the single audited verification path.
    --
    -- @recipient@ is a choice argument, but the executor cannot supply an
    -- arbitrary one: 'recipientAddressFor recipient' must equal the VAA's own
    -- @recipientAddress@, a value fixed by the sender and covered by the
    -- guardian signature. A sender addresses Canton by computing this same
    -- keccak256 off-chain over the recipient's exact Party-id string.
    --
    -- Tradeoff (chosen over a registry indirection): this permanently binds a
    -- signed VAA to the recipient Party string as it existed when the sender
    -- computed the hash. A Canton Party id is fixed forever once allocated; if
    -- the recipient ever needs a DIFFERENT party (lost key, custodial
    -- migration), a VAA already signed against the old party's hash cannot be
    -- redirected — the sender must re-send. A self-service handle registry
    -- avoids that at the cost of an extra template pair and a lookup; this is
    -- the simpler mechanism, accepting that cost.
    --
    -- @pubKeys@ are untrusted hints bound to guardian addresses inside
    -- 'verifyVAA' (hint-free verification is a tracked follow-up, README §11).
    nonconsuming choice Receive : NativeTokenTransfer
      with
        executor         : Party                 -- any relayer; carries no authority, only disclosures
        coreStateCid     : ContractId CoreState   -- disclosed; pinned via guardianGovernance
        replayNodeCid    : ContractId ReplayNode   -- covering trie node for vaa.hash (disclosed)
        vaaBytes         : Bytes
        pubKeys          : [(Int, Bytes)]
        recipient        : Party
        inputHoldingCids : [ContractId Holding]   -- custody holdings to unlock ([] for mint)
        extraArgs        : ExtraArgs             -- CIP-56 registry choice context
      controller executor
      do
        -- Authenticate the guardian trust root before verifying against it.
        csGg <- exercise coreStateCid GetGuardianGovernance with reader = executor
        assertMsg "ntt: core state is not the committed guardian trust anchor"
          (csGg == guardianGovernance)
        (vaa, _node) <- exercise coreStateCid VerifyAndConsumeVAA with
          encodedVAA = vaaBytes
          pubKeys
          consumer = admin
          replayNodeCid
        let peer = fromSomeNote ("ntt: no peer for source chain " <> show vaa.emitterChain)
                     (Map.lookup vaa.emitterChain peers)
        assertMsg "ntt: VAA emitter is not the configured peer transceiver"
          (normalizeHex vaa.emitterAddress == peer.transceiverAddress)
        let wm = decodeWormholeTransceiverMessage vaa.payload
        assertMsg "ntt: wrong recipient manager" (wm.recipientManager == managerAddress)
        assertMsg "ntt: source manager is not the peer manager"
          (wm.sourceManager == peer.managerAddress)
        let mm = decodeNttManagerMessage wm.managerPayload
            ntt = decodeNativeTokenTransfer mm.payload
        assertMsg "ntt: recipient does not match VAA recipientAddress"
          (recipientAddressFor recipient == normalizeHex ntt.recipientAddress)
        exercise tokenCid MintOrUnlock with
          recipient
          amount = TrimmedAmount with decimals = ntt.decimals, amount = ntt.amount
          inputHoldingCids
          extraArgs
        pure ntt
