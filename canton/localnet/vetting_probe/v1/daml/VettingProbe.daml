-- | Rehearsal templates for LocalNet. 'VettingProbe' makes guardianGovernance an informee;
-- 'GovernanceCeremonyProbe' needs the guardianGovernance signing-key threshold.
module VettingProbe where

template VettingProbe
  with
    operator           : Party
    guardianGovernance : Party
    label              : Text
  where
    signatory operator
    observer guardianGovernance

template GovernanceCeremonyProbe
  with
    guardianGovernance : Party
    label              : Text
  where
    signatory guardianGovernance
