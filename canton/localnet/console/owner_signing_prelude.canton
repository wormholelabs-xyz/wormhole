// Shared definitions of the guardian-namespace console scripts. canton_console.sh puts this file before the script.
// Every owner signature comes from an external signer command.
import com.digitalasset.canton.topology._
import com.digitalasset.canton.topology.transaction._
import com.digitalasset.canton.topology.transaction.SignedTopologyTransaction.GenericSignedTopologyTransaction
import com.digitalasset.canton.config.RequireTypes.PositiveInt
import com.digitalasset.canton.crypto._
import com.digitalasset.canton.topology.admin.grpc.TopologyStoreId
import com.digitalasset.canton.admin.api.client.commands.TopologyAdminCommands.Write.GenerateTransactions.Proposal
import com.google.protobuf.ByteString
import com.digitalasset.nonempty.NonEmpty
import scala.sys.process._
import scala.collection.immutable.Set
import java.nio.file.{Files, Paths}

def requiredEnvironmentVariable(name: String): String =
  sys.env.getOrElse(name, throw new RuntimeException(s"missing required environment variable: $name"))
def bytesToHex(bytes: Array[Byte]): String = bytes.map("%02x".format(_)).mkString
def hexToBytes(hexText: String): Array[Byte] = hexText.grouped(2).map(Integer.parseInt(_, 16).toByte).toArray

// BEGIN owner signer block (same text in each file of canton/localnet/test/owner_signer_block_test.sh)
val ed25519SignatureLengthBytes = 64
val ed25519SignatureHexPattern = s"^[0-9a-f]{${ed25519SignatureLengthBytes * 2}}$$".r
def parseEd25519SignatureHex(signatureHex: String, signerDescription: String): ByteString = {
  require(ed25519SignatureHexPattern.matches(signatureHex),
    s"signer of $signerDescription printed ${signatureHex.length} hex characters, expected ${ed25519SignatureLengthBytes * 2} lowercase hex")
  val signatureBytes = ByteString.copyFrom(hexToBytes(signatureHex))
  require(signatureBytes.size == ed25519SignatureLengthBytes, s"signature of $signerDescription has ${signatureBytes.size} bytes")
  signatureBytes
}
// The signer argv is a JSON array: the program, then its arguments. The hash hex is appended as the last argument.
def parseSignerArgv(variableName: String): Seq[String] = {
  val signerArgv = io.circe.parser.decode[Vector[String]](requiredEnvironmentVariable(variableName)).fold(
    decodeError => throw new RuntimeException(s"$variableName must be a JSON array of strings: ${decodeError.getMessage}"),
    identity)
  require(signerArgv.nonEmpty, s"$variableName is an empty array")
  require(signerArgv.forall(_.nonEmpty), s"$variableName holds an empty argument")
  signerArgv
}
val ownerSignerMaxSeconds = 30
val ownerSignerMaxOutputCharacters = 1024
// runOwnerSigner: stdout is the signature; stderr goes to the console stderr. A signer that runs longer than
// maxSeconds is stopped and the call fails. The signer runs without other JVM threads: a script lambda on another
// thread blocks on the class initialization of the running script.
def runOwnerSigner(signerArgv: Seq[String], hashHex: String, signerDescription: String,
    maxSeconds: Int = ownerSignerMaxSeconds): ByteString = {
  require(maxSeconds > 0 && maxSeconds <= ownerSignerMaxSeconds, s"signer time limit $maxSeconds s is outside 1..$ownerSignerMaxSeconds")
  val signerOutputFile = Files.createTempFile("owner-signer-", ".out")
  try {
    val signerProcess =
      try new java.lang.ProcessBuilder(java.util.Arrays.asList((signerArgv :+ hashHex): _*))
        .redirectInput(java.lang.ProcessBuilder.Redirect.from(new java.io.File("/dev/null")))
        .redirectOutput(signerOutputFile.toFile)
        .redirectError(java.lang.ProcessBuilder.Redirect.INHERIT)
        .start()
      catch {
        case startError: java.io.IOException =>
          throw new RuntimeException(s"signer of $signerDescription could not start: ${startError.getMessage}")
      }
    if (!signerProcess.waitFor(maxSeconds.toLong, java.util.concurrent.TimeUnit.SECONDS)) {
      signerProcess.destroyForcibly()
      signerProcess.waitFor(5L, java.util.concurrent.TimeUnit.SECONDS)
      throw new RuntimeException(s"signer of $signerDescription did not finish in $maxSeconds s and was stopped")
    }
    require(signerProcess.exitValue == 0, s"signer of $signerDescription exited with ${signerProcess.exitValue}")
    require(Files.size(signerOutputFile) <= ownerSignerMaxOutputCharacters,
      s"signer of $signerDescription printed more than $ownerSignerMaxOutputCharacters characters")
    parseEd25519SignatureHex(new String(Files.readAllBytes(signerOutputFile), "US-ASCII").trim, signerDescription)
  } finally Files.deleteIfExists(signerOutputFile)
}
// END owner signer block

case class OwnerKey(publicKey: SigningPublicKey, signerArgv: Seq[String]) {
  val namespace: Namespace = Namespace(publicKey.fingerprint)
}
def loadOwnerPublicKey(publicKeyVariable: String): SigningPublicKey = {
  val publicKeyDer = ByteString.copyFrom(Files.readAllBytes(Paths.get(requiredEnvironmentVariable(publicKeyVariable))))
  SigningPublicKey
    .create(CryptoKeyFormat.DerX509Spki, publicKeyDer, SigningKeySpec.EcCurve25519, SigningKeyUsage.All)
    .getOrElse(sys.error(s"invalid owner public key in $publicKeyVariable"))
}
def loadOwnerKey(publicKeyVariable: String, signerArgvVariable: String): OwnerKey =
  OwnerKey(loadOwnerPublicKey(publicKeyVariable), parseSignerArgv(signerArgvVariable))
def signWithOwnerKey(owner: OwnerKey, hash: Hash): Signature = {
  val hashHex = bytesToHex(hash.getCryptographicEvidence.toByteArray)
  Signature.fromExternalSigning(
    SignatureFormat.fromSigningAlgoSpec(SigningAlgorithmSpec.Ed25519),
    runOwnerSigner(owner.signerArgv, hashHex, owner.publicKey.fingerprint.toProtoPrimitive),
    owner.publicKey.fingerprint,
    SigningAlgorithmSpec.Ed25519,
  )
}

def sortedFingerprintText(fingerprints: Iterable[Fingerprint]): String = fingerprints.map(_.toProtoPrimitive).toSeq.sorted.mkString(",")
def partyName(party: PartyId): String = party.uid.identifier.unwrap

val topologyEffectiveMaxAttempts = 120
val topologyEffectivePollMillis = 500
def awaitTopology(description: String, maxAttempts: Int = topologyEffectiveMaxAttempts)(isEffective: => Boolean): Unit = {
  require(maxAttempts > 0 && maxAttempts <= topologyEffectiveMaxAttempts,
    s"topology wait of $maxAttempts attempts is outside 1..$topologyEffectiveMaxAttempts")
  var attempt = 0
  while (!isEffective) {
    attempt += 1
    if (attempt >= maxAttempts) throw new RuntimeException(s"topology not effective: $description")
    Thread.sleep(topologyEffectivePollMillis)
  }
}

// LocalNet guardian policy of each party in the guardian namespace and of the namespace (MainNet values: open item).
val expectedGuardianHostCount = 3
val expectedConfirmationThreshold = 2
val expectedSigningKeyThreshold = 2
val expectedSigningKeyCount = 3
val expectedNamespaceThreshold = 2
val expectedNamespaceOwnerCount = 3
def checkHostingIsGuardianPolicy(mapping: PartyToParticipant): Unit = {
  val name = partyName(mapping.partyId)
  require(mapping.participants.size == expectedGuardianHostCount,
    s"$name has ${mapping.participants.size} hosts, expected $expectedGuardianHostCount")
  require(mapping.participants.map(_.participantId).distinct.size == mapping.participants.size, s"$name names a host twice")
  mapping.participants.foreach { host =>
    require(host.permission == ParticipantPermission.Confirmation,
      s"$name host ${host.participantId} has ${host.permission}, expected Confirmation")
    require(!host.onboarding, s"$name host ${host.participantId} is onboarding")
  }
  require(mapping.threshold.value == expectedConfirmationThreshold,
    s"$name confirmation threshold ${mapping.threshold.value}, expected $expectedConfirmationThreshold")
  val signingKeys = mapping.partySigningKeysWithThreshold.getOrElse(throw new IllegalArgumentException(s"$name has no party signing keys"))
  require(signingKeys.threshold.value == expectedSigningKeyThreshold,
    s"$name signing key threshold ${signingKeys.threshold.value}, expected $expectedSigningKeyThreshold")
  require(signingKeys.keys.size == expectedSigningKeyCount, s"$name has ${signingKeys.keys.size} signing keys, expected $expectedSigningKeyCount")
}
def checkNamespaceIsGuardianPolicy(namespaceDefinition: DecentralizedNamespaceDefinition): Unit = {
  require(namespaceDefinition.threshold.value == expectedNamespaceThreshold,
    s"namespace threshold ${namespaceDefinition.threshold.value}, expected $expectedNamespaceThreshold")
  require(namespaceDefinition.owners.size == expectedNamespaceOwnerCount,
    s"namespace has ${namespaceDefinition.owners.size} owners, expected $expectedNamespaceOwnerCount")
}

// A mapping as a participant shows it, with its serial.
final case class EffectiveTopologyMapping[M <: TopologyMapping](mapping: M, serial: PositiveInt)
// The Replace that the console computed, and the serial it must take.
final case class IntendedTopologyChange(mapping: TopologyMapping, serial: PositiveInt)

// checkTransactionIsIntendedChange: the transaction is exactly the intended Replace. Each field is compared alone for
// a precise error, then the complete mapping.
def checkTransactionIsIntendedChange(transaction: TopologyTransaction[TopologyChangeOp, TopologyMapping],
    intended: IntendedTopologyChange, description: String): Unit = {
  require(transaction.operation == TopologyChangeOp.Replace, s"$description is ${transaction.operation}, expected Replace")
  require(transaction.serial == intended.serial, s"$description has serial ${transaction.serial.value}, expected ${intended.serial.value}")
  (transaction.mapping, intended.mapping) match {
    case (actual: PartyToParticipant, expected: PartyToParticipant) =>
      require(actual.partyId == expected.partyId,
        s"$description names party ${actual.partyId.toProtoPrimitive}, expected ${expected.partyId.toProtoPrimitive}")
      require(actual.participants == expected.participants, s"$description has hosts ${actual.participants}, expected ${expected.participants}")
      require(actual.threshold == expected.threshold,
        s"$description has confirmation threshold ${actual.threshold.value}, expected ${expected.threshold.value}")
      require(actual.partySigningKeysWithThreshold.map(_.threshold) == expected.partySigningKeysWithThreshold.map(_.threshold),
        s"$description has signing key threshold ${actual.partySigningKeysWithThreshold.map(_.threshold.value).getOrElse("none")}, " +
          s"expected ${expected.partySigningKeysWithThreshold.map(_.threshold.value).getOrElse("none")}")
      require(actual.partySigningKeysWithThreshold.map(_.keys.forgetNE) == expected.partySigningKeysWithThreshold.map(_.keys.forgetNE),
        s"$description has signing keys ${actual.partySigningKeysWithThreshold.map(keys => sortedFingerprintText(keys.keys.map(_.fingerprint)))}, " +
          s"expected ${expected.partySigningKeysWithThreshold.map(keys => sortedFingerprintText(keys.keys.map(_.fingerprint)))}")
    case (actual: DecentralizedNamespaceDefinition, expected: DecentralizedNamespaceDefinition) =>
      require(actual.namespace == expected.namespace, s"$description names namespace ${actual.namespace}, expected ${expected.namespace}")
      require(actual.threshold == expected.threshold,
        s"$description has namespace threshold ${actual.threshold.value}, expected ${expected.threshold.value}")
      require(actual.owners.forgetNE == expected.owners.forgetNE,
        s"$description has owners ${sortedFingerprintText(actual.owners.map(_.fingerprint))}, " +
          s"expected ${sortedFingerprintText(expected.owners.map(_.fingerprint))}")
    case (actual: NamespaceDelegation, expected: NamespaceDelegation) =>
      require(actual.namespace == expected.namespace, s"$description names namespace ${actual.namespace}, expected ${expected.namespace}")
      require(actual.target == expected.target,
        s"$description has target ${actual.target.fingerprint.toProtoPrimitive}, expected ${expected.target.fingerprint.toProtoPrimitive}")
      require(actual.restriction == expected.restriction, s"$description has restriction ${actual.restriction}, expected ${expected.restriction}")
    case (actual, expected) =>
      throw new IllegalArgumentException(s"$description has mapping ${actual.code}, expected ${expected.code}")
  }
  require(transaction.mapping == intended.mapping, s"$description differs from the intended mapping")
}

// checkGeneratedTransactionIsIntended: a transaction that a participant generated is the intended Replace, and its
// hash is the hash of the transaction that the console builds from the intended values. Returns the console-built
// transaction. Each owner signs its hash.
def checkGeneratedTransactionIsIntended(generated: TopologyTransaction[TopologyChangeOp, TopologyMapping], intended: IntendedTopologyChange,
    protocolVersion: com.digitalasset.canton.version.ProtocolVersion, description: String): TopologyTransaction[TopologyChangeOp, TopologyMapping] = {
  checkTransactionIsIntendedChange(generated, intended, description)
  val intendedTransaction: TopologyTransaction[TopologyChangeOp, TopologyMapping] =
    TopologyTransaction.create(TopologyChangeOp.Replace, intended.serial, intended.mapping, protocolVersion)
      .fold(error => throw new IllegalArgumentException(s"$description: cannot build the intended transaction: $error"), identity)
  checkTransactionIsIntendedChange(intendedTransaction, intended, s"console-built $description")
  require(generated.hash == intendedTransaction.hash,
    s"$description hash ${generated.hash.hash.toHexString} differs from the intended hash ${intendedTransaction.hash.hash.toHexString}")
  intendedTransaction
}
