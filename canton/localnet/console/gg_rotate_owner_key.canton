// Rotate one guardianGovernance owner key: remove GG_REMOVED_OWNER, add GG_ADDED_OWNER, keep the threshold.
// One run changes the decentralized namespace (DN) and the PartyToParticipant signing keys of each party in it.
// Every owner signature comes from an external signer command; the console never holds owner keys.
// Environment:
//   GG_PARTY_ID                      guardianGovernance party id.
//   GG_ROTATION_PARTY_IDS            Optional. Comma-separated ids of every party under the DN whose signing keys
//                                    are the owner keys, in rotation order. Default: GG_PARTY_ID.
//                                    The run stops before any change if the DN has another such party.
//   GG_KEPT_OWNER_PUBKEY_1/2         DER SPKI Ed25519 public keys of the two owners that stay.
//   GG_KEPT_OWNER_SIGN_ARGV_1/2      Signer commands of those owners, each a JSON array of strings. The hash hex
//                                    is appended as the last argument; stdout is a hex signature.
//   GG_REMOVED_OWNER_PUBKEY          Public key of the owner to remove.
//   GG_REMOVED_OWNER_SIGN_ARGV       Signer command of that owner (used only for the negative check).
//   GG_ADDED_OWNER_PUBKEY            Public key of the new owner.
//   GG_ADDED_OWNER_SIGN_ARGV         Signer command of the new owner.
//   GG_ROTATION_FAIL_BEFORE_SIGNING_KEYS  Optional. "true" fails the rotation after the namespace change
//                                    (rehearsal of a half-applied rotation and --resume).
//   GG_ROTATION_FAIL_BEFORE_SIGNING_KEYS_OF  Optional party name. Fails the rotation before the signing keys of that
//                                    party, after the parties before it in GG_ROTATION_PARTY_IDS.
// A rerun after a partial failure skips the steps that are already effective.
import com.digitalasset.canton.topology._
import com.digitalasset.canton.topology.transaction._
import com.digitalasset.canton.config.RequireTypes.PositiveInt
import com.digitalasset.canton.crypto._
import com.digitalasset.canton.topology.admin.grpc.TopologyStoreId
import com.digitalasset.canton.admin.api.client.commands.TopologyAdminCommands.Write.GenerateTransactions.Proposal
import com.google.protobuf.ByteString
import com.digitalasset.nonempty.NonEmpty
import scala.sys.process._
import scala.collection.immutable.Set
import java.nio.file.{Files, Paths}

def requiredEnvironmentVariable(name: String): String =
  sys.env.getOrElse(name, throw new RuntimeException(s"missing required environment variable: $name"))
def bytesToHex(b: Array[Byte]): String = b.map("%02x".format(_)).mkString
def hexToBytes(s: String): Array[Byte] = s.grouped(2).map(Integer.parseInt(_, 16).toByte).toArray

// BEGIN owner signer block (same text in devnet/guardian_governance.canton and localnet/console/gg_rotate_owner_key.canton)
val ed25519SignatureLengthBytes = 64
val ed25519SignatureHexPattern = s"^[0-9a-f]{${ed25519SignatureLengthBytes * 2}}$$".r
def parseEd25519SignatureHex(signatureHex: String, signerDescription: String): ByteString = {
  require(ed25519SignatureHexPattern.matches(signatureHex),
    s"signer of $signerDescription printed ${signatureHex.length} hex characters, expected ${ed25519SignatureLengthBytes * 2} lowercase hex")
  val signatureBytes = ByteString.copyFrom(hexToBytes(signatureHex))
  require(signatureBytes.size == ed25519SignatureLengthBytes, s"signature of $signerDescription has ${signatureBytes.size} bytes")
  signatureBytes
}
// The signer argv is a JSON array: the program, then its arguments. The hash hex is appended as the last argument.
def parseSignerArgv(variableName: String): Seq[String] = {
  val signerArgv = io.circe.parser.decode[Vector[String]](requiredEnvironmentVariable(variableName)).fold(
    decodeError => throw new RuntimeException(s"$variableName must be a JSON array of strings: ${decodeError.getMessage}"),
    identity)
  require(signerArgv.nonEmpty, s"$variableName is an empty array")
  require(signerArgv.forall(_.nonEmpty), s"$variableName holds an empty argument")
  signerArgv
}
def runOwnerSigner(signerArgv: Seq[String], hashHex: String, signerDescription: String): ByteString =
  parseEd25519SignatureHex((signerArgv :+ hashHex).!!.trim, signerDescription)
// END owner signer block

case class OwnerKey(publicKey: SigningPublicKey, signerArgv: Seq[String]) {
  val namespace: Namespace = Namespace(publicKey.fingerprint)
}
def loadOwner(publicKeyVariable: String, signerArgvVariable: String): OwnerKey = {
  val publicKeyDer = ByteString.copyFrom(Files.readAllBytes(Paths.get(requiredEnvironmentVariable(publicKeyVariable))))
  val publicKey = SigningPublicKey
    .create(CryptoKeyFormat.DerX509Spki, publicKeyDer, SigningKeySpec.EcCurve25519, SigningKeyUsage.All)
    .getOrElse(sys.error(s"invalid owner public key in $publicKeyVariable"))
  OwnerKey(publicKey, parseSignerArgv(signerArgvVariable))
}

val partyId = PartyId.tryFromProtoPrimitive(requiredEnvironmentVariable("GG_PARTY_ID"))
val rotationPartyIds: Seq[PartyId] = sys.env.get("GG_ROTATION_PARTY_IDS").filter(_.nonEmpty)
  .map(_.split(",").toSeq.map(_.trim).map(PartyId.tryFromProtoPrimitive)).getOrElse(Seq(partyId))
require(rotationPartyIds.contains(partyId), "GG_ROTATION_PARTY_IDS must contain GG_PARTY_ID")
require(rotationPartyIds.distinct.size == rotationPartyIds.size, "duplicate party in GG_ROTATION_PARTY_IDS")
rotationPartyIds.foreach(p => require(p.namespace == partyId.namespace, s"$p is outside the guardianGovernance namespace"))
val failBeforeSigningKeysOf: Option[String] = sys.env.get("GG_ROTATION_FAIL_BEFORE_SIGNING_KEYS_OF").filter(_.nonEmpty)
failBeforeSigningKeysOf.foreach(name => require(rotationPartyIds.exists(_.uid.identifier.unwrap == name), s"no rotation party named $name"))
val keptOwners = Seq(loadOwner("GG_KEPT_OWNER_PUBKEY_1", "GG_KEPT_OWNER_SIGN_ARGV_1"), loadOwner("GG_KEPT_OWNER_PUBKEY_2", "GG_KEPT_OWNER_SIGN_ARGV_2"))
val removedOwner = loadOwner("GG_REMOVED_OWNER_PUBKEY", "GG_REMOVED_OWNER_SIGN_ARGV")
val addedOwner = loadOwner("GG_ADDED_OWNER_PUBKEY", "GG_ADDED_OWNER_SIGN_ARGV")
require(keptOwners.map(_.namespace).distinct.size == 2, "kept owners must differ")
require(!keptOwners.map(_.namespace).contains(removedOwner.namespace), "removed owner is also a kept owner")
require(!(keptOwners :+ removedOwner).map(_.namespace).contains(addedOwner.namespace), "added owner is already an owner")

val participant = participants.remote.find(_.name == "app-provider").getOrElse(throw new RuntimeException("app-provider not bound"))
val synchronizerId = participant.synchronizers.list_connected().find(_.synchronizerAlias.unwrap == "global")
  .getOrElse(throw new RuntimeException("app-provider is not connected to global")).physicalSynchronizerId
val store = TopologyStoreId.Synchronizer(synchronizerId)
val protocolVersion = com.digitalasset.canton.version.ProtocolVersion.latest

def externalSign(owner: OwnerKey, hash: Hash): Signature = {
  val hashHex = bytesToHex(hash.getCryptographicEvidence.toByteArray)
  Signature.fromExternalSigning(
    SignatureFormat.fromSigningAlgoSpec(SigningAlgorithmSpec.Ed25519),
    runOwnerSigner(owner.signerArgv, hashHex, owner.namespace.fingerprint.toProtoPrimitive),
    owner.namespace.fingerprint,
    SigningAlgorithmSpec.Ed25519,
  )
}
def generateUnsigned[M <: TopologyMapping](mapping: M): TopologyTransaction[TopologyChangeOp, M] =
  participant.topology.transactions.generate(Seq(Proposal(mapping, store))).head
    .asInstanceOf[TopologyTransaction[TopologyChangeOp, M]]
def signedBy[M <: TopologyMapping](unsigned: TopologyTransaction[TopologyChangeOp, M], signers: Seq[OwnerKey]): SignedTopologyTransaction[TopologyChangeOp, M] = {
  val signatures = signers.map(externalSign(_, unsigned.hash.hash))
  signatures.tail.foldLeft(SignedTopologyTransaction.withSignature(unsigned, signatures.head, isProposal = false, protocolVersion))(_.addSingleSignature(_))
}
val topologyEffectiveMaxAttempts = 120
def awaitTopology(description: String)(isEffective: => Boolean): Unit = {
  var attempt = 0
  while (!isEffective) {
    attempt += 1
    if (attempt >= topologyEffectiveMaxAttempts) throw new RuntimeException(s"topology not effective: $description")
    Thread.sleep(500)
  }
}
def currentDn() = participant.topology.decentralized_namespaces.list(store).find(_.item.namespace == partyId.namespace)
  .getOrElse(throw new RuntimeException("decentralized namespace not found"))
def currentPtp(party: PartyId) = participant.topology.party_to_participant_mappings.list(store).find(_.item.partyId == party)
  .getOrElse(throw new RuntimeException(s"party to participant mapping of $party not found"))
def partyName(party: PartyId): String = party.uid.identifier.unwrap

val ownersBeforeRotation: Set[Namespace] = (keptOwners :+ removedOwner).map(_.namespace).toSet
val newOwnerSet: Set[Namespace] = (keptOwners :+ addedOwner).map(_.namespace).toSet
val newSigningFingerprints = (keptOwners :+ addedOwner).map(_.publicKey.fingerprint).toSet
val oldSigningFingerprints = (keptOwners :+ removedOwner).map(_.publicKey.fingerprint).toSet
def ptpHasNewSigningKeys(party: PartyId): Boolean =
  currentPtp(party).item.partySigningKeysWithThreshold.exists(_.keys.map(_.fingerprint).toSet == newSigningFingerprints)
def rotationState(): String = rotationPartyIds.map(p => s"${partyName(p)}=${if (ptpHasNewSigningKeys(p)) "rotated" else "not-rotated"}").mkString(" ")

// Precondition: the run covers every party under the DN that the old or the new owner keys sign for.
val ownerKeyPartiesInNamespace = participant.topology.party_to_participant_mappings.list(store)
  .filter(_.item.partyId.namespace == partyId.namespace)
  .filter(_.item.partySigningKeysWithThreshold.exists { k =>
    val keys = k.keys.map(_.fingerprint).toSet
    keys == oldSigningFingerprints || keys == newSigningFingerprints
  })
  .map(_.item.partyId).toSet
require(ownerKeyPartiesInNamespace == rotationPartyIds.toSet,
  s"owner-key parties in the namespace ${ownerKeyPartiesInNamespace.map(partyName).toSeq.sorted.mkString(",")} differ from GG_ROTATION_PARTY_IDS ${rotationPartyIds.map(partyName).mkString(",")}")
println(s"ROTATION parties: ${rotationPartyIds.map(partyName).mkString(",")}")
def fingerprintList(owners: Iterable[Namespace]): String = owners.map(_.fingerprint.toProtoPrimitive).toSeq.sorted.mkString(",")
val recoveryInstruction = "Recover: run gg_rotate_owner_key.sh --resume with the same owner names. It skips the applied steps."

val dnBefore = currentDn()
val ownersBefore = dnBefore.item.owners.toSet
println(s"ROTATION before: DN serial=${dnBefore.context.serial} threshold=${dnBefore.item.threshold} owners=${fingerprintList(ownersBefore)}")
// A DN with the new owners and a PTP without the new signing keys is a half-applied rotation from an earlier run.
val dnAlreadyRotated = ownersBefore == newOwnerSet
if (!dnAlreadyRotated) {
  require(ownersBefore == ownersBeforeRotation, s"current owners ${fingerprintList(ownersBefore)} are neither kept + removed nor kept + added owners")
} else {
  println(s"ROTATION resume: the DN already has the new owner set. PTP signing keys: ${rotationState()}")
}

if (!dnAlreadyRotated) {
  // Step 1: the new owner's self-signed root NamespaceDelegation.
  if (participant.topology.namespace_delegations.list(store).exists(_.item.namespace == addedOwner.namespace)) {
    println("ROTATION added owner root delegation exists")
  } else {
    val addedRoot = signedBy(
      generateUnsigned(NamespaceDelegation.create(addedOwner.namespace, addedOwner.publicKey, DelegationRestriction.CanSignAllMappings)
        .getOrElse(sys.error("NamespaceDelegation"))),
      Seq(addedOwner))
    participant.topology.transactions.load(Seq(addedRoot), store)
    awaitTopology("added owner root delegation") {
      participant.topology.namespace_delegations.list(store).exists(_.item.namespace == addedOwner.namespace)
    }
    println("ROTATION added owner root delegation is effective")
  }

  // Step 2: replace the owner set. Authorized by 2 of the current owners plus the added owner.
  val newDn = DecentralizedNamespaceDefinition.tryCreate(partyId.namespace, dnBefore.item.threshold, newOwnerSet)
  participant.topology.transactions.load(Seq(signedBy(generateUnsigned(newDn), keptOwners :+ addedOwner)), store)
  awaitTopology("decentralized namespace owner set") { currentDn().item.owners.toSet == newOwnerSet }
}
val dnAfter = currentDn()
println(s"ROTATION after: DN serial=${dnAfter.context.serial} threshold=${dnAfter.item.threshold} owners=${fingerprintList(dnAfter.item.owners)}")

// Step 3: replace the party signing keys on the PartyToParticipant of each party. Hosting and confirmation threshold stay.
// The DN change is effective here, so a failure leaves a half-applied rotation.
rotationPartyIds.foreach { party =>
  if (ptpHasNewSigningKeys(party)) {
    println(s"ROTATION PTP signing keys of ${partyName(party)} already rotated")
  } else {
    val ptpRotation = scala.util.Try {
      if (sys.env.get("GG_ROTATION_FAIL_BEFORE_SIGNING_KEYS").contains("true"))
        sys.error("injected fault: GG_ROTATION_FAIL_BEFORE_SIGNING_KEYS=true")
      if (failBeforeSigningKeysOf.contains(partyName(party)))
        sys.error(s"injected fault: GG_ROTATION_FAIL_BEFORE_SIGNING_KEYS_OF=${partyName(party)}")
      val ptpBefore = currentPtp(party)
      val signingThreshold = ptpBefore.item.partySigningKeysWithThreshold.map(_.threshold).getOrElse(sys.error("party has no signing keys"))
      val newSigningKeys = SigningKeysWithThreshold(NonEmpty.mk(Set, keptOwners.head.publicKey, keptOwners(1).publicKey, addedOwner.publicKey), signingThreshold)
      val newPtp = PartyToParticipant.create(party, ptpBefore.item.threshold, ptpBefore.item.participants, Some(newSigningKeys))
        .getOrElse(sys.error("PartyToParticipant"))
      participant.topology.transactions.load(Seq(signedBy(generateUnsigned(newPtp), keptOwners :+ addedOwner)), store)
      awaitTopology(s"party signing keys of ${partyName(party)}") { ptpHasNewSigningKeys(party) }
    }
    ptpRotation.failed.foreach { error =>
      println(s"ROTATION HALF-APPLIED: DN serial=${dnAfter.context.serial} has the new owners, but the PartyToParticipant signing keys are not all rotated: ${rotationState()}. " +
        s"The new owner cannot sign for a not-rotated party. $recoveryInstruction Cause: ${error.getMessage.linesIterator.take(3).mkString(" ")}")
      throw error
    }
  }
  val ptpAfter = currentPtp(party)
  println(s"ROTATION after: PTP party=${partyName(party)} serial=${ptpAfter.context.serial} confirmationThreshold=${ptpAfter.item.threshold} hosts=${ptpAfter.item.participants.size} " +
    s"signingKeys=${ptpAfter.item.partySigningKeysWithThreshold.map(k => s"${k.threshold}-of-${k.keys.size}").getOrElse("none")}")
}
require(rotationPartyIds.forall(ptpHasNewSigningKeys), s"signing keys not rotated: ${rotationState()}")

// Step 4 (negative): the removed owner plus one kept owner cannot authorize a namespace change.
// The Admin API redacts TOPOLOGY_UNAUTHORIZED_TRANSACTION as security-sensitive; gg_rotate_owner_key.sh
// matches the error code in the participant log by the trace id of this request.
val probeDn = DecentralizedNamespaceDefinition.tryCreate(partyId.namespace, dnAfter.item.threshold, newOwnerSet + removedOwner.namespace)
val removedOwnerAttempt = scala.util.Try(
  participant.topology.transactions.load(Seq(signedBy(generateUnsigned(probeDn), Seq(keptOwners.head, removedOwner))), store))
Thread.sleep(5000)
val ownersAfterAttempt = currentDn().item.owners.toSet
println(s"ROTATION removed-owner attempt: load=${removedOwnerAttempt.fold(e => "rejected: " + e.getMessage.linesIterator.take(3).mkString(" "), _ => "accepted by API")} " +
  s"ownersUnchanged=${ownersAfterAttempt == newOwnerSet}")
require(ownersAfterAttempt == newOwnerSet, "removed owner changed the namespace")
require(removedOwnerAttempt.isFailure, "removed-owner attempt: accepted by the API")
println("ROTATION removed-owner attempt rejected by the API")
println("ROTATION done")
