// Offline party replication of external parties to a target participant at Confirmation (Canton 3.7 procedure, 13 steps).
// Runs after owner_signing_prelude.canton.
// REPLICATION_PHASE=prepare: steps 2 to 7. The target consents with the onboarding flag and disconnects; two namespace
//   owner keys sign the same PartyToParticipant; each source exports the party ACS at the activation offset.
// REPLICATION_PHASE=complete: steps 10 to 13. The target imports each ACS (ContractImportMode.Validation), reconnects
//   and clears the onboarding flag. Step 9 (backup) applies to a permanent host; guardian4 is temporary.
// REPLICATION_PHASE=remove-host, add-host-without-consent or set-threshold: a PartyToParticipant replacement that the
//   owner keys sign.
// Before any owner signs, the console compares the PartyToParticipant with its IntendedTopologyChange. The rehearsal
// mappings have 4 hosts, an onboarding host or another confirmation threshold, which checkHostingIsGuardianPolicy rejects.
// Environment:
//   REPLICATION_PARTIES        Comma-separated <party-id>=<source participant name>.
//   REPLICATION_TARGET         Target participant name.
//   REPLICATION_DIR            Directory of the ACS files (<party identifier>.acs.gz) and the offsets file.
//   OWNER_PUBKEY_1/2, OWNER_SIGN_ARGV_1/2   Two namespace owner keys and their signer commands.
//   REPLICATION_AWAIT_MAX_ATTEMPTS          Topology wait bound (default and maximum topologyEffectiveMaxAttempts).
import com.digitalasset.canton.participant.admin.data.ContractImportMode
import com.digitalasset.canton.admin.api.client.data.{FlagNotSet, FlagSet}

def participantNamed(name: String) = participants.remote.find(_.name == name).getOrElse(throw new RuntimeException(s"unknown participant $name"))

val synchronizerAlias = "global"
val replicationPhase = requiredEnvironmentVariable("REPLICATION_PHASE")
val targetParticipant = participantNamed(requiredEnvironmentVariable("REPLICATION_TARGET"))
val replicationDirectory = Paths.get(requiredEnvironmentVariable("REPLICATION_DIR"))
val partiesWithSource: Seq[(PartyId, String)] = requiredEnvironmentVariable("REPLICATION_PARTIES").split(",").toSeq.map { entry =>
  entry.split("=") match {
    case Array(partyText, sourceName) => (PartyId.tryFromProtoPrimitive(partyText.trim), sourceName.trim)
    case _ => throw new RuntimeException(s"REPLICATION_PARTIES entry is not <party>=<source>: $entry")
  }
}
require(partiesWithSource.nonEmpty, "REPLICATION_PARTIES is empty")
require(partiesWithSource.map(_._1).distinct.size == partiesWithSource.size, "REPLICATION_PARTIES names a party twice")
def acsFileOf(partyId: PartyId): String = replicationDirectory.resolve(s"${partyId.uid.identifier}.acs.gz").toString
val targetLedgerEndFile = replicationDirectory.resolve("target-ledger-end.txt")
val replicationAwaitMaxAttempts = sys.env.get("REPLICATION_AWAIT_MAX_ATTEMPTS").map(_.toInt).getOrElse(topologyEffectiveMaxAttempts)

val referenceParticipant = participantNamed(partiesWithSource.head._2)
val physicalSynchronizerId = referenceParticipant.synchronizers.list_connected().find(_.synchronizerAlias.unwrap == synchronizerAlias)
  .getOrElse(throw new RuntimeException(s"${referenceParticipant.name} is not connected to $synchronizerAlias")).physicalSynchronizerId
val synchronizerId = physicalSynchronizerId.logical
val synchronizerStore = TopologyStoreId.Synchronizer(physicalSynchronizerId)
val protocolVersion = physicalSynchronizerId.protocolVersion

def effectiveMappingOf(partyId: PartyId): EffectiveTopologyMapping[PartyToParticipant] = {
  val mappings = referenceParticipant.topology.party_to_participant_mappings.list(synchronizerStore).filter(_.item.partyId == partyId)
  require(mappings.size == 1, s"${referenceParticipant.name} shows ${mappings.size} PartyToParticipant mappings of $partyId, expected 1")
  EffectiveTopologyMapping(mappings.head.item, mappings.head.context.serial)
}
def targetHostingOf(partyId: PartyId): Option[HostingParticipant] =
  referenceParticipant.topology.party_to_participant_mappings.list(synchronizerStore).find(_.item.partyId == partyId)
    .flatMap(_.item.participants.find(_.participantId == targetParticipant.id))

lazy val ownerKeys: Seq[OwnerKey] = {
  val loadedOwnerKeys = Seq(loadOwnerKey("OWNER_PUBKEY_1", "OWNER_SIGN_ARGV_1"), loadOwnerKey("OWNER_PUBKEY_2", "OWNER_SIGN_ARGV_2"))
  require(loadedOwnerKeys.map(_.publicKey.fingerprint).distinct.size == 2, "the two owner keys must differ")
  loadedOwnerKeys
}
// REPLICATION_SIGNER_COUNT (default 2): the number of owner keys that sign a replacement. 1 is the negative check.
val replacementSignerCount = sys.env.getOrElse("REPLICATION_SIGNER_COUNT", "2").toInt
require(replacementSignerCount == 1 || replacementSignerCount == 2, "REPLICATION_SIGNER_COUNT must be 1 or 2")

// The next PartyToParticipant of a party: new hosts and confirmation threshold, the same signing keys, the next serial.
def intendedPartyToParticipantChange(current: EffectiveTopologyMapping[PartyToParticipant], hosts: Seq[HostingParticipant],
    confirmationThreshold: PositiveInt): IntendedTopologyChange = {
  val replacement = PartyToParticipant.create(current.mapping.partyId, confirmationThreshold, hosts, current.mapping.partySigningKeysWithThreshold)
    .fold(error => throw new IllegalArgumentException(s"PartyToParticipant of ${partyName(current.mapping.partyId)}: $error"), identity)
  IntendedTopologyChange(replacement, current.serial.tryAdd(1))
}
def signedByOwners(unsigned: TopologyTransaction[TopologyChangeOp, TopologyMapping], signers: Seq[OwnerKey],
    isProposal: Boolean): GenericSignedTopologyTransaction = {
  require(signers.nonEmpty, "no owner signers")
  val ownerSignatures = signers.map(signWithOwnerKey(_, unsigned.hash.hash))
  ownerSignatures.tail.foldLeft(SignedTopologyTransaction.withSignature(unsigned, ownerSignatures.head, isProposal, protocolVersion))(
    _.addSingleSignature(_))
}
// Replace the PartyToParticipant of a party. replacementSignerCount owner keys sign it.
def replacePartyToParticipant(partyId: PartyId, hosts: Seq[HostingParticipant], confirmationThreshold: PositiveInt): Unit = {
  val intended = intendedPartyToParticipantChange(effectiveMappingOf(partyId), hosts, confirmationThreshold)
  val description = s"PartyToParticipant of $partyId"
  val generatedTransactions = referenceParticipant.topology.transactions.generate(
    Seq(Proposal(intended.mapping, synchronizerStore, TopologyChangeOp.Replace, Some(intended.serial))))
  require(generatedTransactions.size == 1, s"$description: ${referenceParticipant.name} generated ${generatedTransactions.size} transactions, expected 1")
  val unsigned = checkGeneratedTransactionIsIntended(generatedTransactions.head, intended, protocolVersion, s"generated $description")
  referenceParticipant.topology.transactions.load(
    Seq(signedByOwners(unsigned, ownerKeys.take(replacementSignerCount), isProposal = false)), synchronizerStore)
  awaitTopology(s"$description replaced", replicationAwaitMaxAttempts) {
    val effective = effectiveMappingOf(partyId)
    effective.serial == intended.serial && effective.mapping == intended.mapping
  }
}
def describeMapping(partyId: PartyId): String = {
  val effective = effectiveMappingOf(partyId)
  val hostsText = effective.mapping.participants.map(hosting =>
    s"${hosting.participantId.uid.identifier}::${hosting.participantId.fingerprint.toProtoPrimitive.take(8)}/${hosting.permission}" +
      (if (hosting.onboarding) "/onboarding" else "")).mkString(",")
  s"serial=${effective.serial} threshold=${effective.mapping.threshold} hosts=$hostsText"
}

replicationPhase match {
  case "prepare" =>
    Files.createDirectories(replicationDirectory)
    partiesWithSource.foreach { case (partyId, _) => require(targetHostingOf(partyId).isEmpty, s"${targetParticipant.name} already hosts $partyId") }
    val mappingsBeforeOnboarding = partiesWithSource.map { case (partyId, _) => partyId -> effectiveMappingOf(partyId) }.toMap
    // Step 2: data retention on each source.
    partiesWithSource.map(_._2).distinct.foreach { sourceName =>
      println(s"REPLICATION step2 $sourceName pruningSchedule=${participantNamed(sourceName).pruning.get_schedule()}")
    }
    // Step 3: the target consents with the onboarding flag.
    partiesWithSource.foreach { case (partyId, _) =>
      targetParticipant.topology.party_to_participant_mappings.propose_delta(party = partyId,
        adds = Seq((targetParticipant.id, ParticipantPermission.Confirmation)), store = synchronizerStore, requiresPartyToBeOnboarded = true)
    }
    def targetProposalOf(partyId: PartyId): Option[GenericSignedTopologyTransaction] =
      referenceParticipant.topology.transactions.list(synchronizerStore, proposals = true, filterAuthorizedKey = Some(targetParticipant.id.fingerprint))
        .result.map(_.transaction).find(signed => signed.mapping match {
          case mapping: PartyToParticipant =>
            mapping.partyId == partyId && mapping.participants.exists(hosting => hosting.participantId == targetParticipant.id && hosting.onboarding)
          case _ => false
        })
    partiesWithSource.foreach { case (partyId, _) =>
      awaitTopology(s"target proposal for $partyId", replicationAwaitMaxAttempts)(targetProposalOf(partyId).nonEmpty)
    }
    println("REPLICATION step3 target proposals are on the synchronizer")
    // Steps 4 and 5: the target disconnects and stays disconnected on restart.
    targetParticipant.synchronizers.disconnect_all()
    targetParticipant.synchronizers.modify(synchronizerAlias, _.copy(manualConnect = true))
    require(targetParticipant.synchronizers.list_connected().isEmpty, s"${targetParticipant.name} is still connected")
    println(s"REPLICATION step4-5 ${targetParticipant.name} disconnected, manualConnect=true")
    // Step 6: two owner keys sign the PartyToParticipant that the target proposed.
    val beforeActivationOffsets = partiesWithSource.map { case (partyId, sourceName) => partyId -> participantNamed(sourceName).ledger_api.state.end() }.toMap
    partiesWithSource.foreach { case (partyId, _) =>
      val proposal = targetProposalOf(partyId).getOrElse(sys.error(s"target proposal for $partyId disappeared"))
      val mappingBeforeOnboarding = mappingsBeforeOnboarding(partyId)
      val intendedHosts =
        mappingBeforeOnboarding.mapping.participants :+ HostingParticipant(targetParticipant.id, ParticipantPermission.Confirmation, true)
      // propose_delta chooses the host order, and the hash covers it: the intended hosts take that order when they are
      // the same hosts.
      val proposedHosts = proposal.mapping match {
        case proposedMapping: PartyToParticipant => proposedMapping.participants
        case otherMapping => throw new IllegalStateException(s"target proposal for $partyId has mapping ${otherMapping.code}")
      }
      val intendedHostsInProposedOrder =
        if (proposedHosts.size == intendedHosts.size && proposedHosts.toSet == intendedHosts.toSet) proposedHosts else intendedHosts
      val intended = intendedPartyToParticipantChange(mappingBeforeOnboarding, intendedHostsInProposedOrder,
        mappingBeforeOnboarding.mapping.threshold)
      val unsigned = checkGeneratedTransactionIsIntended(proposal.transaction, intended, protocolVersion, s"target proposal for $partyId")
      referenceParticipant.topology.transactions.load(Seq(signedByOwners(unsigned, ownerKeys, isProposal = true)), synchronizerStore)
    }
    partiesWithSource.foreach { case (partyId, _) =>
      awaitTopology(s"onboarding hosting of $partyId", replicationAwaitMaxAttempts)(targetHostingOf(partyId).exists(_.onboarding))
    }
    partiesWithSource.foreach { case (partyId, _) => println(s"REPLICATION step6 ${partyId.uid.identifier} hosting=${targetHostingOf(partyId)}") }
    // Step 7: each source exports the party ACS at the offset where the party becomes active on the target.
    partiesWithSource.foreach { case (partyId, sourceName) =>
      participantNamed(sourceName).parties.export_party_acs(party = partyId, synchronizerId = synchronizerId, targetParticipantId = targetParticipant.id,
        beginOffsetExclusive = beforeActivationOffsets(partyId), exportFilePath = acsFileOf(partyId))
      println(s"REPLICATION step7 ${partyId.uid.identifier} exported from $sourceName to ${acsFileOf(partyId)} bytes=${Files.size(Paths.get(acsFileOf(partyId)))}")
    }
    println("REPLICATION prepare done")

  case "complete" =>
    partiesWithSource.foreach { case (partyId, _) =>
      require(targetHostingOf(partyId).exists(_.onboarding), s"$partyId is not onboarding on ${targetParticipant.name}")
    }
    require(targetParticipant.synchronizers.list_connected().isEmpty, s"${targetParticipant.name} must be disconnected before the import")
    // Step 10: the target imports each ACS with contract validation.
    partiesWithSource.foreach { case (partyId, _) =>
      val importResult = scala.util.Try(targetParticipant.parties.import_party_acs(synchronizerId, party = Some(partyId),
        importFilePath = acsFileOf(partyId), contractImportMode = ContractImportMode.Validation))
      println(s"REPLICATION step10 ${partyId.uid.identifier} import=${importResult.fold(error => "rejected: " + error.getMessage.linesIterator.take(6).mkString(" "), _ => "accepted")}")
      importResult.get
    }
    // Steps 11 and 12: reconnect and restore automatic reconnection.
    val targetLedgerEnd = targetParticipant.ledger_api.state.end()
    Files.writeString(targetLedgerEndFile, targetLedgerEnd.toString)
    targetParticipant.synchronizers.reconnect(synchronizerAlias)
    targetParticipant.synchronizers.modify(synchronizerAlias, _.copy(manualConnect = false))
    println(s"REPLICATION step11-12 ${targetParticipant.name} reconnected=${targetParticipant.synchronizers.active(synchronizerAlias)} ledgerEnd=$targetLedgerEnd")
    // Step 13: clear the onboarding flag once it is safe.
    partiesWithSource.foreach { case (partyId, _) =>
      utils.retry_until_true(timeout = 5.minutes, maxWaitPeriod = 10.seconds) {
        targetParticipant.parties.clear_party_onboarding_flag(partyId, synchronizerId, targetLedgerEnd) match {
          case FlagNotSet => true
          case FlagSet(_) => false
        }
      }
      awaitTopology(s"onboarding flag of $partyId cleared", replicationAwaitMaxAttempts)(targetHostingOf(partyId).exists(!_.onboarding))
      println(s"REPLICATION step13 ${partyId.uid.identifier} hosting=${targetHostingOf(partyId)}")
    }
    println("REPLICATION complete done")

  // REPLICATION_REMOVED_HOST: a participant id, or a console participant name. Keeps the confirmation threshold.
  case "remove-host" =>
    val removedHostText = requiredEnvironmentVariable("REPLICATION_REMOVED_HOST")
    val removedHostId = participants.remote.find(_.name == removedHostText).map(_.id).getOrElse(ParticipantId.tryFromProtoPrimitive(removedHostText))
    partiesWithSource.foreach { case (partyId, _) =>
      val current = effectiveMappingOf(partyId).mapping
      require(current.participants.exists(_.participantId == removedHostId), s"$removedHostId does not host $partyId")
      replacePartyToParticipant(partyId, current.participants.filterNot(_.participantId == removedHostId), current.threshold)
      println(s"REPLICATION remove-host ${partyId.uid.identifier} ${describeMapping(partyId)}")
    }
    println("REPLICATION remove-host done")

  // REPLICATION_ADDED_HOST: a console participant name. Only the owner keys sign: the host-consent negative check.
  case "add-host-without-consent" =>
    val addedHost = participantNamed(requiredEnvironmentVariable("REPLICATION_ADDED_HOST"))
    partiesWithSource.foreach { case (partyId, _) =>
      val current = effectiveMappingOf(partyId).mapping
      require(!current.participants.exists(_.participantId == addedHost.id), s"${addedHost.name} already hosts $partyId")
      replacePartyToParticipant(partyId, current.participants :+ HostingParticipant(addedHost.id, ParticipantPermission.Confirmation), current.threshold)
      println(s"REPLICATION add-host-without-consent ${partyId.uid.identifier} ${describeMapping(partyId)}")
    }
    println("REPLICATION add-host-without-consent done")

  // REPLICATION_CONFIRMATION_THRESHOLD: the new confirmation threshold. Keeps the hosts.
  case "set-threshold" =>
    val confirmationThreshold = PositiveInt.tryCreate(requiredEnvironmentVariable("REPLICATION_CONFIRMATION_THRESHOLD").toInt)
    partiesWithSource.foreach { case (partyId, _) =>
      replacePartyToParticipant(partyId, effectiveMappingOf(partyId).mapping.participants, confirmationThreshold)
      println(s"REPLICATION set-threshold ${partyId.uid.identifier} ${describeMapping(partyId)}")
    }
    println("REPLICATION set-threshold done")

  // REPLICATION_PERMISSION_HOST (participant id or console name) and REPLICATION_HOST_PERMISSION (Observation or
  // Confirmation): set that host's permission, keeping the hosts, threshold and signing keys. Observation then
  // Confirmation is the observation-first onboarding promotion. Strengthening the target host to Confirmation needs that
  // host's own authorization, so the host proposes and the owner keys co-sign; weakening to Observation needs only the
  // owner keys.
  case "set-permission" =>
    val permissionHostText = requiredEnvironmentVariable("REPLICATION_PERMISSION_HOST")
    val permissionHostId = participants.remote.find(_.name == permissionHostText).map(_.id).getOrElse(ParticipantId.tryFromProtoPrimitive(permissionHostText))
    val targetPermission = requiredEnvironmentVariable("REPLICATION_HOST_PERMISSION") match {
      case "Observation" => ParticipantPermission.Observation
      case "Confirmation" => ParticipantPermission.Confirmation
      case other => throw new RuntimeException(s"REPLICATION_HOST_PERMISSION must be Observation or Confirmation, not $other")
    }
    val needsHostConsent = targetPermission == ParticipantPermission.Confirmation && permissionHostId == targetParticipant.id
    def promotionProposalOf(partyId: PartyId): Option[GenericSignedTopologyTransaction] =
      referenceParticipant.topology.transactions.list(synchronizerStore, proposals = true, filterAuthorizedKey = Some(targetParticipant.id.fingerprint))
        .result.map(_.transaction).find(signed => signed.mapping match {
          case mapping: PartyToParticipant =>
            mapping.partyId == partyId && mapping.participants.exists(hosting =>
              hosting.participantId == targetParticipant.id && hosting.permission == targetPermission && !hosting.onboarding)
          case _ => false
        })
    partiesWithSource.foreach { case (partyId, _) =>
      val current = effectiveMappingOf(partyId)
      val currentHost = current.mapping.participants.find(_.participantId == permissionHostId)
        .getOrElse(throw new IllegalArgumentException(s"$permissionHostId does not host $partyId"))
      val updatedHosts = current.mapping.participants.map(hosting =>
        if (hosting.participantId == permissionHostId) HostingParticipant(permissionHostId, targetPermission) else hosting)
      if (currentHost.permission == targetPermission) {
        println(s"REPLICATION set-permission ${partyId.uid.identifier} already $targetPermission ${describeMapping(partyId)}")
      } else if (needsHostConsent) {
        targetParticipant.topology.party_to_participant_mappings.propose_delta(party = partyId,
          adds = Seq((targetParticipant.id, targetPermission)), store = synchronizerStore)
        awaitTopology(s"promotion proposal for $partyId", replicationAwaitMaxAttempts)(promotionProposalOf(partyId).nonEmpty)
        val proposal = promotionProposalOf(partyId).getOrElse(sys.error(s"promotion proposal for $partyId disappeared"))
        val proposedHosts = proposal.mapping match {
          case proposedMapping: PartyToParticipant => proposedMapping.participants
          case otherMapping => throw new IllegalStateException(s"promotion proposal for $partyId has mapping ${otherMapping.code}")
        }
        val intendedHostsInProposedOrder =
          if (proposedHosts.size == updatedHosts.size && proposedHosts.toSet == updatedHosts.toSet) proposedHosts else updatedHosts
        val intended = intendedPartyToParticipantChange(current, intendedHostsInProposedOrder, current.mapping.threshold)
        val unsigned = checkGeneratedTransactionIsIntended(proposal.transaction, intended, protocolVersion, s"promotion proposal for $partyId")
        referenceParticipant.topology.transactions.load(Seq(signedByOwners(unsigned, ownerKeys, isProposal = true)), synchronizerStore)
        awaitTopology(s"promotion of $partyId", replicationAwaitMaxAttempts) {
          val effective = effectiveMappingOf(partyId)
          effective.serial == intended.serial && effective.mapping == intended.mapping
        }
        println(s"REPLICATION set-permission ${partyId.uid.identifier} ${describeMapping(partyId)}")
      } else {
        replacePartyToParticipant(partyId, updatedHosts, current.mapping.threshold)
        println(s"REPLICATION set-permission ${partyId.uid.identifier} ${describeMapping(partyId)}")
      }
    }
    println("REPLICATION set-permission done")

  case otherPhase => throw new RuntimeException(s"unknown REPLICATION_PHASE $otherPhase")
}
