// Decisions of the owner-key rotation (console/gg_rotate_owner_key.canton) as functions of topology values.
// Run after owner_signing_prelude.canton.
import com.digitalasset.canton.version.{ProtocolVersion, ProtocolVersionValidation}

val namespaceRotationTargetName = "namespace"
val maxSignedRotationTransactionsFileBytes = 1L << 20

// checkRotationPartyOrder: the parties of the guardian namespace in load order. guardianGovernance is last, so the
// party that holds the reserves changes first.
def checkRotationPartyOrder(rotationPartyIds: Seq[PartyId], guardianGovernancePartyId: PartyId): Unit = {
  require(rotationPartyIds.nonEmpty, "no rotation parties")
  require(rotationPartyIds.distinct.size == rotationPartyIds.size,
    s"duplicate party in the rotation parties ${rotationPartyIds.map(partyName).mkString(",")}")
  rotationPartyIds.foreach(party =>
    require(party.namespace == guardianGovernancePartyId.namespace, s"${party.toProtoPrimitive} is outside the guardian namespace"))
  require(rotationPartyIds.last == guardianGovernancePartyId,
    s"guardianGovernance must be the last rotation party: ${rotationPartyIds.map(partyName).mkString(",")}")
}

// Key set of one rotation target: the namespace owners, or the signing keys of one party.
sealed trait RotationKeySet
object RotationKeySet {
  case object OldKeySet extends RotationKeySet
  case object NewKeySet extends RotationKeySet
  final case class UnknownKeySet(fingerprints: Set[Fingerprint]) extends RotationKeySet
}
def classifyRotationKeySet(fingerprints: Set[Fingerprint], oldFingerprints: Set[Fingerprint],
    newFingerprints: Set[Fingerprint]): RotationKeySet = {
  require(oldFingerprints != newFingerprints, "old and new key sets are equal")
  if (fingerprints == oldFingerprints) RotationKeySet.OldKeySet
  else if (fingerprints == newFingerprints) RotationKeySet.NewKeySet
  else RotationKeySet.UnknownKeySet(fingerprints)
}

final case class RotationTarget(name: String, keySet: RotationKeySet)
sealed trait RotationOutcome
object RotationOutcome {
  case object FullyApplied extends RotationOutcome
  case object NotApplied extends RotationOutcome
  final case class HalfApplied(targetsThatAcceptTheRemovedKey: Seq[String]) extends RotationOutcome
}
def classifyRotationOutcome(targets: Seq[RotationTarget]): RotationOutcome = {
  require(targets.nonEmpty, "no rotation targets")
  require(targets.map(_.name).distinct.size == targets.size, s"duplicate rotation target in ${targets.map(_.name).mkString(",")}")
  targets.foreach {
    case RotationTarget(name, RotationKeySet.UnknownKeySet(fingerprints)) =>
      throw new IllegalStateException(
        s"$name has a key set that is neither the old set nor the new set: ${sortedFingerprintText(fingerprints)}")
    case _ => ()
  }
  val targetsWithOldKeys = targets.filter(_.keySet == RotationKeySet.OldKeySet).map(_.name)
  if (targetsWithOldKeys.isEmpty) RotationOutcome.FullyApplied
  else if (targetsWithOldKeys.size == targets.size) RotationOutcome.NotApplied
  else RotationOutcome.HalfApplied(targetsWithOldKeys)
}

def signingFingerprintsOf(mapping: PartyToParticipant): Set[Fingerprint] =
  mapping.partySigningKeysWithThreshold.map(_.keys.forgetNE.map(_.fingerprint).toSet).getOrElse(Set.empty[Fingerprint])

// rotatedPartyToParticipant: same party, hosts, confirmation threshold and signing key threshold; new signing keys.
def rotatedPartyToParticipant(current: PartyToParticipant, newSigningKeys: NonEmpty[Set[SigningPublicKey]]): PartyToParticipant = {
  val currentSigningKeys = current.partySigningKeysWithThreshold
    .getOrElse(throw new IllegalArgumentException(s"${partyName(current.partyId)} has no party signing keys"))
  PartyToParticipant.create(current.partyId, current.threshold, current.participants,
      Some(SigningKeysWithThreshold(newSigningKeys, currentSigningKeys.threshold)))
    .fold(error => throw new IllegalArgumentException(s"rotated PartyToParticipant of ${partyName(current.partyId)}: $error"), identity)
}

// checkStoredRotationTransactions: exactly the signed changes of one rotation. One namespace definition with the new
// owners, one PartyToParticipant with the new signing keys for each rotation party, and at most the root delegation
// of the added owner.
def checkStoredRotationTransactions(storedTransactions: Seq[GenericSignedTopologyTransaction], rotationPartyIds: Seq[PartyId],
    guardianNamespace: Namespace, newOwnerNamespaces: Set[Namespace], newSigningFingerprints: Set[Fingerprint],
    addedOwnerKey: SigningPublicKey): Unit = {
  storedTransactions.foreach(transaction =>
    require(transaction.operation == TopologyChangeOp.Replace, s"stored ${transaction.mapping.code} is not a Replace"))
  val namespaceDefinitions = storedTransactions.map(_.mapping).collect { case definition: DecentralizedNamespaceDefinition => definition }
  require(namespaceDefinitions.size == 1, s"expected exactly one stored namespace definition, found ${namespaceDefinitions.size}")
  require(namespaceDefinitions.head.namespace == guardianNamespace, "stored namespace definition is for another namespace")
  require(namespaceDefinitions.head.owners.forgetNE == newOwnerNamespaces, "stored namespace definition does not have the new owners")
  val partyMappings = storedTransactions.map(_.mapping).collect { case mapping: PartyToParticipant => mapping }
  require(partyMappings.map(_.partyId).sortBy(_.toProtoPrimitive) == rotationPartyIds.sortBy(_.toProtoPrimitive),
    s"stored PartyToParticipant parties ${partyMappings.map(mapping => partyName(mapping.partyId)).mkString(",")} " +
      s"differ from the rotation parties ${rotationPartyIds.map(partyName).mkString(",")}")
  partyMappings.foreach(mapping => require(signingFingerprintsOf(mapping) == newSigningFingerprints,
    s"stored PartyToParticipant of ${partyName(mapping.partyId)} does not have the new signing keys"))
  val rootDelegations = storedTransactions.map(_.mapping).collect { case delegation: NamespaceDelegation => delegation }
  require(rootDelegations.size <= 1, s"expected at most one stored root delegation, found ${rootDelegations.size}")
  rootDelegations.foreach(delegation => require(
    delegation.namespace == Namespace(addedOwnerKey.fingerprint) && delegation.target == addedOwnerKey,
    "stored root delegation is not the root delegation of the added owner"))
  require(storedTransactions.size == namespaceDefinitions.size + partyMappings.size + rootDelegations.size,
    "stored transactions hold a mapping of another type")
}

def writeSignedRotationTransactions(path: String, signedTransactions: Seq[GenericSignedTopologyTransaction],
    protocolVersion: ProtocolVersion): Unit = {
  require(signedTransactions.nonEmpty, "no signed rotation transactions to store")
  SignedTopologyTransactions(signedTransactions, protocolVersion).writeToFile(path)
}
def readSignedRotationTransactions(path: String, protocolVersion: ProtocolVersion): Seq[GenericSignedTopologyTransaction] = {
  val storedFile = Paths.get(path)
  require(Files.isRegularFile(storedFile), s"no signed rotation transactions file $path")
  require(Files.size(storedFile) <= maxSignedRotationTransactionsFileBytes, s"$path is larger than $maxSignedRotationTransactionsFileBytes bytes")
  SignedTopologyTransactions.fromByteString(ProtocolVersionValidation(protocolVersion),
      TopologyTransactionDeserializationContext(com.digitalasset.canton.protocol.SynchronizerLimits.default),
      ByteString.copyFrom(Files.readAllBytes(storedFile)))
    .fold(error => throw new RuntimeException(s"cannot read the signed rotation transactions in $path: $error"), _.transactions)
}

// Load 1 holds the root delegation of the added owner. Load 2 holds the PartyToParticipant of each rotation party in
// rotation order, then the namespace definition.
final case class RotationLoadOrder(rootDelegation: Option[GenericSignedTopologyTransaction],
    namespaceAndPartyBatch: Seq[GenericSignedTopologyTransaction])
def rotationLoadOrder(storedTransactions: Seq[GenericSignedTopologyTransaction], rotationPartyIds: Seq[PartyId]): RotationLoadOrder = {
  val rootDelegations = storedTransactions.filter(_.mapping.isInstanceOf[NamespaceDelegation])
  require(rootDelegations.size <= 1, s"expected at most one root delegation, found ${rootDelegations.size}")
  val partyChanges = rotationPartyIds.map(party => storedTransactions.filter(_.mapping match {
    case mapping: PartyToParticipant => mapping.partyId == party
    case _ => false
  }) match {
    case Seq(partyChange) => partyChange
    case other => throw new IllegalArgumentException(s"expected one PartyToParticipant of ${partyName(party)}, found ${other.size}")
  })
  val namespaceChanges = storedTransactions.filter(_.mapping.isInstanceOf[DecentralizedNamespaceDefinition])
  require(namespaceChanges.size == 1, s"expected one namespace definition, found ${namespaceChanges.size}")
  RotationLoadOrder(rootDelegations.headOption, partyChanges ++ namespaceChanges)
}

// Canton 3.7.3 gives each transaction of one load call its own effective time, in load order (LocalNet spread about
// 1 s). Until the last mapping is effective, the later mappings accept the removed key. The bound turns a stalled
// load into a failure.
val maxRotationEffectiveTimeSpread = java.time.Duration.ofSeconds(30)

// checkEffectiveTimesFollowLoadOrderWithinBound: each time is strictly after the time before it, and the last time
// is at most maxRotationEffectiveTimeSpread after the first. Returns that spread.
def checkEffectiveTimesFollowLoadOrderWithinBound(effectiveTimesInLoadOrder: Seq[(String, java.time.Instant)]): java.time.Duration = {
  require(effectiveTimesInLoadOrder.nonEmpty, "no effective times")
  effectiveTimesInLoadOrder.sliding(2).collect { case Seq(earlier, later) => (earlier, later) }.foreach {
    case ((earlierName, earlierTime), (laterName, laterTime)) =>
      require(laterTime.isAfter(earlierTime),
        s"effective times are not strictly increasing in load order: $laterName=$laterTime is not after $earlierName=$earlierTime")
  }
  val spread = java.time.Duration.between(effectiveTimesInLoadOrder.head._2, effectiveTimesInLoadOrder.last._2)
  require(!spread.isNegative, s"negative effective time spread $spread")
  require(spread.compareTo(maxRotationEffectiveTimeSpread) <= 0,
    s"effective time spread $spread is above the bound $maxRotationEffectiveTimeSpread")
  spread
}

def effectiveTimesText(effectiveTimes: Seq[(String, java.time.Instant)]): String =
  effectiveTimes.map { case (name, effectiveTime) => s"$name=$effectiveTime" }.mkString(" ")

def spreadSecondsText(spread: java.time.Duration): String =
  java.math.BigDecimal.valueOf(spread.toNanos, 9).setScale(3, java.math.RoundingMode.HALF_UP).toPlainString

// checkRotationSafetyStop: runs before any change. The rotation parties are exactly the parties with a
// PartyToParticipant in the namespace. The namespace owners and the signing keys of each such party are the old or
// the new key set of this rotation.
def checkRotationSafetyStop(namespaceOwnerFingerprints: Set[Fingerprint], namespacePartyMappings: Seq[PartyToParticipant],
    rotationPartyIds: Seq[PartyId], oldFingerprints: Set[Fingerprint], newFingerprints: Set[Fingerprint]): Unit = {
  val namespacePartyIds = namespacePartyMappings.map(_.partyId)
  namespacePartyIds.diff(namespacePartyIds.distinct).headOption.foreach(party =>
    throw new IllegalArgumentException(s"SAFETY STOP: more than one PartyToParticipant of ${partyName(party)}"))
  require(namespacePartyIds.toSet == rotationPartyIds.toSet,
    s"SAFETY STOP: PartyToParticipant parties in the namespace ${namespacePartyIds.map(partyName).sorted.mkString(",")} " +
      s"differ from GG_ROTATION_PARTY_IDS ${rotationPartyIds.map(partyName).mkString(",")}")
  require(namespaceOwnerFingerprints == oldFingerprints || namespaceOwnerFingerprints == newFingerprints,
    s"SAFETY STOP: namespace owners ${sortedFingerprintText(namespaceOwnerFingerprints)} are neither the old set nor the new set")
  namespacePartyMappings.sortBy(mapping => partyName(mapping.partyId)).foreach { mapping =>
    val signingFingerprints = signingFingerprintsOf(mapping)
    val signingFingerprintText = if (signingFingerprints.isEmpty) "none" else sortedFingerprintText(signingFingerprints)
    require(signingFingerprints == oldFingerprints || signingFingerprints == newFingerprints,
      s"SAFETY STOP: ${partyName(mapping.partyId)} signing keys $signingFingerprintText are neither the old set nor the new set")
  }
}
