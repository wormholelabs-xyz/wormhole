-- | The core-bridge state singleton, emitter registration, and message
-- publishing. Mirrors @Implementation.sol@ (publishMessage), @State.sol@
-- (storage), and @Governance.sol@ (governance choices).
--
-- State is the active-contract set, so the "core contract" is a single
-- long-lived 'CoreState', archived and recreated on every governance
-- transition.
--
-- No contract keys: on Daml-LF 2.3 keys are non-unique and resolve against the
-- submission's readers (negative lookups fail open — see 'Wormhole.Core.Replay'),
-- so they carry neither uniqueness nor authenticity. Contracts are addressed by
-- contract-id — stakeholders resolve current cids from their own ACS (the
-- successor arrives as a CreatedEvent of the consuming exercise); non-stakeholders
-- receive cids with explicit disclosures from the off-ledger disclosure service
-- (README §4.7). Any guardian participant serves each disclosure: guardianGovernance
-- signs every core contract. Authenticity is checked on the PAYLOAD, never the
-- resolution path: signatories cannot be forged, so a 'CoreState' whose
-- @guardianGovernance@ is the known anchor is authentic by construction.
-- 'PublishMessage', 'RegisterEmitter', and 'ClaimReplayRoot' exercise
-- 'GetGuardianGovernance' and compare it against the @guardianGovernance@
-- committed on the emitter/registry before charging; guardianGovernance pins the
-- 'CoreState', which pins @feeRecipient@.
--
-- Two invariants:
--
--   * 'CoreState' singleton signed by @guardianGovernance@ and @feeRecipient@
--     (feeCustody). guardianGovernance is the guardians' governance anchor — in
--     production a decentralized-namespace external party under a k-of-n
--     threshold of guardian keys (the Canton Network DSO pattern), rotated at the
--     topology layer without touching this template. It signs only at genesis;
--     transitions ('SubmitGovernanceVAA', any submitter) inherit its authority
--     from the archived contract. "Exactly one" is behavioral, but the
--     guardian-set contents are cryptographically anchored by its signature.
--   * Emitter identity is cryptographic: the 32-byte address is
--     @keccak256(tag ‖ registrar ‖ owner ‖ id)@ ('emitterAddressFor'), the
--     registrar is guardianGovernance, and the @owner@ co-signs, so a contract
--     carrying an existing emitter's address needs the owner's signature. This
--     is the invariant guardians verify by replay.
--
-- Per-emitter sequence numbers live in each 'Emitter', not 'CoreState', so
-- publishing is permissionless: the owner advances its own sequence, matching
-- EVM's @publishMessage@. 'CoreState' holds only shared config and governance
-- state.
module Wormhole.Core.State where

import DA.Action (foldlA, when)
import DA.Map (Map)
import DA.Map qualified as Map
import DA.Either (isRight)
import DA.Foldable (forA_, minimum, maximum)
import DA.List (sortOn)
import DA.Optional (fromSomeNote, isSome, optionalToList)
import DA.Set qualified as Set
import DA.Text qualified as T
import DA.Time (addRelTime, seconds)
import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Splice.Api.Token.HoldingV1 (InstrumentId)
import Splice.Api.Token.AllocationV1 (Allocation)
import Wormhole.Core.Bytes
import Wormhole.Core.Fees
import Wormhole.Core.GuardianSet
import Wormhole.Core.Governance
import Wormhole.Core.Replay
import Wormhole.Core.VAA

-- | The message record produced by 'PublishMessage' — the wire contract with
-- the guardian watcher, read from @ExercisedEvent.exercise_result@ on the
-- Ledger-API stream. Equivalent to the EVM @LogMessagePublished@ event.
--
-- Instead of a 32-byte @sender@ it carries the emitter identity components
-- (@registrar@, @owner@, @emitterId@); the watcher derives the address as
-- @keccak256(tag ‖ registrar ‖ owner ‖ emitterId)@ ('emitterAddressFor') and is
-- its sole source of truth, never trusting the on-ledger value (the @owner@ in
-- the preimage blocks impersonation — see the module header). The
-- 'timestamp' (whitepaper 0001/0004) is likewise the watcher's, from the ledger
-- effective time, so it is absent here.
data WormholeMessage = WormholeMessage with
    registrar        : Party     -- guardianGovernance, the registry signatory; address input
    owner            : Party     -- the emitting party; address input
    emitterId        : Int       -- registry-allocated; address input
    sequence         : Int       -- uint64
    nonce            : Int       -- uint32
    consistencyLevel : Int       -- uint8
    payload          : MessagePayload
  deriving (Eq, Show)

-- | Wire ranges of 'WormholeMessage' fields; the watcher drops a message
-- outside them (@cantongrpc.go@ @decodeWormholeMessage@). The watcher applies
-- the 'MessagePayload' rule to the payload (@messagePayloadField@).
maxNonceUint32 : Int
maxNonceUint32 = 4294967295

maxConsistencyLevelUint8 : Int
maxConsistencyLevelUint8 = 255

-- | 2^53 - 1: emitter ids stay exact in every tool, including JSON doubles.
maxEmitterId : Int
maxEmitterId = 9007199254740991

-- | One below Int max, so the successor's @sequence + 1@ cannot overflow.
maxEmitterSequence : Int
maxEmitterSequence = 9223372036854775806

-- | Bound of the registration and claim fees: 10^6 fee-instrument units, in 10^-10 units.
maxOnboardingFee : Int
maxOnboardingFee = 10000000000000000

----------------------------------------------------------------------
-- Core state singleton
----------------------------------------------------------------------

-- | Shared verification core of 'ParseAndVerifyVAA' and 'VerifyAndConsumeVAA':
-- parse, resolve the guardian set the VAA names, and verify signatures against
-- it (a non-current-but-unexpired set is accepted; 'verifyVAA' checks it is
-- still active). @pubKeys@ are untrusted hints bound to guardian addresses in
-- 'verifyVAA'. 'governanceOutcomeFor' uses the CURRENT set
-- only (EVM Governance.sol parity). Pure: the caller reads the ledger time with
-- 'getTime' and passes it as @now@.
verifyEncoded : CoreState -> EncodedVaa -> [(Int, GuardianPublicKey)] -> Time -> Either Text VAA
verifyEncoded st encodedVAA pubKeys now =
  let vaa = parseVAA encodedVAA
      signingSet = fromSomeNote "unknown guardian set index" (Map.lookup vaa.guardianSetIndex st.guardianSets)
  in verifyVAA signingSet vaa pubKeys now >> pure vaa

template CoreState
  with
    guardianGovernance : Party              -- guardians' governance anchor (threshold party)
    chainId            : Int                -- 75 (Canton)
    governanceChainId  : Int                -- 1 (Solana)
    governanceContract : EmitterAddress     -- governance emitter address
    guardianSetIndex   : Int                -- index of the current set
    guardianSets       : Map Int GuardianSet
    messageFee         : Int                -- per-publish fee, 10^-10 feeInstrument
                                            -- units; governance-set via SetMessageFee
    feeInstrument      : InstrumentId       -- CIP-0056 instrument fees are paid in (CC on
                                            -- mainnet). Genesis-fixed: no governance action
                                            -- covers it. Its admin is neither
                                            -- guardianGovernance nor feeCustody.
    feeRecipient       : Party              -- feeCustody: quorum party in the guardian namespace,
                                            -- distinct from guardianGovernance. Genesis-fixed.
    consumedGovernance : Map VaaDigest Int    -- governance-only replay protection: digest ->
                                            -- VAA body timestamp, seconds. At most
                                            -- 'maxRetainedGovernanceDigests' entries. App VAAs
                                            -- use the 'ReplayNode' trie.
    evictedGovernanceMaxTimestampSeconds : Optional Int
                                            -- highest timestamp of an evicted digest;
                                            -- governance VAAs at or below it fail
  where
    -- guardianGovernance's signature anchors the guardian set (module header).
    -- Transitions inherit its authority from the archived contract, so it signs
    -- only at genesis.
    -- SECURITY: feeRecipient co-signs so 'chargeFee' can supply the receiver
    -- authority without guardianGovernance being an allocation controller.
    signatory guardianGovernance, feeRecipient

    -- Applies to genesis (raw creates from the LocalNet and devnet scripts) and to each governance re-create.
    -- SECURITY: the fee registry body runs with the authority of the receiver
    -- and of the instrument admin, which signs each fee allocation. Neither may
    -- be guardianGovernance, and the instrument admin may not be the receiver.
    -- 'chargeFee' repeats each rule. The byte checks re-run the type rules on
    -- values from the Ledger API.
    ensure and
      [ feeRecipient /= guardianGovernance
      , feeInstrument.admin /= guardianGovernance
      , feeInstrument.admin /= feeRecipient
      , messageFee >= 0
      , checkGuardianSetsAreConsistent guardianSetIndex guardianSets
      , checkHexValueIsWellFormed governanceContract
      , all checkHexValueIsWellFormed (Map.keys consumedGovernance)
      , Map.size guardianSets <= maxStoredGuardianSets
      , checkConsumedGovernanceIsBounded evictedGovernanceMaxTimestampSeconds consumedGovernance
      ]

    -- | Read-only VAA verification against the named, unexpired guardian set, for the
    -- token bridge / external verifiers. @pubKeys@ are untrusted hints bound to
    -- guardian addresses in 'verifyVAA'.
    --
    -- @verifier@ (any party) is the sole controller: this choice is
    -- @nonconsuming@ and creates/archives nothing. The one requirement is visibility: a
    -- non-stakeholder needs 'CoreState' explicitly disclosed to it — a data
    -- attachment, not a signature —
    -- <https://docs.digitalasset.com/build/3.4/sdlc-howtos/applications/develop/explicit-contract-disclosure.html>.
    -- In Daml Script that is @'submitWithDisclosures'@ (see
    -- @testParseAndVerifyVAAByExternalVerifier@).
    nonconsuming choice ParseAndVerifyVAA : VAA
      with
        verifier   : Party
        encodedVAA : EncodedVaa
        pubKeys    : [(Int, GuardianPublicKey)]
      controller verifier
      do
        checkVaaSubmissionIsWellFormed encodedVAA pubKeys
        now <- getTime
        either assertFail pure (verifyEncoded this encodedVAA pubKeys now)

    -- | Read the @guardianGovernance@ anchor off an authentic 'CoreState' — the
    -- caller-side authenticity pin for anyone addressing this contract by cid. A
    -- plain @fetch@ needs a stakeholder among the authorizers and disclosure
    -- grants only visibility, so third-party reads go through this nonconsuming
    -- choice. The result is bound to the exercised contract, so a shadow
    -- 'CoreState' under a rogue gg returns the rogue gg and fails the caller's
    -- pin. Used by 'Wormhole.Ntt.Manager.Receive', Test.ExampleIntegrator.Redeem
    -- and the fee-charging pins ('PublishMessage', 'RegisterEmitter', 'ClaimReplayRoot').
    nonconsuming choice GetGuardianGovernance : Party
      with
        reader : Party
      controller reader
      do pure guardianGovernance

    -- | Charge the governance-set per-publish fee ('messageFee'). Lives here,
    -- not on 'Emitter': the fee amount is only knowable from this contract, and
    -- 'Allocation_ExecuteTransfer' needs the fee recipient's authority (sender ∧
    -- receiver ∧ executor), inherited from @feeRecipient@'s signature on this
    -- contract. Returns guardianGovernance: the caller checks it again after the charge.
    -- Nonconsuming: a governance transition archiving this contract only makes
    -- racing publishes fail activeness transiently — re-resolve and retry.
    nonconsuming choice ChargeMessageFee : Party
      with
        payer         : Party
        feeAllocation : Optional (ContractId Allocation, ExtraArgs)
      controller payer
      do
        let parties = FeeChargeParties with guardianGovernance, feeRecipient, payer
        chargeFee parties feeInstrument messageFee feeAllocation
        pure guardianGovernance

    -- | Charge a caller-specified amount — for the registries' onboarding
    -- fees, whose amounts live on the registry contracts. Same authority and
    -- pin story as 'ChargeMessageFee'.
    nonconsuming choice ChargeFee : Party
      with
        payer         : Party
        fee           : Int  -- 10^-10 feeInstrument units
        feeAllocation : Optional (ContractId Allocation, ExtraArgs)
      controller payer
      do
        let parties = FeeChargeParties with guardianGovernance, feeRecipient, payer
        chargeFee parties feeInstrument fee feeAllocation
        pure guardianGovernance

    -- | Verify a VAA and record its consumption in @consumer@'s @namespace@
    -- replay trie, atomically — integrators (token bridge / NTT) call this in
    -- the same transaction as the action the VAA authorizes. Scoped by
    -- (consumer, namespace): the same VAA can be consumed by different parties
    -- — or the same party under different namespaces — independently.
    --
    -- @replayNodeCid@ is the covering trie node, resolved off-ledger by the
    -- consumer's disclosure service ('Wormhole.Core.Replay'). Soundness is
    -- submitter-independent: the node is fetched and consumed positively, so
    -- every confirmer validates its activeness — a stale or wrong node can only
    -- fail the transaction, never replay. Any submitter with disclosures of this
    -- contract and the covering node gets a correct check.
    nonconsuming choice VerifyAndConsumeVAA : (VAA, ContractId ReplayNode)
      with
        encodedVAA    : EncodedVaa
        pubKeys       : [(Int, GuardianPublicKey)]
        consumer      : Party
        namespace     : Text
        replayNodeCid : ContractId ReplayNode
      controller consumer
      do
        checkVaaSubmissionIsWellFormed encodedVAA pubKeys
        now <- getTime
        vaa <- either assertFail pure (verifyEncoded this encodedVAA pubKeys now)
        node <- fetch replayNodeCid
        -- Exercising ConsumeDigest on a foreign node would fail authorization
        -- anyway; the explicit check gives a clean error. The namespace binding
        -- keeps one consumer's tries mutually isolated (a node from the wrong
        -- trie must fail, not silently consume there). The guardianGovernance
        -- binding rejects a trie that a rogue gg co-signs.
        assertMsg "replay node consumer mismatch" (node.consumer == consumer)
        assertMsg "replay node namespace mismatch" (node.namespace == namespace)
        assertMsg "replay node guardianGovernance mismatch" (node.guardianGovernance == guardianGovernance)
        newNodeCid <- exercise replayNodeCid ConsumeDigest with digest = vaa.hash
        pure (vaa, newNodeCid)

    -- | Apply a governance VAA. Permissionless (EVM Governance.sol parity): the
    -- guardian signatures are the authority. @submitter@ is not an input of the
    -- outcome; a non-stakeholder submitter needs this contract disclosed.
    choice SubmitGovernanceVAA : ContractId CoreState
      with
        submitter  : Party
        encodedVAA : EncodedVaa
        pubKeys    : [(Int, GuardianPublicKey)]
      controller submitter
      do
        checkVaaSubmissionIsWellFormed encodedVAA pubKeys
        createGovernanceOutcome this encodedVAA pubKeys

-- | Choice-entry re-check of VAA arguments from the Ledger API, before any parse.
checkVaaSubmissionIsWellFormed : EncodedVaa -> [(Int, GuardianPublicKey)] -> Update ()
checkVaaSubmissionIsWellFormed encodedVAA pubKeys = do
  assertMsg "encodedVAA is not a well-formed EncodedVaa" (checkHexValueIsWellFormed encodedVAA)
  assertMsg "pubKeys holds a malformed GuardianPublicKey" (all (checkHexValueIsWellFormed . snd) pubKeys)

----------------------------------------------------------------------
-- Governance application (pure helpers in the Either Text monad)
----------------------------------------------------------------------

-- | Dispatch a parsed governance action, recreating 'CoreState'.
applyGovernance : CoreState -> Time -> GovernanceAction -> Either Text CoreState
applyGovernance st now action = case action of
  GuardianSetUpgrade chain newIndex newKeys -> do
    assertMsg "guardianSetUpgrade: wrong target chain" (chain == st.chainId || chain == 0)
    assertMsg "guardianSetUpgrade: index must be current + 1" (newIndex == st.guardianSetIndex + 1)
    checkGuardianAddressesAreWellFormed newKeys
    -- Expire the current set (now + 1 day) in place, then install the new one.
    -- The None case is an invariant violation — a live CoreState always has its
    -- current set.
    let expiry = Some (addRelTime now (seconds guardianSetExpirySeconds))
        expireCurrent mOld = case mOld of
          Some gs -> Some gs with expirationTime = expiry
          None    -> error "no current guardian set"
        newSet = GuardianSet with keys = newKeys, expirationTime = None
    pure st with
      guardianSetIndex = newIndex
      guardianSets = Map.insert newIndex newSet (Map.alter expireCurrent st.guardianSetIndex st.guardianSets)

  SetMessageFee chain fee -> do
    assertMsg "setMessageFee: wrong target chain" (chain == st.chainId)
    pure st with messageFee = fee

  TransferFees chain _amount _recipient -> do
    -- Chain id only: sdk/vaa BodyCoreBridgeTransferFees.Serialize rejects chain 0.
    assertMsg "transferFees: wrong target chain" (chain == st.chainId)
    -- CoreState stays the same: fees settle into feeRecipient's holdings at
    -- charge time. The caller mints the 'FeeWithdrawalAuthorization' and records
    -- the action consumed.
    pure st

  ContractUpgrade chain _newContract -> do
    assertMsg "contractUpgrade: wrong target chain" (chain == st.chainId)
    -- On Canton an "upgrade" is a Daml package upgrade that each guardian
    -- participant vets out of band. The caller records
    -- the action consumed.
    pure st

-- | The 'CoreState' guardian set invariant: the current set exists and never
-- expires, each other set has a lower index and an expiry, and each set passes
-- 'checkGuardianAddressesAreWellFormed'. Each index fits uint32.
checkGuardianSetsAreConsistent : Int -> Map Int GuardianSet -> Bool
checkGuardianSetsAreConsistent currentIndex storedSets =
  checkGuardianSetIndexFitsUint32 currentIndex
    && checkCurrentSetNeverExpires
    && all checkStoredSet (Map.toList storedSets)
  where
    checkCurrentSetNeverExpires = case Map.lookup currentIndex storedSets of
      Some currentSet -> currentSet.expirationTime == None
      None -> False
    checkStoredSet (storedIndex, storedSet) =
      checkGuardianSetIndexFitsUint32 storedIndex
        && storedIndex <= currentIndex
        && (storedIndex == currentIndex || isSome storedSet.expirationTime)
        && isRight (checkGuardianAddressesAreWellFormed storedSet.keys)

-- | Ledger effects of one governance VAA.
data GovernanceOutcome = GovernanceOutcome with
    successor     : CoreState
    feeWithdrawal : Optional FeeWithdrawalAuthorization
  deriving (Eq, Show)

-- | Check a governance VAA against the CURRENT set (EVM Governance.sol), the
-- governance emitter and replay protection, then compute its effects.
governanceOutcomeFor : CoreState -> Time -> EncodedVaa -> [(Int, GuardianPublicKey)] -> Either Text GovernanceOutcome
governanceOutcomeFor before now encodedVAA pubKeys = do
  let vaa = parseVAA encodedVAA
  assertMsg "governance: not signed by current guardian set"
    (vaa.guardianSetIndex == before.guardianSetIndex)
  verifyVAA (currentSetForUpgrade before) vaa pubKeys now
  assertMsg "governance: wrong emitter chain" (vaa.emitterChain == before.governanceChainId)
  assertMsg "governance: wrong emitter address"
    (vaa.emitterAddress == before.governanceContract)
  assertMsg "governance: action already consumed"
    (not (Map.member vaa.hash before.consumedGovernance))
  let action = parseGovernance vaa.payload
      isAboveFloor = checkTimestampIsAboveEvictedGovernanceFloor before.evictedGovernanceMaxTimestampSeconds vaa.timestamp
  -- SECURITY: a GuardianSetUpgrade passes at or below the floor. Its replay
  -- protection is structural: it needs the current-set signature and
  -- newIndex == current + 1, and the index only rises. Otherwise a set N
  -- upgrade below the floor could never apply, and no set N quorum remains to
  -- re-issue it once other chains run set N + 1.
  assertMsg "governance: VAA timestamp at or below the evicted governance timestamp floor"
    (isAboveFloor || isGuardianSetUpgrade action)
  applied <- applyGovernance before now action
  let replayRecord =
        if isAboveFloor
          then recordGovernanceDigest
            before.evictedGovernanceMaxTimestampSeconds before.consumedGovernance vaa.hash vaa.timestamp
          else GovernanceReplayRecord with
            consumedGovernance = before.consumedGovernance
            evictedGovernanceMaxTimestampSeconds = before.evictedGovernanceMaxTimestampSeconds
      successor = applied with
        consumedGovernance = replayRecord.consumedGovernance
        evictedGovernanceMaxTimestampSeconds = replayRecord.evictedGovernanceMaxTimestampSeconds
        guardianSets = pruneStoredGuardianSets now applied.guardianSets
  checkGovernanceKeepsGenesisFields before successor
  checkGovernanceRecordsDigest before successor vaa.hash vaa.timestamp
  checkGovernanceBoundsGuardianSets applied successor now
  pure GovernanceOutcome with
    successor
    -- The artifact the guardians' custody policy honors when it signs the
    -- outbound transfer of the fees in feeRecipient's holdings.
    feeWithdrawal = case action of
      TransferFees _ amount recipient -> Some FeeWithdrawalAuthorization with
        guardianGovernance = before.guardianGovernance
        amount
        recipient
        vaaHash = vaa.hash
      _ -> None

-- | Runs inside the consuming 'SubmitGovernanceVAA': the archived contract's
-- signatories authorize both creates.
createGovernanceOutcome : CoreState -> EncodedVaa -> [(Int, GuardianPublicKey)] -> Update (ContractId CoreState)
createGovernanceOutcome before encodedVAA pubKeys = do
  now <- getTime
  outcome <- either assertFail pure (governanceOutcomeFor before now encodedVAA pubKeys)
  forA_ outcome.feeWithdrawal create
  create outcome.successor

checkGovernanceKeepsGenesisFields : CoreState -> CoreState -> Either Text ()
checkGovernanceKeepsGenesisFields before after = do
  assertMsg "governance: guardianGovernance changed" (after.guardianGovernance == before.guardianGovernance)
  assertMsg "governance: chainId changed" (after.chainId == before.chainId)
  assertMsg "governance: governanceChainId changed" (after.governanceChainId == before.governanceChainId)
  assertMsg "governance: governanceContract changed" (after.governanceContract == before.governanceContract)
  assertMsg "governance: feeInstrument changed" (after.feeInstrument == before.feeInstrument)
  assertMsg "governance: feeRecipient changed" (after.feeRecipient == before.feeRecipient)

-- | The digest map stays within capacity, the floor only rises, each earlier
-- entry stays or falls to the floor, and the consumed VAA is retained or at or
-- below the floor. A VAA at or below the earlier floor (a GuardianSetUpgrade)
-- leaves the map unchanged.
checkGovernanceRecordsDigest : CoreState -> CoreState -> VaaDigest -> Int -> Either Text ()
checkGovernanceRecordsDigest before after digest timestampSeconds = do
  let afterFloor = after.evictedGovernanceMaxTimestampSeconds
      isAboveEarlierFloor =
        checkTimestampIsAboveEvictedGovernanceFloor before.evictedGovernanceMaxTimestampSeconds timestampSeconds
  assertMsg "governance: consumed digest map exceeds its capacity"
    (Map.size after.consumedGovernance <= maxRetainedGovernanceDigests)
  assertMsg "governance: evicted governance timestamp floor decreased"
    (afterFloor >= before.evictedGovernanceMaxTimestampSeconds)
  forA_ (Map.toList before.consumedGovernance) \(retainedDigest, retainedTimestampSeconds) ->
    assertMsg "governance: retained digest dropped above the evicted governance timestamp floor"
      (Map.lookup retainedDigest after.consumedGovernance == Some retainedTimestampSeconds
        || not (checkTimestampIsAboveEvictedGovernanceFloor afterFloor retainedTimestampSeconds))
  forA_ (Map.toList after.consumedGovernance) \(recordedDigest, recordedTimestampSeconds) ->
    assertMsg "governance: consumed digest map gained an entry other than the VAA digest"
      (Map.lookup recordedDigest before.consumedGovernance == Some recordedTimestampSeconds
        || (recordedDigest == digest && recordedTimestampSeconds == timestampSeconds))
  if not isAboveEarlierFloor
    then assertMsg "governance: a VAA at or below the floor must leave the consumed digest map unchanged"
      (after.consumedGovernance == before.consumedGovernance && afterFloor == before.evictedGovernanceMaxTimestampSeconds)
    else when (afterFloor == before.evictedGovernanceMaxTimestampSeconds) do
      assertMsg "governance: consumed digest map must grow by exactly one without an eviction"
        (Map.size after.consumedGovernance == Map.size before.consumedGovernance + 1)
  assertMsg "governance: VAA digest not recorded"
    (Map.lookup digest after.consumedGovernance == Some timestampSeconds
      || not (checkTimestampIsAboveEvictedGovernanceFloor after.evictedGovernanceMaxTimestampSeconds timestampSeconds))

-- | @applied@ is the state before pruning. Each stored set is within
-- capacity, active at @now@ and unchanged from @applied@; each set of
-- @applied@ active at @now@ and among the 'maxStoredGuardianSets' highest
-- indices stays.
checkGovernanceBoundsGuardianSets : CoreState -> CoreState -> Time -> Either Text ()
checkGovernanceBoundsGuardianSets applied after now = do
  assertMsg "governance: stored guardian sets exceed their capacity"
    (Map.size after.guardianSets <= maxStoredGuardianSets)
  forA_ (Map.toList after.guardianSets) \(storedIndex, storedSet) -> do
    assertMsg "governance: stored guardian set expired" (isActiveAt storedSet now)
    assertMsg "governance: stored guardian set not in the applied state"
      (Map.lookup storedIndex applied.guardianSets == Some storedSet)
  let activeAppliedSets = filter (\(_, appliedSet) -> isActiveAt appliedSet now) (Map.toList applied.guardianSets)
      highestActiveAppliedSets = drop (max 0 (length activeAppliedSets - maxStoredGuardianSets)) activeAppliedSets
  forA_ highestActiveAppliedSets \(appliedIndex, appliedSet) ->
    assertMsg "governance: stored guardian set dropped while active and within capacity"
      (Map.lookup appliedIndex after.guardianSets == Some appliedSet)

----------------------------------------------------------------------
-- Collection bounds
----------------------------------------------------------------------

-- | Capacity of 'CoreState.consumedGovernance', about 3 KB. Each publish
-- discloses the 'CoreState', so the size costs every transaction.
maxRetainedGovernanceDigests : Int
maxRetainedGovernanceDigests = 32

-- | sdk/vaa encodes the VAA timestamp as uint32 seconds (@structs.go@).
maxVAATimestampUint32Seconds : Int
maxVAATimestampUint32Seconds = 4294967295

checkTimestampFitsUint32 : Int -> Bool
checkTimestampFitsUint32 timestampSeconds = timestampSeconds >= 0 && timestampSeconds <= maxVAATimestampUint32Seconds

checkTimestampIsAboveEvictedGovernanceFloor : Optional Int -> Int -> Bool
checkTimestampIsAboveEvictedGovernanceFloor evictedMaxTimestampSeconds timestampSeconds =
  case evictedMaxTimestampSeconds of
    None -> True
    Some floorSeconds -> timestampSeconds > floorSeconds

-- | 'CoreState' precondition: capacity, uint32 timestamps, each retained timestamp above the floor.
checkConsumedGovernanceIsBounded : Optional Int -> Map VaaDigest Int -> Bool
checkConsumedGovernanceIsBounded evictedMaxTimestampSeconds consumed =
  Map.size consumed <= maxRetainedGovernanceDigests
    && all checkTimestampFitsUint32 (optionalToList evictedMaxTimestampSeconds)
    && all checkRetainedTimestamp (Map.values consumed)
  where
    checkRetainedTimestamp timestampSeconds =
      checkTimestampFitsUint32 timestampSeconds
        && checkTimestampIsAboveEvictedGovernanceFloor evictedMaxTimestampSeconds timestampSeconds

-- | Governance replay state after one consumed VAA.
data GovernanceReplayRecord = GovernanceReplayRecord with
    consumedGovernance                   : Map VaaDigest Int
    evictedGovernanceMaxTimestampSeconds : Optional Int
  deriving (Eq, Show)

-- | Inserts the digest. Above capacity, evicts each entry at the lowest
-- timestamp and raises the floor to that timestamp.
--
-- SECURITY: each consumed digest stays rejected. It is retained, or its
-- timestamp is at or below the floor, which only rises. The digest commits
-- to the body timestamp but not to the guardian set index, so a copy that a
-- later guardian set signs again keeps the timestamp and fails the floor.
recordGovernanceDigest : Optional Int -> Map VaaDigest Int -> VaaDigest -> Int -> GovernanceReplayRecord
recordGovernanceDigest evictedMaxTimestampSeconds consumed digest timestampSeconds =
  let inserted = Map.insert digest timestampSeconds consumed
  in if Map.size inserted <= maxRetainedGovernanceDigests
       then GovernanceReplayRecord with
         consumedGovernance = inserted
         evictedGovernanceMaxTimestampSeconds = evictedMaxTimestampSeconds
       else
         let oldestTimestampSeconds = minimum (Map.values inserted)
         in GovernanceReplayRecord with
              consumedGovernance = Map.filter (> oldestTimestampSeconds) inserted
              evictedGovernanceMaxTimestampSeconds = Some oldestTimestampSeconds

-- | Governance replay state of a re-genesis 'CoreState' that replaces
-- @earlierRoots@: the highest earlier floor, then each earlier digest above it,
-- inserted in timestamp order through 'recordGovernanceDigest'. A digest at or
-- below the running floor is covered by the floor. Fails on an empty list and on
-- a digest with two timestamps. The result passes 'checkConsumedGovernanceIsBounded'.
tryGovernanceReplayRecordForRegenesis : [CoreState] -> Either Text GovernanceReplayRecord
tryGovernanceReplayRecordForRegenesis earlierRoots = do
  assertMsg "regenesis: no earlier CoreState" (not (null earlierRoots))
  let earlierFloorSeconds = maximum (map (.evictedGovernanceMaxTimestampSeconds) earlierRoots)
      earlierEntries = concatMap (\root -> Map.toList root.consumedGovernance) earlierRoots
      mergeEntry merged (digest, timestampSeconds) = case Map.lookup digest merged of
        Some recordedTimestampSeconds | recordedTimestampSeconds /= timestampSeconds ->
          Left "regenesis: a digest carries two timestamps"
        _ -> Right (Map.insert digest timestampSeconds merged)
  mergedEntries <- foldlA mergeEntry Map.empty earlierEntries
  let entriesByTimestamp = sortOn (\(digest, timestampSeconds) -> (timestampSeconds, digest)) (Map.toList mergedEntries)
      recordEntry record (digest, timestampSeconds) =
        if checkTimestampIsAboveEvictedGovernanceFloor record.evictedGovernanceMaxTimestampSeconds timestampSeconds
          then recordGovernanceDigest record.evictedGovernanceMaxTimestampSeconds record.consumedGovernance digest timestampSeconds
          else record
      replayRecord = foldl recordEntry
        (GovernanceReplayRecord with consumedGovernance = Map.empty, evictedGovernanceMaxTimestampSeconds = earlierFloorSeconds)
        entriesByTimestamp
  assertMsg "regenesis: replay record is not bounded"
    (checkConsumedGovernanceIsBounded replayRecord.evictedGovernanceMaxTimestampSeconds replayRecord.consumedGovernance)
  pure replayRecord

governanceReplayRecordForRegenesis : [CoreState] -> GovernanceReplayRecord
governanceReplayRecordForRegenesis earlierRoots =
  either error identity (tryGovernanceReplayRecordForRegenesis earlierRoots)

-- | Guardian set state of a re-genesis 'CoreState'.
data RegenesisGuardianSets = RegenesisGuardianSets with
    guardianSetIndex : Int
    guardianSets     : Map Int GuardianSet
  deriving (Eq, Show)

-- | The guardian set index and the stored sets of the earlier root with the
-- highest index, unchanged. Fails on an empty list and when two roots store
-- different keys at one index.
tryGuardianSetsForRegenesis : [CoreState] -> Either Text RegenesisGuardianSets
tryGuardianSetsForRegenesis earlierRoots = do
  assertMsg "regenesis: no earlier CoreState" (not (null earlierRoots))
  let storedEntries = concatMap (\root -> Map.toList root.guardianSets) earlierRoots
      mergeKeys merged (storedIndex, storedSet) = case Map.lookup storedIndex merged of
        Some recordedKeys | recordedKeys /= storedSet.keys ->
          Left ("regenesis: earlier roots disagree on the guardian set keys at index " <> show storedIndex)
        _ -> Right (Map.insert storedIndex storedSet.keys merged)
  _ <- foldlA mergeKeys Map.empty storedEntries
  highestRoot <- case earlierRoots of
    firstRoot :: laterRoots -> Right (foldl
      (\highest root -> if root.guardianSetIndex > highest.guardianSetIndex then root else highest)
      firstRoot laterRoots)
    [] -> Left "regenesis: no earlier CoreState"
  pure RegenesisGuardianSets with
    guardianSetIndex = highestRoot.guardianSetIndex
    guardianSets = highestRoot.guardianSets

guardianSetsForRegenesis : [CoreState] -> RegenesisGuardianSets
guardianSetsForRegenesis earlierRoots = either error identity (tryGuardianSetsForRegenesis earlierRoots)

-- | Drops each set not active at @now@, then the lowest indices above 'maxStoredGuardianSets'.
--
-- SECURITY: 'verifyVAA' rejects an inactive set at @now@ and at each later
-- ledger time: a transaction that uses the successor has a ledger time at or
-- after its creation (Daml causal monotonicity). Eviction of an unexpired set
-- only removes signers. The current set has the highest index and no expiry,
-- so it stays.
pruneStoredGuardianSets : Time -> Map Int GuardianSet -> Map Int GuardianSet
pruneStoredGuardianSets now storedSets =
  let activeSets = Map.toList (Map.filter (`isActiveAt` now) storedSets)
      excessSetCount = max 0 (length activeSets - maxStoredGuardianSets)
  in Map.fromList (drop excessSetCount activeSets)

-- | Helper to read the current set off a 'CoreState' value (not a contract).
currentSetForUpgrade : CoreState -> GuardianSet
currentSetForUpgrade st =
  fromSomeNote "no current guardian set" (Map.lookup st.guardianSetIndex st.guardianSets)

-- | On-ledger record of a TransferFees action: the guardians' authorization to
-- move @amount@ of accrued fees to @recipient@. Signed by guardianGovernance,
-- authority inherited from the consumed 'CoreState'. Fees live in
-- feeCustody's holdings, and Canton tokens move only by their owner's
-- signature, so the outbound transfer is a k-of-n guardian ceremony of two
-- prepared transactions: first the archive of this contract (actAs
-- guardianGovernance), then the transfer (actAs feeCustody). The ledger allows
-- one archive, so each authorization backs at most one transfer.
-- @recipient@ is the VAA's 32-byte Wormhole address; mapping it to a Canton
-- receiver is the custody layer's job.
template FeeWithdrawalAuthorization
  with
    guardianGovernance : Party
    amount             : Int               -- 10^-10 feeInstrument units
    recipient          : UniversalAddress  -- Wormhole-format recipient from the VAA
    vaaHash            : VaaDigest         -- provenance: the authorizing VAA's digest
  where
    signatory guardianGovernance
    ensure checkHexValueIsWellFormed recipient && checkHexValueIsWellFormed vaaHash

----------------------------------------------------------------------
-- Emitter registration & message publishing
----------------------------------------------------------------------

-- | Domain-separation tag for emitter addresses. The Go watcher must match this
-- exactly (see node/pkg/watchers/canton/watcher.go @emitterAddressTag@); the
-- encoding is pinned across both languages by a shared test vector.
emitterAddressTag : Text
emitterAddressTag = "wormhole:emitter:v1"

-- | The 32-byte Wormhole emitter address of the 'Emitter' identified by
-- @(registrar, owner, emitterId)@.
emitterAddressFor : Party -> Party -> Int -> EmitterAddress
emitterAddressFor registrar owner emitterId =
  parseHexBytesAsOrAbort (derivedAddress (DomainTag emitterAddressTag) registrar owner (RegistryId emitterId))

-- | Allocates monotonically increasing emitter ids, one registry per
-- guardianGovernance. Created with 'CoreState' in the genesis ceremony.
--
-- SECURITY: guardianGovernance is the sole signatory, so only the guardian
-- threshold can create or archive a registry or lower @nextId@ (A14-3).
template EmitterRegistry
  with
    guardianGovernance : Party  -- signatory; also pinned in RegisterEmitter's
                                -- fee charge
    onboardingFeeAdmin : Party  -- controller of SetRegistrationFee
    registrationFee    : Int    -- onboarding fee, 10^-10 feeInstrument units;
                                -- 0 for free; changed by SetRegistrationFee
    nextId             : Int
  where
    signatory guardianGovernance
    -- @nextId == maxEmitterId + 1@ is an exhausted registry: its next
    -- registration fails on the 'Emitter' ensure.
    ensure nextId >= 0 && nextId <= maxEmitterId + 1
      && registrationFee >= 0 && registrationFee <= maxOnboardingFee

    -- | Re-prices registration and keeps @nextId@ and the admin. The core
    -- governance VAA set (sdk/vaa/payloads.go) has no registration-fee action,
    -- so a delegated admin sets it in 0 .. maxOnboardingFee.
    choice SetRegistrationFee : ContractId EmitterRegistry
      with
        newRegistrationFee : Int
      controller onboardingFeeAdmin
      do
        assertMsg "registration fee must not be negative" (newRegistrationFee >= 0)
        assertMsg "registration fee exceeds maxOnboardingFee" (newRegistrationFee <= maxOnboardingFee)
        successor <- create this with registrationFee = newRegistrationFee
        successorRegistry <- fetch successor
        assertMsg "SetRegistrationFee did not set the fee" (successorRegistry.registrationFee == newRegistrationFee)
        assertMsg "SetRegistrationFee changed nextId" (successorRegistry.nextId == nextId)
        assertMsg "SetRegistrationFee changed the admin" (successorRegistry.onboardingFeeAdmin == onboardingFeeAdmin)
        assertMsg "SetRegistrationFee changed guardianGovernance" (successorRegistry.guardianGovernance == guardianGovernance)
        pure successor

    -- | Emergency ceremony: the core VAA set has no admin action.
    choice ReplaceEmitterRegistryFeeAdmin : ContractId EmitterRegistry
      with
        newOnboardingFeeAdmin : Party
      controller guardianGovernance
      do
        successor <- create this with onboardingFeeAdmin = newOnboardingFeeAdmin
        successorRegistry <- fetch successor
        assertMsg "ReplaceEmitterRegistryFeeAdmin did not set the admin"
          (successorRegistry.onboardingFeeAdmin == newOnboardingFeeAdmin)
        assertMsg "ReplaceEmitterRegistryFeeAdmin changed nextId" (successorRegistry.nextId == nextId)
        assertMsg "ReplaceEmitterRegistryFeeAdmin changed the registration fee"
          (successorRegistry.registrationFee == registrationFee)
        assertMsg "ReplaceEmitterRegistryFeeAdmin changed guardianGovernance"
          (successorRegistry.guardianGovernance == guardianGovernance)
        pure successor

    -- | Direct, requester-submitted registration: allocates the next id and
    -- creates the co-signed 'Emitter' in one transaction — the flexible
    -- controller brings the @requester@'s signature; guardianGovernance's is
    -- inherited from this contract, so guardianGovernance's hosts confirm every
    -- registration. Permissionless
    -- (EVM/Sui parity); the requester needs this registry disclosed (README
    -- §4.7), plus the 'CoreState' disclosure and a fee allocation when
    -- @registrationFee > 0@ (README §4.2).
    -- Consuming, so racing registrations contend here — the loser re-resolves
    -- and retries.
    --
    -- @payer@ funds the registration fee and co-controls, mirroring
    -- 'PublishMessage': a direct registrant is its own payer (@payer =
    -- requester@, controller set collapses), while a delegated registrant
    -- (e.g. NTT's @RegisterManager@, minting on behalf of an admin under
    -- inherited authority) lets the admin fund the fee without the fee
    -- recipient — potentially the registering party itself — being made to
    -- pay for its own onboarding.
    choice RegisterEmitter : (ContractId EmitterRegistry, ContractId Emitter)
      with
        requester     : Party
        payer         : Party  -- funds registrationFee; = requester for a direct registration
        coreStateCid  : Optional (ContractId CoreState)  -- required iff fee > 0
        feeAllocation : Optional (ContractId Allocation, ExtraArgs)
        -- The registration aborts unless this registry's guardianGovernance is
        -- this party (README §4.7).
        expectedGuardianGovernance : Party
      controller requester, payer
      do
        assertMsg "registry guardianGovernance mismatch" (expectedGuardianGovernance == guardianGovernance)
        -- Zero-fee registrations skip the CoreState; fee'd ones charge through
        -- it. The gg pin runs BEFORE the charge and rejects a shadow CoreState
        -- under a rogue gg, so the registration fee cannot be redirected.
        case (registrationFee > 0, coreStateCid) of
          (False, _) -> pure ()
          (True, None) -> abort "registration fee due: pass the CoreState"
          (True, Some csCid) -> do
            csGg <- exercise csCid GetGuardianGovernance with reader = requester
            assertMsg "core state guardianGovernance mismatch" (csGg == guardianGovernance)
            chargedGovernance <- exercise csCid ChargeFee with
              payer
              fee = registrationFee
              feeAllocation
            assertMsg "core state guardianGovernance mismatch after charge" (chargedGovernance == guardianGovernance)
        successorRegistryCid <- create this with nextId = nextId + 1
        emitter <- create Emitter with
          guardianGovernance
          owner = requester
          emitterId = nextId
          emitterAddress = emitterAddressFor guardianGovernance requester nextId
          sequence = 0
        pure (successorRegistryCid, emitter)

-- | Hands out replay-trie roots to any consumer that asks — a stateless anchor
-- whose nonconsuming claim lends guardianGovernance's INHERITED co-signature to
-- consumer-submitted claims (the 'RegisterEmitter' pattern): no contention, and
-- a disclosure blob cacheable until 'SetClaimFee' or 'ReplaceReplayRootRegistryFeeAdmin'
-- replaces it. One per guardianGovernance, created at genesis
-- ('mkInitialReplayRootRegistry'). Lives here rather than in
-- 'Wormhole.Core.Replay' because its claim fee is charged through the 'CoreState'
-- (which references 'ReplayNode' — an import cycle otherwise).
--
-- There is deliberately NO one-root-per-(consumer, namespace) enforcement:
-- maintaining a single trie per scope is the CONSUMER'S responsibility. The
-- controller keeps that sound against everyone else — claiming a root for
-- @consumer@ needs @consumer@'s authority, so nobody can fork another's replay
-- scope (the @namespace@ is a free-form sub-scope UNDER that authority, not a
-- claim anyone else can contest). Parallel roots under one scope can only be
-- minted by the consumer itself, which is self-harm (see
-- 'Wormhole.Core.Replay'). Spam claims cost the spammer per-transaction traffic,
-- the 'claimFee', and the guardian participants ~300 B per worthless root; no
-- shared contract grows.
template ReplayRootRegistry
  with
    guardianGovernance : Party  -- signatory; CoreState authenticity anchor,
                                -- pinned in ClaimReplayRoot's fee charge
    onboardingFeeAdmin : Party  -- controller of SetClaimFee
    claimFee           : Int    -- onboarding fee, 10^-10 feeInstrument units; 0 for free
  where
    signatory guardianGovernance
    ensure claimFee >= 0 && claimFee <= maxOnboardingFee

    choice SetClaimFee : ContractId ReplayRootRegistry
      with
        newClaimFee : Int
      controller onboardingFeeAdmin
      do
        assertMsg "claim fee must not be negative" (newClaimFee >= 0)
        assertMsg "claim fee exceeds maxOnboardingFee" (newClaimFee <= maxOnboardingFee)
        successor <- create this with claimFee = newClaimFee
        successorRegistry <- fetch successor
        assertMsg "SetClaimFee did not set the fee" (successorRegistry.claimFee == newClaimFee)
        assertMsg "SetClaimFee changed the admin" (successorRegistry.onboardingFeeAdmin == onboardingFeeAdmin)
        assertMsg "SetClaimFee changed guardianGovernance" (successorRegistry.guardianGovernance == guardianGovernance)
        pure successor

    -- | Emergency ceremony: the core VAA set has no admin action.
    choice ReplaceReplayRootRegistryFeeAdmin : ContractId ReplayRootRegistry
      with
        newOnboardingFeeAdmin : Party
      controller guardianGovernance
      do
        successor <- create this with onboardingFeeAdmin = newOnboardingFeeAdmin
        successorRegistry <- fetch successor
        assertMsg "ReplaceReplayRootRegistryFeeAdmin did not set the admin"
          (successorRegistry.onboardingFeeAdmin == newOnboardingFeeAdmin)
        assertMsg "ReplaceReplayRootRegistryFeeAdmin changed the claim fee" (successorRegistry.claimFee == claimFee)
        assertMsg "ReplaceReplayRootRegistryFeeAdmin changed guardianGovernance"
          (successorRegistry.guardianGovernance == guardianGovernance)
        pure successor

    -- @payer@ funds the claim fee and co-controls, mirroring
    -- 'PublishMessage'/'RegisterEmitter': a direct claimant is its own payer
    -- (@payer = consumer@, controller set collapses), while a delegated
    -- claimant (e.g. NTT's @RegisterManager@, claiming under gg's inherited
    -- authority) lets the registering admin fund the fee without the
    -- replay-scope owner being made to pay.
    nonconsuming choice ClaimReplayRoot : ContractId ReplayNode
      with
        consumer       : Party
        namespace      : Text -- opaque sub-scope of @consumer@; the trie is
                              -- scoped by (consumer, namespace)
        splitThreshold : Int  -- normally 'defaultSplitThreshold'; tiny in tests
        payer          : Party  -- funds claimFee; = consumer for a direct claim
        coreStateCid   : Optional (ContractId CoreState)  -- required iff fee > 0
        feeAllocation  : Optional (ContractId Allocation, ExtraArgs)
        -- The claim aborts unless this registry's guardianGovernance is this party.
        expectedGuardianGovernance : Party
      controller consumer, payer
      do
        assertMsg "replay root registry guardianGovernance mismatch"
          (expectedGuardianGovernance == guardianGovernance)
        assertMsg "replay namespace must not be empty"
          (T.length namespace >= replayNamespaceMinLength)
        assertMsg "replay namespace exceeds 128 chars"
          (T.length namespace <= replayNamespaceMaxLength)
        -- Zero-fee claims skip the CoreState; fee'd ones charge through it. The
        -- gg pin runs BEFORE the charge and rejects a shadow CoreState under a
        -- rogue gg, so the claim fee cannot be redirected (see README §4.2).
        case (claimFee > 0, coreStateCid) of
          (False, _) -> pure ()
          (True, None) -> abort "claim fee due: pass the CoreState"
          (True, Some csCid) -> do
            csGg <- exercise csCid GetGuardianGovernance with reader = consumer
            assertMsg "core state guardianGovernance mismatch" (csGg == guardianGovernance)
            chargedGovernance <- exercise csCid ChargeFee with
              payer
              fee = claimFee
              feeAllocation
            assertMsg "core state guardianGovernance mismatch after charge" (chargedGovernance == guardianGovernance)
        create ReplayNode with
          consumer
          guardianGovernance
          namespace
          prefix = parseHexTextOrAbort ""
          splitThreshold
          consumed = Set.empty

-- | A registered emitter: the per-emitter sequence counter, identified by
-- @(guardianGovernance, owner, emitterId)@ in its payload. The sequence lives
-- here (not in 'CoreState') so the owner can publish permissionlessly. Mirrors
-- a Sui @EmitterCap@.
template Emitter
  with
    guardianGovernance : Party  -- co-signer and registrar; CoreState
                                -- authenticity anchor, pinned in PublishMessage
    owner              : Party
    emitterId          : Int      -- registry-allocated
    emitterAddress     : EmitterAddress  -- emitterAddressFor guardianGovernance owner emitterId, set at creation
    sequence           : Int      -- next sequence to assign
  where
    -- Owner co-signs: only a transaction with the owner's authority can create a
    -- contract whose derived address is the owner's — the invariant guardians
    -- verify by replay, and Canton's msg.sender analog.
    -- SECURITY: guardianGovernance co-signs, so the owner alone cannot create a
    -- second 'Emitter' of an issued identity outside 'RegisterEmitter' (A14-2).
    -- Every guardian participant hosts guardianGovernance, so guardians are
    -- stakeholders of each PublishMessage; the watcher drops a publish where its
    -- read-as party is not one.
    signatory owner, guardianGovernance
    ensure emitterId >= 0 && emitterId <= maxEmitterId
      && sequence >= 0 && sequence <= maxEmitterSequence
      && checkHexValueIsWellFormed emitterAddress

    -- | Publish a Wormhole message. Returns the sequence-bumped successor
    -- 'Emitter' cid alongside the 'WormholeMessage' the watcher observes
    -- (decoded from @exercise_result@ — a wire contract with the Go watcher;
    -- do not change the 'WormholeMessage' shape), so the caller need not
    -- re-resolve the successor off-ledger. The successor is recreated with
    -- both signatures inherited. Mirrors @Implementation.publishMessage@.
    --
    -- The 'messageFee' is charged through the referenced 'CoreState' (EVM parity:
    -- the current fee is read on every call), whose @guardianGovernance@ is
    -- pinned before and after the charge, so a fake CoreState cannot redirect or waive it.
    -- Publishers attach the CoreState disclosure to every publish (cacheable
    -- between governance actions, which invalidate the cid transiently —
    -- re-resolve and retry); at fee 0 pass @feeAllocation = None@, but the
    -- CoreState reference is still required since the fee amount is only knowable
    -- from it.
    --
    -- @payer@ funds the fee and co-controls the publish. A direct publisher is
    -- its own payer (@payer = owner@, so the controller set collapses to @owner@).
    -- When they differ — an app publishing on a user's behalf, e.g. NTT
    -- 'Wormhole.Ntt.Manager.Transfer' — @payer@'s authority is required because
    -- 'ChargeMessageFee' draws its funds, so it cannot be a non-consenting third
    -- party.
    choice PublishMessage : (ContractId Emitter, WormholeMessage)
      with
        nonce            : Int
        payload          : MessagePayload
        consistencyLevel : Int
        coreStateCid     : ContractId CoreState
        payer            : Party   -- funds 'messageFee'; = owner for a direct publish
        feeAllocation    : Optional (ContractId Allocation, ExtraArgs)
      controller owner, payer
      do
        -- Before the fee charge: a message the watcher drops must not consume
        -- a sequence or a fee.
        assertMsg "payload is not a well-formed MessagePayload" (checkHexValueIsWellFormed payload)
        assertMsg "nonce is negative" (nonce >= 0)
        assertMsg "nonce exceeds uint32" (nonce <= maxNonceUint32)
        assertMsg "consistency level is negative" (consistencyLevel >= 0)
        assertMsg "consistency level exceeds uint8" (consistencyLevel <= maxConsistencyLevelUint8)
        -- Pin the authenticity anchor BEFORE charging: @guardianGovernance@
        -- determines where the fee lands, so this check rejects a shadow
        -- CoreState under a rogue gg before the message fee can be redirected.
        csGg <- exercise coreStateCid GetGuardianGovernance with reader = payer
        assertMsg "core state guardianGovernance mismatch" (csGg == guardianGovernance)
        chargedGovernance <- exercise coreStateCid ChargeMessageFee with
          payer
          feeAllocation
        assertMsg "core state guardianGovernance mismatch after charge" (chargedGovernance == guardianGovernance)
        newEmitterCid <- create this with sequence = sequence + 1
        pure (newEmitterCid, WormholeMessage with
          registrar = guardianGovernance
          owner
          emitterId
          sequence
          nonce
          consistencyLevel
          payload)
