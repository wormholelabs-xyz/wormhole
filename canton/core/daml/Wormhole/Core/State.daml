-- | The core-bridge state singleton, emitter registration, and message
-- publishing. Mirrors @ethereum/contracts/Implementation.sol@ (publishMessage),
-- @State.sol@ (storage), and @Governance.sol@ (governance choices).
--
-- State model: Daml state is the active-contract set, so the "core contract" is
-- a single long-lived 'CoreState' that is archived and recreated on every
-- governance transition.
--
-- SINGLETON / UNIQUENESS: Canton 3.x (the public Canton Network) does NOT
-- support unique contract keys, so uniqueness is NOT enforced by a contract
-- key. Instead it is guaranteed by the @operator@ being the sole creator: only
-- the operator can create a 'CoreState' (it is the signatory), so its
-- controlled automation creates exactly one at setup and advances it linearly by
-- contract-id thereafter. The operator has no power over message contents or
-- governance outcomes (those are gated by VAA verification); it is only the
-- bridge's bookkeeper, so trusting it not to double-issue is acceptable. The
-- guardian watcher and integrators reference the current 'CoreState' / 'Emitter'
-- by contract-id (tracked from the ledger stream), not by key.
--
-- Per-emitter sequence numbers live in each 'Emitter' (not in 'CoreState'), so
-- that publishing is permissionless: the emitter owner can advance its own
-- sequence without the operator's authority, matching EVM where anyone may call
-- @publishMessage@. 'CoreState' holds only the shared config and governance
-- state.
module Wormhole.Core.State where

import DA.Map (Map)
import DA.Map qualified as Map
import DA.Set (Set)
import DA.Set qualified as Set
import DA.Time (addRelTime, seconds)
import Wormhole.Core.Bytes
import Wormhole.Core.GuardianSet
import Wormhole.Core.Governance
import Wormhole.Core.VAA

-- | The message record produced by 'PublishMessage'. This is the wire contract
-- between Daml and the guardian watcher: the watcher reads it from the
-- @ExercisedEvent.exercise_result@ on the Ledger-API stream. Equivalent to the
-- EVM @LogMessagePublished@ event.
--
-- The block-derived 'timestamp' (whitepaper 0001/0004) is supplied by the
-- watcher from the transaction's ledger effective time, NOT from this record, so
-- it is intentionally absent here.
data WormholeMessage = WormholeMessage with
    sender           : Bytes32   -- emitter address
    sequence         : Int       -- uint64
    nonce            : Int       -- uint32
    consistencyLevel : Int       -- uint8
    payload          : Bytes
  deriving (Eq, Show)

-- | Maximum message payload size in bytes (whitepaper 0004).
maxPayloadBytes : Int
maxPayloadBytes = 750

----------------------------------------------------------------------
-- Core state singleton
----------------------------------------------------------------------

template CoreState
  with
    operator           : Party              -- owns/advances the singleton; no power over outcomes
    chainId            : Int                -- 72 (Canton)
    governanceChainId  : Int                -- 1 (Solana)
    governanceContract : Bytes32            -- governance emitter address
    guardianSetIndex   : Int                -- index of the current set
    guardianSets       : Map Int GuardianSet
    messageFee         : Int                -- required fee (native units); 0 in v1
    consumedGovernance : Set Bytes32        -- replay protection, keyed by digest
  where
    signatory operator
    -- No contract key: Canton 3.x has no unique keys (see module header).
    -- Uniqueness is operator-enforced; the current cid is tracked off-ledger.

    -- | Read-only VAA verification, for the token bridge / external verifiers.
    -- Verifies against the CURRENT guardian set. @pubKeys@ are untrusted hints
    -- bound to guardian addresses inside 'verifyVAA'.
    nonconsuming choice ParseAndVerifyVAA : VAA
      with
        encodedVAA : Bytes
        pubKeys    : [(Int, Bytes)]
      controller operator
      do
        now <- getTime
        let vaa = parseVAA encodedVAA
        -- A VAA may be signed by a non-current-but-unexpired set; pick the set
        -- it names and require it to still be active.
        let signingSet = optionOrFail "unknown guardian set index" (Map.lookup vaa.guardianSetIndex guardianSets)
        let () = verifyVAA signingSet vaa pubKeys now
        pure vaa

    -- | Apply a governance VAA: verify it (against the CURRENT set, per EVM),
    -- check the governance emitter and replay protection, then dispatch.
    choice SubmitGovernanceVAA : ContractId CoreState
      with
        encodedVAA : Bytes
        pubKeys    : [(Int, Bytes)]
      controller operator
      do
        now <- getTime
        let vaa = parseVAA encodedVAA
        -- Governance must be signed by the current set (EVM Governance.sol).
        assertMsg "governance: not signed by current guardian set"
          (vaa.guardianSetIndex == guardianSetIndex)
        let () = verifyVAA (currentSetForUpgrade this) vaa pubKeys now
        assertMsg "governance: wrong emitter chain"
          (vaa.emitterChain == governanceChainId)
        assertMsg "governance: wrong emitter address"
          (normalizeHex vaa.emitterAddress == normalizeHex governanceContract)
        assertMsg "governance: action already consumed"
          (not (Set.member vaa.hash consumedGovernance))
        let action = parseGovernance vaa.payload
        let consumed' = Set.insert vaa.hash consumedGovernance
        applyGovernance this now consumed' action

----------------------------------------------------------------------
-- Governance application (pure-ish helpers in the Update monad)
----------------------------------------------------------------------

-- | Dispatch a parsed governance action, recreating 'CoreState'. @consumed'@
-- already includes this action's digest.
applyGovernance : CoreState -> Time -> Set Bytes32 -> GovernanceAction -> Update (ContractId CoreState)
applyGovernance st now consumed' action = case action of
  GuardianSetUpgrade chain newIndex newKeys -> do
    assertMsg "guardianSetUpgrade: wrong target chain" (chain == st.chainId || chain == 0)
    assertMsg "guardianSetUpgrade: index must be current + 1" (newIndex == st.guardianSetIndex + 1)
    assertMsg "guardianSetUpgrade: empty set" (not (null newKeys))
    -- Expire the old current set (now + 1 day) and install the new one.
    let oldSet = (currentSetForUpgrade st) with expirationTime = Some (addRelTime now (seconds guardianSetExpirySeconds))
        newSet = GuardianSet with keys = newKeys, expirationTime = None
        sets' = Map.insert newIndex newSet (Map.insert st.guardianSetIndex oldSet st.guardianSets)
    create st with
      guardianSetIndex = newIndex
      guardianSets = sets'
      consumedGovernance = consumed'

  SetMessageFee chain fee -> do
    assertMsg "setMessageFee: wrong target chain" (chain == st.chainId)
    create st with messageFee = fee, consumedGovernance = consumed'

  TransferFees chain _amount _recipient -> do
    assertMsg "transferFees: wrong target chain" (chain == st.chainId || chain == 0)
    -- Native-fee accounting is deferred (messageFee defaults to 0); record the
    -- action as consumed so replay protection and protocol semantics hold.
    create st with consumedGovernance = consumed'

  ContractUpgrade chain _newContract -> do
    assertMsg "contractUpgrade: wrong target chain" (chain == st.chainId)
    -- On Canton an "upgrade" is an operator-driven Daml package upgrade gated by
    -- the recorded target package-id; here we record the action as consumed.
    -- The actual package migration is performed out of band by the operator.
    create st with consumedGovernance = consumed'

-- | Helper to read the current set off a 'CoreState' value (not a contract).
currentSetForUpgrade : CoreState -> GuardianSet
currentSetForUpgrade st =
  optionOrFail "no current guardian set" (Map.lookup st.guardianSetIndex st.guardianSets)

----------------------------------------------------------------------
-- Emitter registration & message publishing
----------------------------------------------------------------------

-- | A request by @requester@ to be granted an emitter. The operator approves it,
-- assigning the 32-byte @emitterAddress@ (by convention @keccak256(partyId)@,
-- computed off-ledger).
--
-- ADDRESS UNIQUENESS: with no unique contract keys on Canton 3.x, the operator
-- is responsible for not approving two emitters with the same @emitterAddress@
-- (two emitters sharing an address could collide sequences / spoof identity).
-- The operator MUST check its own active 'Emitter' set before approving. This is
-- a security-relevant operator invariant (see module header) and is documented
-- as a validation item in canton/README.md.
template EmitterRequest
  with
    requester : Party
    operator  : Party
  where
    signatory requester
    observer operator

    choice ApproveEmitter : ContractId Emitter
      with emitterAddress : Bytes32
      controller operator
      do
        create Emitter with
          operator
          owner = requester
          emitterAddress = normalizeHex emitterAddress
          sequence = 0

-- | A registered emitter. The per-emitter sequence counter lives here so the
-- owner can publish permissionlessly (without operator authority). Mirrors a
-- Sui @EmitterCap@.
template Emitter
  with
    operator       : Party
    owner          : Party
    emitterAddress : Bytes32
    sequence       : Int      -- next sequence to assign
  where
    signatory operator
    observer owner
    -- No contract key (Canton 3.x); the owner tracks the current cid off-ledger.

    -- | Publish a Wormhole message. The choice result is the 'WormholeMessage'
    -- the watcher observes (decoded directly from @exercise_result@). The
    -- sequence-bumped 'Emitter' is recreated as a side effect; the owner obtains
    -- its new contract-id from the transaction's created events (their app
    -- tracks it from the ledger stream) for the next publish — there is no
    -- contract key to look it up by on Canton 3.x. Mirrors
    -- @Implementation.publishMessage@.
    choice PublishMessage : WormholeMessage
      with
        nonce            : Int
        payload          : Bytes
        consistencyLevel : Int
      controller owner
      do
        assertMsg "payload exceeds 750 bytes" (byteLength payload <= maxPayloadBytes)
        -- NOTE: native-token fee enforcement is deferred (messageFee = 0 in v1);
        -- see README "Open Questions". When wired, the fee is checked here.
        create this with sequence = sequence + 1
        pure WormholeMessage with
          sender = emitterAddress
          sequence
          nonce
          consistencyLevel
          payload
