-- | Governance packet parsing for the core ("Core") module, mirroring
-- @ethereum/contracts/GovernanceStructs.sol@ and whitepapers 0002 / 0004.
--
-- A governance packet is the VAA payload and has the layout:
--
-- >  module(32) ‖ action(1) ‖ chain(2) ‖ <action-specific>
module Wormhole.Core.Governance where

import DA.Text qualified as T
import Wormhole.Core.Bytes

-- | The "Core" module identifier: ASCII "Core" (0x436f7265) left-padded to 32
-- bytes. All core-bridge governance packets carry this value.
coreModule : Bytes32
coreModule = "00000000000000000000000000000000000000000000000000000000436f7265"

-- | A parsed governance action. @RecoverChainId@ (EVM action 5) is intentionally
-- absent — it repairs @block.chainid@ after an EVM fork and has no Canton analog.
data GovernanceAction
  = ContractUpgrade
      with chain : Int; newContract : Bytes32
  | GuardianSetUpgrade
      with chain : Int; newIndex : Int; newKeys : [Bytes20]
  | SetMessageFee
      with chain : Int; fee : Int
  | TransferFees
      with chain : Int; amount : Int; recipient : Bytes32
  deriving (Eq, Show)

-- | Exact packet lengths in bytes, per the guardian serializers in
-- @sdk/vaa/payloads.go@: @BodyContractUpgrade@ (386-399),
-- @BodyGuardianSetUpdate@ (402-418), @BodyCoreBridgeSetMessageFee@ (621-631),
-- @BodyCoreBridgeTransferFees@ (645-671).
contractUpgradePacketBytes : Int
contractUpgradePacketBytes = 67  -- header(35) ‖ newContract(32)

guardianSetUpgradePacketBytes : Int -> Int
guardianSetUpgradePacketBytes keyCount = 40 + 20 * keyCount  -- header(35) ‖ index(4) ‖ count(1) ‖ keys(20 each)

setMessageFeePacketBytes : Int
setMessageFeePacketBytes = 67  -- header(35) ‖ fee(32)

transferFeesPacketBytes : Int
transferFeesPacketBytes = 99  -- header(35) ‖ amount(32) ‖ recipient(32)

-- | @parsedAction@ if @payload@ is exactly @expectedBytes@ bytes; aborts
-- otherwise. Compares hex characters, so an odd trailing nibble also fails.
requirePacketByteLength : Text -> Int -> Bytes -> GovernanceAction -> GovernanceAction
requirePacketByteLength actionName expectedBytes payload parsedAction =
  if T.length payload == expectedBytes * 2
    then parsedAction
    else error ("governance: " <> actionName <> " packet must be " <> show expectedBytes
      <> " bytes, got " <> show (T.length payload) <> " hex chars")

-- | Parse a governance packet. Verifies the module is "Core", dispatches on
-- the action id, and requires the exact packet length of that action. Aborts
-- on unknown actions or malformed input.
parseGovernance : Bytes -> GovernanceAction
parseGovernance payload =
  let
    moduleId = normalizeHex (sliceBytes 0 32 payload)
    action = bytesToInt (sliceBytes 32 1 payload)
    chain = bytesToInt (sliceBytes 33 2 payload)
  in
    if moduleId /= coreModule
      then error "governance: not the Core module"
      else case action of
        1 -> requirePacketByteLength "ContractUpgrade" contractUpgradePacketBytes payload
               ContractUpgrade with
                 chain
                 newContract = normalizeHex (sliceBytes 35 32 payload)
        2 -> let newIndex = bytesToInt (sliceBytes 35 4 payload)
                 keyCount = bytesToInt (sliceBytes 39 1 payload)
             in requirePacketByteLength "GuardianSetUpgrade" (guardianSetUpgradePacketBytes keyCount) payload
                  GuardianSetUpgrade with
                    chain
                    newIndex
                    newKeys = parseKeys payload 40 keyCount
        3 -> requirePacketByteLength "SetMessageFee" setMessageFeePacketBytes payload
               SetMessageFee with
                 chain
                 fee = bytesToInt (sliceBytes 35 32 payload)
        4 -> requirePacketByteLength "TransferFees" transferFeesPacketBytes payload
               TransferFees with
                 chain
                 amount = bytesToInt (sliceBytes 35 32 payload)
                 recipient = normalizeHex (sliceBytes 67 32 payload)
        _ -> error ("governance: unsupported action " <> show action)

-- | Parse @count@ consecutive 20-byte guardian addresses starting at byte
-- @offset@.
parseKeys : Bytes -> Int -> Int -> [Bytes20]
parseKeys payload offset count =
  map (\i -> normalizeHex (sliceBytes (offset + i * 20) 20 payload)) [0 .. count - 1]
