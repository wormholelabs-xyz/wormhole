-- | Fee-payment tests: 'chargeFee' consuming mock CIP-0056 allocations across
-- all three charge points (publish / emitter registration / replay-root
-- claim), the validation matrix, and the custody assertions (fees land in
-- feeRecipient's — guardianGovernance's — holdings; 'TransferFees' mints the
-- withdrawal authorization).
module Test.TestFees where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)
import DA.Text (isInfixOf)
import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Splice.Api.Token.AllocationV1
import Wormhole.Core.Fees (feeToDecimal, emptyExtraArgs)
import Wormhole.Core.Setup
import Wormhole.Core.State
import Test.MockToken
import Test.TestCore (setupWithInstrument, registerEmitter, govSetFeeVAA, devnetGuardianPubKey, devnetGuardian)

-- | Bridge bootstrapped with a mock fee instrument; returns the pieces every
-- fee test needs. The govSetFeeVAA fixture sets messageFee = 1000 (= 1e-7
-- tokens) when submitted.
setupFees : Script (Party, Party, ContractId CoreState, InstrumentId, Party)
setupFees = do
  mockAdmin <- allocateParty "MockAdmin"
  let inst = InstrumentId with admin = mockAdmin, id = "MOCK"
  (operator, _, csId) <- setupWithInstrument (Some inst)
  Some cs <- queryContractId operator csId
  pure (operator, mockAdmin, csId, inst, cs.feeRecipient)

mockFee : Int
mockFee = 1000  -- what govSetFeeVAA sets

-- | The full publish-fee lifecycle: free at fee 0, gated after the
-- governance fee change (with the stale CoreState cid failing on activeness),
-- paid with an exact allocation — which lands whole in the fee recipient's
-- holdings and cannot be spent twice.
testMessageFeeLifecycle : Script ()
testMessageFeeLifecycle = do
  (operator, mockAdmin, csId, inst, feeRecipient) <- setupFees
  alice <- allocateParty "FeeAlice"
  emId <- registerEmitter operator alice
  csDisc0 <- fromSome <$> queryDisclosure operator csId

  -- Fee 0: publishes are free (no allocation).
  pr0 <- submit (actAs alice <> disclose csDisc0) do
    exerciseCmd emId PublishMessage with
      nonce = 1, payload = "aa", consistencyLevel = 0
      coreStateCid = csId, payer = alice, feeAllocation = None
  pr0.message.sequence === 0

  -- Governance raises the fee to 1000.
  csId' <- submit operator do
    exerciseCmd csId SubmitGovernanceVAA with
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  csDisc <- fromSome <$> queryDisclosure operator csId'
  let emId1 = pr0.emitterCid

  -- The stale CoreState cid fails on activeness (retry protocol: re-resolve).
  submitMustFail (actAs alice <> disclose csDisc0) do
    exerciseCmd emId1 PublishMessage with
      nonce = 2, payload = "bb", consistencyLevel = 0
      coreStateCid = csId, payer = alice, feeAllocation = None
  -- Fee due, no allocation: rejected.
  submitMustFail (actAs alice <> disclose csDisc) do
    exerciseCmd emId1 PublishMessage with
      nonce = 2, payload = "bb", consistencyLevel = 0
      coreStateCid = csId', payer = alice, feeAllocation = None

  -- Exact allocation: publish succeeds, WormholeMessage unchanged, the fee
  -- lands whole in feeRecipient's (guardianGovernance's) holdings.
  feePay <- mintAndAllocate mockAdmin alice feeRecipient inst (feeToDecimal mockFee)
  pr1 <- submit (actAs alice <> disclose csDisc) do
    exerciseCmd emId1 PublishMessage with
      nonce = 2, payload = "bb", consistencyLevel = 0
      coreStateCid = csId', payer = alice, feeAllocation = Some feePay
  pr1.message.sequence === 1
  pr1.message.payload === "bb"
  bal <- mockBalance mockAdmin feeRecipient inst
  bal === feeToDecimal mockFee

  -- The allocation is consumed: reusing it fails on activeness.
  let emId2 = pr1.emitterCid
  submitMustFail (actAs alice <> disclose csDisc) do
    exerciseCmd emId2 PublishMessage with
      nonce = 3, payload = "cc", consistencyLevel = 0
      coreStateCid = csId', payer = alice, feeAllocation = Some feePay

-- | Every way an allocation can be wrong, each dying on its own check.
testFeeValidationMatrix : Script ()
testFeeValidationMatrix = do
  (operator, mockAdmin, csId, inst, feeRecipient) <- setupFees
  alice <- allocateParty "MatrixAlice"
  mallory <- allocateParty "MatrixMallory"
  emId <- registerEmitter operator alice
  csId' <- submit operator do
    exerciseCmd csId SubmitGovernanceVAA with
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  csDisc <- fromSome <$> queryDisclosure operator csId'
  now <- getTime
  let publishWith feePay = exerciseCmd emId PublishMessage with
        nonce = 1, payload = "aa", consistencyLevel = 0
        coreStateCid = csId', payer = alice, feeAllocation = Some feePay

  -- Wrong receiver: pays mallory, not the fee recipient.
  wrongReceiver <- mintAndAllocate mockAdmin alice mallory inst (feeToDecimal mockFee)
  submitMustFail (actAs alice <> disclose csDisc) do publishWith wrongReceiver
  -- Wrong instrument id.
  wrongInst <- mintAndAllocate mockAdmin alice feeRecipient
    (InstrumentId with admin = mockAdmin, id = "OTHER") (feeToDecimal mockFee)
  submitMustFail (actAs alice <> disclose csDisc) do publishWith wrongInst
  -- Underpayment by one unit.
  underPay <- mintAndAllocate mockAdmin alice feeRecipient inst (feeToDecimal (mockFee - 1))
  submitMustFail (actAs alice <> disclose csDisc) do publishWith underPay
  -- Honest template, wrong signer: the leg CLAIMS the right instrument, but
  -- the instrument admin never signed — the authenticity pin fires.
  imposter <- allocateParty "ImposterAdmin"
  wrongSigner <- mintAndAllocate imposter alice feeRecipient inst (feeToDecimal mockFee)
  submitMustFail (actAs alice <> disclose csDisc) do publishWith wrongSigner
  -- Hostile template lying in its view: same pin.
  fakeCid <- submit alice do
    createCmd FakeAllocation with
      allocation = mkAllocationSpec alice feeRecipient inst (feeToDecimal mockFee) now
  let fakePay = (toInterfaceContractId @Allocation fakeCid, emptyExtraArgs)
  submitMustFail (actAs alice <> disclose csDisc) do publishWith fakePay
  -- A fabricated fee-0 CoreState cannot waive the fee: the operator pin fires.
  fakeOp <- allocateParty "MatrixFakeOp"
  fakeGov <- allocateParty "MatrixFakeGov"
  fakeObs <- allocateParty "MatrixFakeObs"
  fakeCsId <- submit (actAs fakeOp <> actAs fakeGov) do
    createCmd (mkInitialCoreState fakeOp fakeGov solanaGovernanceChainId
                 defaultGovernanceContract [devnetGuardian] fakeObs inst fakeGov)
  fakeDisc <- fromSome <$> queryDisclosure fakeOp fakeCsId
  submitMustFail (actAs alice <> disclose fakeDisc) do
    exerciseCmd emId PublishMessage with
      nonce = 1, payload = "aa", consistencyLevel = 0
      coreStateCid = fakeCsId, payer = alice, feeAllocation = None

-- | At fee 0 an attached allocation is rejected outright — funds that are not
-- owed are never consumed, and the payer can recover a stranded allocation
-- via Allocation_Withdraw (sender-alone choice).
testNoFeeDueAndRecovery : Script ()
testNoFeeDueAndRecovery = do
  (operator, mockAdmin, csId, inst, feeRecipient) <- setupFees
  alice <- allocateParty "RecoveryAlice"
  emId <- registerEmitter operator alice
  csDisc <- fromSome <$> queryDisclosure operator csId
  feePay@(allocCid, extraArgs) <- mintAndAllocate mockAdmin alice feeRecipient inst 1.0
  submitMustFail (actAs alice <> disclose csDisc) do
    exerciseCmd emId PublishMessage with
      nonce = 1, payload = "aa", consistencyLevel = 0
      coreStateCid = csId, payer = alice, feeAllocation = Some feePay
  -- Recovery: the payer withdraws alone; the funds come back to her.
  _ <- submit alice do exerciseCmd allocCid Allocation_Withdraw with extraArgs
  aliceBal <- mockBalance mockAdmin alice inst
  aliceBal === 1.0

-- | Overpayment transfers the WHOLE leg amount — allocations are
-- all-or-nothing; padding against a fee raise is a tip, not refunded change.
testOverpayTransfersWholeAmount : Script ()
testOverpayTransfersWholeAmount = do
  (operator, mockAdmin, csId, inst, feeRecipient) <- setupFees
  alice <- allocateParty "OverpayAlice"
  emId <- registerEmitter operator alice
  csId' <- submit operator do
    exerciseCmd csId SubmitGovernanceVAA with
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  csDisc <- fromSome <$> queryDisclosure operator csId'
  feePay <- mintAndAllocate mockAdmin alice feeRecipient inst (feeToDecimal (2 * mockFee))
  _ <- submit (actAs alice <> disclose csDisc) do
    exerciseCmd emId PublishMessage with
      nonce = 1, payload = "aa", consistencyLevel = 0
      coreStateCid = csId', payer = alice, feeAllocation = Some feePay
  bal <- mockBalance mockAdmin feeRecipient inst
  bal === feeToDecimal (2 * mockFee)

-- | Onboarding fees: a nonzero-fee 'EmitterRegistry' charges registration
-- through the CoreState (both disclosures attached), and rejects missing
-- CoreState or missing allocation.
testRegistrationFee : Script ()
testRegistrationFee = do
  (operator, mockAdmin, csId, inst, feeRecipient) <- setupFees
  Some cs <- queryContractId operator csId
  bob <- allocateParty "RegFeeBob"
  regCid <- submit operator do
    createCmd (mkInitialEmitterRegistry operator cs.guardianGovernance cs.guardianObserver 500)
  regDisc <- fromSome <$> queryDisclosure operator regCid
  csDisc <- fromSome <$> queryDisclosure operator csId
  -- Fee due: no CoreState / no allocation both rejected.
  submitMustFail (actAs bob <> disclose regDisc) do
    exerciseCmd regCid RegisterEmitter with
      requester = bob, payer = bob, coreStateCid = None, feeAllocation = None
  submitMustFail (actAs bob <> disclose regDisc <> disclose csDisc) do
    exerciseCmd regCid RegisterEmitter with
      requester = bob, payer = bob, coreStateCid = Some csId, feeAllocation = None
  -- Paid registration succeeds; the fee lands with the recipient.
  feePay <- mintAndAllocate mockAdmin bob feeRecipient inst (feeToDecimal 500)
  (regCid', emCid) <- submit (actAs bob <> disclose regDisc <> disclose csDisc) do
    exerciseCmd regCid RegisterEmitter with
      requester = bob, payer = bob, coreStateCid = Some csId, feeAllocation = Some feePay
  Some em <- queryContractId bob emCid
  em.owner === bob
  bal <- mockBalance mockAdmin feeRecipient inst
  bal === feeToDecimal 500

  -- A distinct payer works: the requester and payer need not be the same
  -- party (RegisterManager's use case — the registering admin pays on behalf
  -- of a gg-authority requester). Consuming choice: re-resolve the fresh
  -- registry cid returned above.
  regDisc' <- fromSome <$> queryDisclosure operator regCid'
  dave <- allocateParty "RegFeeDave"
  regPayer <- allocateParty "RegFeeDavePayer"
  payerFeePay <- mintAndAllocate mockAdmin regPayer feeRecipient inst (feeToDecimal 500)
  (_, emCid2) <- submit (actAs dave <> actAs regPayer <> disclose regDisc' <> disclose csDisc) do
    exerciseCmd regCid' RegisterEmitter with
      requester = dave, payer = regPayer, coreStateCid = Some csId, feeAllocation = Some payerFeePay
  Some em2 <- queryContractId dave emCid2
  em2.owner === dave
  bal2 <- mockBalance mockAdmin feeRecipient inst
  bal2 === feeToDecimal 1000

-- | Same for a nonzero-fee 'ReplayRootRegistry' claim.
testClaimFee : Script ()
testClaimFee = do
  (operator, mockAdmin, csId, inst, feeRecipient) <- setupFees
  Some cs <- queryContractId operator csId
  carol <- allocateParty "ClaimFeeCarol"
  regCid <- submit operator do
    createCmd (mkInitialReplayRootRegistry operator cs.guardianGovernance 300)
  regDisc <- fromSome <$> queryDisclosure operator regCid
  csDisc <- fromSome <$> queryDisclosure operator csId
  submitMustFail (actAs carol <> disclose regDisc <> disclose csDisc) do
    exerciseCmd regCid ClaimReplayRoot with
      consumer = carol, namespace = "fees", splitThreshold = 4
      payer = carol, coreStateCid = Some csId, feeAllocation = None
  feePay <- mintAndAllocate mockAdmin carol feeRecipient inst (feeToDecimal 300)
  rootCid <- submit (actAs carol <> disclose regDisc <> disclose csDisc) do
    exerciseCmd regCid ClaimReplayRoot with
      consumer = carol, namespace = "fees", splitThreshold = 4
      payer = carol, coreStateCid = Some csId, feeAllocation = Some feePay
  Some root <- queryContractId carol rootCid
  root.prefix === ""
  bal <- mockBalance mockAdmin feeRecipient inst
  bal === feeToDecimal 300

  -- A distinct payer works: the consumer and payer need not be the same
  -- party (RegisterManager's use case — the registering admin pays on
  -- behalf of gg, the replay-scope consumer).
  dave <- allocateParty "ClaimFeeDave"
  claimPayer <- allocateParty "ClaimFeeDavePayer"
  payerFeePay <- mintAndAllocate mockAdmin claimPayer feeRecipient inst (feeToDecimal 300)
  rootCid2 <- submit (actAs dave <> actAs claimPayer <> disclose regDisc <> disclose csDisc) do
    exerciseCmd regCid ClaimReplayRoot with
      consumer = dave, namespace = "fees", splitThreshold = 4
      payer = claimPayer, coreStateCid = Some csId, feeAllocation = Some payerFeePay
  Some root2 <- queryContractId dave rootCid2
  root2.prefix === ""
  bal2 <- mockBalance mockAdmin feeRecipient inst
  bal2 === feeToDecimal 600

-- | TransferFees mints the on-ledger withdrawal authorization, signed by
-- guardianGovernance — the artifact its custody ceremony matches against.
-- (Requires a TransferFees VAA vector; asserted structurally here by checking
-- none exists after unrelated governance, and covered end-to-end once a
-- vector is generated — see vectorgen. The SetMessageFee action must NOT mint
-- one.)
testNoSpuriousWithdrawalAuthorization : Script ()
testNoSpuriousWithdrawalAuthorization = do
  (operator, _, csId, _, _) <- setupFees
  _ <- submit operator do
    exerciseCmd csId SubmitGovernanceVAA with
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  auths <- query @FeeWithdrawalAuthorization operator
  auths === []

----------------------------------------------------------------------
-- guardianGovernance pin: the shadow-CoreState fee-redirect regression
----------------------------------------------------------------------
--
-- The call sites once pinned only the @operator@ returned by 'ChargeFee' /
-- 'ChargeMessageFee', but @operator@ does NOT determine @feeRecipient@ (that is
-- @guardianGovernance@). A compromised operator can co-sign a second,
-- ledger-valid 'CoreState' under an attacker-controlled gg (= @feeRecipient@) —
-- the operator field still matches, so an operator-only pin lets real fees flow
-- to the attacker. Each call site now pins 'GetGuardianGovernance' against the
-- gg committed on the emitter/registry before charging. Each test builds that
-- forgery (real operator + rogue gg) and asserts the failure carries
-- "guardianGovernance mismatch" — the operator pin would pass, so the substring
-- match proves the fix rather than an incidental failure.

-- | 'PublishMessage' pins the Emitter's guardianGovernance anchor. The forged
-- CoreState even has its (rogue) messageFee raised and a matching allocation
-- attached, so the charge WOULD succeed against @rogueGov@ — the pin rejects it
-- first.
testPublishPinsGuardianGovernance : Script ()
testPublishPinsGuardianGovernance = do
  (operator, mockAdmin, _realCsId, inst, _realRecipient) <- setupFees
  alice <- allocateParty "PinPublishAlice"
  rogueGov <- allocateParty "RoguePublishGov"
  rogueObserver <- allocateParty "RoguePublishObserver"
  emId <- registerEmitter operator alice
  -- The shadow CoreState: co-signed by the REAL operator and a throwaway gg it
  -- controls, with rogueGov as both guardianGovernance and feeRecipient.
  fakeCsId <- submit (actAs operator <> actAs rogueGov) do
    createCmd (mkInitialCoreState operator rogueGov solanaGovernanceChainId
                 defaultGovernanceContract [devnetGuardian] rogueObserver inst rogueGov)
  fakeCsId' <- submit operator do
    exerciseCmd fakeCsId SubmitGovernanceVAA with
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  fakeDisc <- fromSome <$> queryDisclosure operator fakeCsId'
  feePay <- mintAndAllocate mockAdmin alice rogueGov inst (feeToDecimal mockFee)
  res <- trySubmit (actAs alice <> disclose fakeDisc) do
    exerciseCmd emId PublishMessage with
      nonce = 1, payload = "aa", consistencyLevel = 0
      coreStateCid = fakeCsId', payer = alice, feeAllocation = Some feePay
  case res of
    Left (FailureStatusError fs) ->
      assertMsg ("expected a guardianGovernance pin failure, got: " <> fs.message)
        ("guardianGovernance mismatch" `isInfixOf` fs.message)
    Left err -> abort ("expected a guardianGovernance pin failure, got: " <> show err)
    Right _ -> abort "PublishMessage accepted a shadow CoreState under a rogue guardianGovernance"

-- | 'RegisterEmitter' pins the registry's guardianGovernance anchor. The
-- nonzero-fee registry is anchored to the real gg; the forged CoreState routes
-- its @registrationFee@ to @rogueGov@, and a fully-funded allocation is
-- attached — the pin rejects it before the charge.
testRegisterEmitterPinsGuardianGovernance : Script ()
testRegisterEmitterPinsGuardianGovernance = do
  (operator, mockAdmin, realCsId, inst, _realRecipient) <- setupFees
  Some cs <- queryContractId operator realCsId
  bob <- allocateParty "PinRegBob"
  rogueGov <- allocateParty "RogueRegGov"
  rogueObserver <- allocateParty "RogueRegObserver"
  -- A real, nonzero-fee registry pinned to the REAL guardianGovernance.
  regCid <- submit operator do
    createCmd (mkInitialEmitterRegistry operator cs.guardianGovernance cs.guardianObserver 500)
  regDisc <- fromSome <$> queryDisclosure operator regCid
  fakeCsId <- submit (actAs operator <> actAs rogueGov) do
    createCmd (mkInitialCoreState operator rogueGov solanaGovernanceChainId
                 defaultGovernanceContract [devnetGuardian] rogueObserver inst rogueGov)
  fakeDisc <- fromSome <$> queryDisclosure operator fakeCsId
  feePay <- mintAndAllocate mockAdmin bob rogueGov inst (feeToDecimal 500)
  res <- trySubmit (actAs bob <> disclose regDisc <> disclose fakeDisc) do
    exerciseCmd regCid RegisterEmitter with
      requester = bob
      payer = bob
      coreStateCid = Some fakeCsId
      feeAllocation = Some feePay
  case res of
    Left (FailureStatusError fs) ->
      assertMsg ("expected a guardianGovernance pin failure, got: " <> fs.message)
        ("guardianGovernance mismatch" `isInfixOf` fs.message)
    Left err -> abort ("expected a guardianGovernance pin failure, got: " <> show err)
    Right _ -> abort "RegisterEmitter accepted a shadow CoreState under a rogue guardianGovernance"

-- | 'ClaimReplayRoot' pins the registry's guardianGovernance anchor. Same
-- forgery, routing the @claimFee@ to @rogueGov@; the pin rejects it before the
-- charge.
testClaimReplayRootPinsGuardianGovernance : Script ()
testClaimReplayRootPinsGuardianGovernance = do
  (operator, mockAdmin, realCsId, inst, _realRecipient) <- setupFees
  Some cs <- queryContractId operator realCsId
  carol <- allocateParty "PinClaimCarol"
  rogueGov <- allocateParty "RogueClaimGov"
  rogueObserver <- allocateParty "RogueClaimObserver"
  regCid <- submit operator do
    createCmd (mkInitialReplayRootRegistry operator cs.guardianGovernance 300)
  regDisc <- fromSome <$> queryDisclosure operator regCid
  fakeCsId <- submit (actAs operator <> actAs rogueGov) do
    createCmd (mkInitialCoreState operator rogueGov solanaGovernanceChainId
                 defaultGovernanceContract [devnetGuardian] rogueObserver inst rogueGov)
  fakeDisc <- fromSome <$> queryDisclosure operator fakeCsId
  feePay <- mintAndAllocate mockAdmin carol rogueGov inst (feeToDecimal 300)
  res <- trySubmit (actAs carol <> disclose regDisc <> disclose fakeDisc) do
    exerciseCmd regCid ClaimReplayRoot with
      consumer = carol, namespace = "fees", splitThreshold = 4
      payer = carol, coreStateCid = Some fakeCsId, feeAllocation = Some feePay
  case res of
    Left (FailureStatusError fs) ->
      assertMsg ("expected a guardianGovernance pin failure, got: " <> fs.message)
        ("guardianGovernance mismatch" `isInfixOf` fs.message)
    Left err -> abort ("expected a guardianGovernance pin failure, got: " <> show err)
    Right _ -> abort "ClaimReplayRoot accepted a shadow CoreState under a rogue guardianGovernance"
