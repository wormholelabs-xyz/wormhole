-- | TransferFees governance: each accepted VAA creates exactly one
-- 'FeeWithdrawalAuthorization'. Signed VAA literals are generated and
-- drift-guarded by node/pkg/cantonclient/transfer_fees_vectorgen_test.go.
module Test.TestTransferFees where

import Daml.Script
import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Map qualified as Map
import Wormhole.Core.Bytes
import Wormhole.Core.State
import Test.TestCore (govTransferFeesVAA, numberCases, setupWithPartyLabel)
import Test.TestGovernanceBounds (digestOfVAA, readCoreState, timestampOf)
import Test.TestRedTeamCore (checkAttackFailedWith, set0PubKeys, set1PubKeys, submitGovernance, upgradeToSet1)

----------------------------------------------------------------------
-- Generated fixtures (CANTON_VECTORGEN=write rewrites these)
----------------------------------------------------------------------

-- | TransferFees(chain 0, amount 11, recipient d5 x 32), set 0, sequence 201.
tfTransferFeesToAllChains : EncodedVaa
tfTransferFeesToAllChains = parseHexTextOrAbort ""

-- | TransferFees(chain 2, amount 11, recipient d5 x 32), set 0, sequence 202.
tfTransferFeesToEthereum : EncodedVaa
tfTransferFeesToEthereum = parseHexTextOrAbort ""

-- | TransferFees(chain 75, amount 0, recipient d5 x 32), set 0, sequence 203.
tfTransferFeesAmountZero : EncodedVaa
tfTransferFeesAmountZero = parseHexTextOrAbort ""

-- | TransferFees(chain 75, amount 2^63 - 1, recipient d5 x 32), set 0, sequence 204.
tfTransferFeesAmountMaxInt64 : EncodedVaa
tfTransferFeesAmountMaxInt64 = parseHexTextOrAbort ""

-- | TransferFees(chain 75, amount 2^63, recipient d5 x 32), set 0, sequence 205.
tfTransferFeesAmountTwoPow63 : EncodedVaa
tfTransferFeesAmountTwoPow63 = parseHexTextOrAbort ""

-- | TransferFees(chain 75, amount 2^256 - 1, recipient d5 x 32), set 0, sequence 206.
tfTransferFeesAmountMaxUint256 : EncodedVaa
tfTransferFeesAmountMaxUint256 = parseHexTextOrAbort ""

-- | Body of 'govTransferFeesVAA', signed by devnet keys 0, 1 and 2 under set 1.
tfTransferFeesResignedBySet1 : EncodedVaa
tfTransferFeesResignedBySet1 = parseHexTextOrAbort ""

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

govTransferFeesRecipient : UniversalAddress
govTransferFeesRecipient = parseHexTextOrAbort (mconcat (replicate 32 "d4"))

govTransferFeesAmount : Int
govTransferFeesAmount = 9

vectorRecipient : UniversalAddress
vectorRecipient = parseHexTextOrAbort (mconcat (replicate 32 "d5"))

vectorAmount : Int
vectorAmount = 11

maxInt64 : Int
maxInt64 = 9223372036854775807

transferFeesErrorWrongTargetChain : Text
transferFeesErrorWrongTargetChain = "transferFees: wrong target chain"

governanceErrorActionAlreadyConsumed : Text
governanceErrorActionAlreadyConsumed = "action already consumed"

-- | Daml Int arithmetic overflow in 'bytesToInt'.
arithmeticOverflowErrorText : Text
arithmeticOverflowErrorText = "ArithmeticError"

readWithdrawalAuthorizations : Party -> Script [FeeWithdrawalAuthorization]
readWithdrawalAuthorizations guardianGovernance =
  map snd <$> query @FeeWithdrawalAuthorization guardianGovernance

checkHasExactlyOneWithdrawalAuthorization : Text -> Party -> FeeWithdrawalAuthorization -> Script ()
checkHasExactlyOneWithdrawalAuthorization caseName guardianGovernance expectedAuthorization = do
  authorizations <- readWithdrawalAuthorizations guardianGovernance
  assertMsg (caseName <> ": expected one authorization, got " <> show authorizations)
    (authorizations == [expectedAuthorization])

expectedAuthorizationFor : Party -> Int -> UniversalAddress -> EncodedVaa -> FeeWithdrawalAuthorization
expectedAuthorizationFor guardianGovernance amount recipient encodedVAA =
  FeeWithdrawalAuthorization with
    guardianGovernance
    amount
    recipient
    vaaHash = digestOfVAA encodedVAA

----------------------------------------------------------------------
-- 1. Accepted actions
----------------------------------------------------------------------

data AcceptedTransferFeesCase = AcceptedTransferFeesCase with
    caseName          : Text
    encodedVAA        : EncodedVaa
    expectedAmount    : Int
    expectedRecipient : UniversalAddress

-- | One authorization with the VAA amount, recipient and digest. 'CoreState' changes only by the recorded digest.
testTransferFeesCreatesOneWithdrawalAuthorization : Script ()
testTransferFeesCreatesOneWithdrawalAuthorization = do
  let cases =
        [ AcceptedTransferFeesCase "chain 75" govTransferFeesVAA govTransferFeesAmount govTransferFeesRecipient
        , AcceptedTransferFeesCase "chain 0" tfTransferFeesToAllChains vectorAmount vectorRecipient
        , AcceptedTransferFeesCase "amount 0" tfTransferFeesAmountZero 0 vectorRecipient
        , AcceptedTransferFeesCase "amount 2^63 - 1" tfTransferFeesAmountMaxInt64 maxInt64 vectorRecipient
        ]
  forA_ (numberCases cases) \(caseNumber, acceptedCase) -> do
    (guardianGovernance, coreStateCid) <- setupWithPartyLabel ("TransferFeesAccepted" <> show caseNumber) None
    before <- readCoreState guardianGovernance coreStateCid
    readWithdrawalAuthorizations guardianGovernance >>= (=== [])
    successorCid <- submitGovernance guardianGovernance coreStateCid acceptedCase.encodedVAA set0PubKeys
    successor <- readCoreState guardianGovernance successorCid
    successor === before with
      consumedGovernance = Map.fromList [(digestOfVAA acceptedCase.encodedVAA, timestampOf acceptedCase.encodedVAA)]
    checkHasExactlyOneWithdrawalAuthorization acceptedCase.caseName guardianGovernance
      (expectedAuthorizationFor guardianGovernance acceptedCase.expectedAmount acceptedCase.expectedRecipient acceptedCase.encodedVAA)

----------------------------------------------------------------------
-- 2. Rejected actions
----------------------------------------------------------------------

-- | A wrong target chain or an amount above Int max aborts; 'CoreState' stays
-- active and unchanged, and the authorization list stays empty.
testTransferFeesRejectedLeavesNoWithdrawalAuthorization : Script ()
testTransferFeesRejectedLeavesNoWithdrawalAuthorization = do
  let cases =
        [ ("chain 2", transferFeesErrorWrongTargetChain, tfTransferFeesToEthereum)
        , ("amount 2^63", arithmeticOverflowErrorText, tfTransferFeesAmountTwoPow63)
        , ("amount 2^256 - 1", arithmeticOverflowErrorText, tfTransferFeesAmountMaxUint256)
        ]
  forA_ (numberCases cases) \(caseNumber, (caseName, expectedErrorText, encodedVAA)) -> do
    (guardianGovernance, coreStateCid) <- setupWithPartyLabel ("TransferFeesRejected" <> show caseNumber) None
    before <- readCoreState guardianGovernance coreStateCid
    submitResult <- trySubmit guardianGovernance do
      exerciseCmd coreStateCid SubmitGovernanceVAA with
        submitter = guardianGovernance, encodedVAA, pubKeys = set0PubKeys
    checkAttackFailedWith caseName expectedErrorText submitResult
    after <- readCoreState guardianGovernance coreStateCid
    after === before
    readWithdrawalAuthorizations guardianGovernance >>= (=== [])

----------------------------------------------------------------------
-- 3. Replay
----------------------------------------------------------------------

-- | After 'govTransferFeesVAA' applies, each copy with its digest fails and
-- the single authorization stays.
testTransferFeesReplayRejected : Script ()
testTransferFeesReplayRejected = do
  (guardianGovernance, coreStateCid) <- setupWithPartyLabel "TransferFeesReplay" None
  transferredCid <- submitGovernance guardianGovernance coreStateCid govTransferFeesVAA set0PubKeys
  let expectedAuthorization =
        expectedAuthorizationFor guardianGovernance govTransferFeesAmount govTransferFeesRecipient govTransferFeesVAA
  replayResult <- trySubmit guardianGovernance do
    exerciseCmd transferredCid SubmitGovernanceVAA with
      submitter = guardianGovernance, encodedVAA = govTransferFeesVAA, pubKeys = set0PubKeys
  checkAttackFailedWith "same VAA" governanceErrorActionAlreadyConsumed replayResult
  checkHasExactlyOneWithdrawalAuthorization "same VAA" guardianGovernance expectedAuthorization

  set1CoreStateCid <- upgradeToSet1 guardianGovernance transferredCid
  digestOfVAA tfTransferFeesResignedBySet1 === digestOfVAA govTransferFeesVAA
  resignedResult <- trySubmit guardianGovernance do
    exerciseCmd set1CoreStateCid SubmitGovernanceVAA with
      submitter = guardianGovernance, encodedVAA = tfTransferFeesResignedBySet1, pubKeys = set1PubKeys
  checkAttackFailedWith "re-signed by set 1" governanceErrorActionAlreadyConsumed resignedResult
  checkHasExactlyOneWithdrawalAuthorization "re-signed by set 1" guardianGovernance expectedAuthorization

-- | Control for the re-signed case: without the earlier submission, set 1's
-- copy applies and carries the original digest.
testTransferFeesResignedBySet1AppliesOnFreshState : Script ()
testTransferFeesResignedBySet1AppliesOnFreshState = do
  (guardianGovernance, coreStateCid) <- setupWithPartyLabel "TransferFeesResigned" None
  set1CoreStateCid <- upgradeToSet1 guardianGovernance coreStateCid
  _ <- submitGovernance guardianGovernance set1CoreStateCid tfTransferFeesResignedBySet1 set1PubKeys
  checkHasExactlyOneWithdrawalAuthorization "re-signed by set 1 on a fresh state" guardianGovernance
    (expectedAuthorizationFor guardianGovernance govTransferFeesAmount govTransferFeesRecipient govTransferFeesVAA)
