-- | Daml Script tests for the NTT package: the wire codec, permissionless
-- deployment, the outbound send path (publishes via the core Emitter), and the
-- inbound receive path (verifies a real guardian-signed VAA, enforces the peer,
-- mints via the token seam, and rejects replays).
--
-- 'MockToken' is a minimal CIP-56-shaped implementation of the 'NttToken' seam
-- (stdlib only) so the whole protocol is exercised without the real
-- token-standard DARs. The receive VAA fixture is generated by
-- node/pkg/cantonclient/vectorgen_test.go (TestGenerateNttVector).
module Test.TestNtt where

import Daml.Script
import DA.Assert ((===))

import Wormhole.Core.Bytes
import Wormhole.Core.State (Emitter)
import Wormhole.Ntt.Payload
import Wormhole.Ntt.Token
import Wormhole.Ntt.Manager
import Test.TestCore (setup, registerEmitter, devnetGuardianPubKey)

----------------------------------------------------------------------
-- MockToken: a CIP-56-shaped NttToken for tests
----------------------------------------------------------------------

-- | A minted/custodied balance. In lock/unlock the manager mints to itself
-- (custody); in burn/mint it mints to the recipient. Enough to assert effects.
template MockHolding
  with
    admin  : Party
    owner  : Party
    amount : Int
  where
    signatory admin
    observer owner

-- | The token hook. Signed by the token @admin@ (so its authority backs the
-- holdings created below) and observed by the @manager@ (the NTT operator that
-- drives it).
template MockToken
  with
    admin   : Party
    manager : Party
    mode    : TokenMode
  where
    signatory admin
    observer manager

    interface instance NttToken for MockToken where
      view = NttTokenView with admin, manager, mode
      -- The mock ignores the CIP-56 handles (holdings / registry context); a real
      -- token uses them (see ntt-cip56/TokenCip56).
      lockOrBurnImpl _sender amt _inputHoldingCids _extraArgs = do
        -- lock into custody (owner = admin) / burn is modelled the same way here
        create MockHolding with admin, owner = admin, amount = amt.amount
        pure ()
      mintOrUnlockImpl recipient amt _inputHoldingCids _extraArgs = do
        create MockHolding with admin, owner = recipient, amount = amt.amount
        pure ()

-- | 32-byte hex from a short tail (e.g. @b32 "aa"@ = 0x00..aa), matching the
-- addresses baked into the VAA fixture.
b32 : Text -> Bytes32
b32 = leftPadTo 32

----------------------------------------------------------------------
-- Codec round-trips
----------------------------------------------------------------------

testNttCodec : Script ()
testNttCodec = do
  let ntt = NativeTokenTransfer with
        decimals = 8
        amount = 1000000
        sourceToken = b32 "dd"
        recipientAddress = b32 "ee"
        recipientChain = 72
        additionalPayload = ""
  decodeNativeTokenTransfer (encodeNativeTokenTransfer ntt) === ntt

  let mm = NttManagerMessage with
        id = b32 "01"
        sender = b32 "bb"
        payload = encodeNativeTokenTransfer ntt
  decodeNttManagerMessage (encodeNttManagerMessage mm) === mm

  let wm = WormholeTransceiverMessage with
        sourceManager = b32 "bb"
        recipientManager = b32 "aa"
        managerPayload = encodeNttManagerMessage mm
        transceiverPayload = ""
  decodeWormholeTransceiverMessage (encodeWormholeTransceiverMessage wm) === wm

  -- TrimmedAmount: an 18-decimal amount trims to 8 decimals (drops the low 10
  -- digits as dust); rescaling back recovers everything but that lost dust.
  let t = trimAmount 1234567890123456789 18
  t.decimals === 8
  t.amount === 123456789
  untrimAmount t 18 === 1234567890000000000
  pure ()

----------------------------------------------------------------------
-- Deployment
----------------------------------------------------------------------

-- | Register a core Emitter for @admin@, create a MockToken, and stand up an NTT
-- deployment via request -> operator approve. Returns the pieces the send/receive
-- tests need.
deploy : Party -> Party -> TokenMode -> Bytes32
      -> Script (ContractId NttManager, ContractId Emitter)
deploy operator admin mode managerAddress = do
  emitterId <- registerEmitter operator admin
  Some em <- queryContractId admin emitterId
  mockCid <- submit admin do createCmd MockToken with admin, manager = operator, mode
  let tokenCid = toInterfaceContractId @NttToken mockCid
  reqId <- submit admin do
    createCmd NttDeploymentRequest with
      admin
      operator
      transceiverIdentity = em.identity
      tokenCid
      mode
      tokenDecimals = 8
  mgrId <- submit operator do exerciseCmd reqId ApproveDeployment with managerAddress
  pure (mgrId, emitterId)

-- | Two deployments get distinct, independent manager contracts/identities.
testNttDeployment : Script ()
testNttDeployment = do
  (operator, _) <- setup
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  (mgrA, _) <- deploy operator alice LockUnlock (b32 "a1")
  (mgrB, _) <- deploy operator bob BurnMint (b32 "b1")
  Some ma <- queryContractId operator mgrA
  Some mb <- queryContractId operator mgrB
  ma.managerAddress === b32 "a1"
  mb.managerAddress === b32 "b1"
  (ma.identity == mb.identity) === False
  pure ()

----------------------------------------------------------------------
-- Send
----------------------------------------------------------------------

testNttSend : Script ()
testNttSend = do
  (operator, _) <- setup
  alice <- allocateParty "SendAlice"
  (mgrId, emitterId) <- deploy operator alice LockUnlock (b32 "a1")

  -- Configure the destination peer (chain 2).
  mgrId <- submit alice do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"

  newMgr <- submit alice do
    exerciseCmd mgrId Transfer with
      emitterCid = emitterId
      recipientChain = 2
      recipientAddress = b32 "ee"
      sourceToken = b32 "dd"
      rawAmount = 1000000
      nonce = 7
      consistencyLevel = 0
      inputHoldingCids = []
      extraArgs = emptyExtraArgs

  -- Outbound sequence advanced, the core Emitter published (sequence bumped),
  -- and the token was locked into custody.
  Some m <- queryContractId operator newMgr
  m.outboundSequence === 1
  [(_, em)] <- query @Emitter alice
  em.sequence === 1
  [(_, h)] <- query @MockHolding alice
  h.owner === alice
  h.amount === 1000000
  pure ()

----------------------------------------------------------------------
-- Receive (+ replay protection)
----------------------------------------------------------------------

-- Signed NTT transfer VAA (guardian set 0, devnet guardian): source chain 2,
-- emitter (peer transceiver) 0x..cc, peer manager 0x..bb, our manager 0x..aa,
-- transfer of 1_000_000 @ 8 decimals of token 0x..dd to 0x..ee on chain 72.
-- Generated by node/pkg/cantonclient/vectorgen_test.go:TestGenerateNttVector.
nttTransferVAA : Bytes
nttTransferVAA = ""

testNttReceive : Script ()
testNttReceive = do
  (operator, csId) <- setup
  admin <- allocateParty "RecvAdmin"
  recipient <- allocateParty "Recipient"
  -- Our manager address must match the VAA's recipientManager (0x..aa).
  (mgrId, _) <- deploy operator admin BurnMint (b32 "aa")
  mgrId <- submit admin do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"

  ntt <- submit operator do
    exerciseCmd mgrId Receive with
      coreStateCid = csId
      vaaBytes = nttTransferVAA
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient
      inputHoldingCids = []
      extraArgs = emptyExtraArgs

  -- The decoded transfer matches the fixture.
  ntt.decimals === 8
  ntt.amount === 1000000
  ntt.recipientChain === 72
  ntt.sourceToken === b32 "dd"
  ntt.recipientAddress === b32 "ee"

  -- The token was minted to the recipient.
  [(_, h)] <- query @MockHolding admin
  h.owner === recipient
  h.amount === 1000000

  -- Replaying the same VAA is rejected.
  [(mgr2, _)] <- query @NttManager admin
  submitMustFail operator do
    exerciseCmd mgr2 Receive with
      coreStateCid = csId
      vaaBytes = nttTransferVAA
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  pure ()
