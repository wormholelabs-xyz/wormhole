-- | Daml Script tests for the NTT package: the wire codec, permissionless
-- deployment, the outbound send path (publishes via the core Emitter), and the
-- inbound receive path (verifies a real guardian-signed VAA, enforces the peer,
-- binds the recipient to the VAA's own recipientAddress, mints via the token
-- seam, and rejects replays).
--
-- 'MockToken' is a minimal CIP-56-shaped implementation of the 'NttToken' seam
-- (stdlib only) so the whole protocol is exercised without the real
-- token-standard DARs. The receive VAA fixture is generated by
-- node/pkg/cantonclient/vectorgen_test.go (TestGenerateNttVector).
module Test.TestNtt where

import Daml.Script
import DA.Assert ((===))
import DA.Map qualified as Map
import DA.Set qualified as Set
import DA.Text (isInfixOf)

import Wormhole.Core.Bytes
import Wormhole.Core.Setup (mkInitialCoreState, solanaGovernanceChainId, defaultGovernanceContract)
import Wormhole.Core.State (Emitter, CoreState, emitterAddressTag)
import Wormhole.Ntt.Payload
import Wormhole.Ntt.Token
import Wormhole.Ntt.Manager
import Test.TestCore (setup, registerEmitter, devnetGuardianPubKey)

----------------------------------------------------------------------
-- MockToken: a CIP-56-shaped NttToken for tests
----------------------------------------------------------------------

-- | A minted/custodied balance. In lock/unlock the manager mints to itself
-- (custody); in burn/mint it mints to the recipient. Enough to assert effects.
template MockHolding
  with
    admin  : Party
    owner  : Party
    amount : Int
  where
    signatory admin
    observer owner

-- | The token hook. Signed by the token @admin@ (so its authority backs the
-- holdings created below) and observed by the @manager@ (the NTT operator that
-- drives it).
template MockToken
  with
    admin   : Party
    manager : Party
    mode    : TokenMode
  where
    signatory admin
    observer manager

    interface instance NttToken for MockToken where
      view = NttTokenView with admin, manager, mode
      -- The mock ignores the CIP-56 handles (holdings / registry context); a real
      -- token uses them (see ntt-cip56/TokenCip56).
      lockOrBurnImpl _sender amt _inputHoldingCids _extraArgs = do
        -- lock into custody (owner = admin) / burn is modelled the same way here
        create MockHolding with admin, owner = admin, amount = amt.amount
        pure ()
      mintOrUnlockImpl recipient amt _inputHoldingCids _extraArgs = do
        create MockHolding with admin, owner = recipient, amount = amt.amount
        pure ()

-- | 32-byte hex from a short tail (e.g. @b32 "aa"@ = 0x00..aa), matching the
-- addresses baked into the VAA fixture.
b32 : Text -> Bytes32
b32 = leftPadTo 32

----------------------------------------------------------------------
-- Codec round-trips
----------------------------------------------------------------------

testNttCodec : Script ()
testNttCodec = do
  let ntt = NativeTokenTransfer with
        decimals = 8
        amount = 1000000
        sourceToken = b32 "dd"
        recipientAddress = b32 "ee"
        recipientChain = 72
        additionalPayload = ""
  decodeNativeTokenTransfer (encodeNativeTokenTransfer ntt) === ntt

  let mm = NttManagerMessage with
        id = b32 "01"
        sender = b32 "bb"
        payload = encodeNativeTokenTransfer ntt
  decodeNttManagerMessage (encodeNttManagerMessage mm) === mm

  let wm = WormholeTransceiverMessage with
        sourceManager = b32 "bb"
        recipientManager = b32 "aa"
        managerPayload = encodeNttManagerMessage mm
        transceiverPayload = ""
  decodeWormholeTransceiverMessage (encodeWormholeTransceiverMessage wm) === wm

  -- TrimmedAmount: an 18-decimal amount trims to 8 decimals (drops the low 10
  -- digits as dust); rescaling back recovers everything but that lost dust.
  let t = trimAmount 1234567890123456789 18
  t.decimals === 8
  t.amount === 123456789
  untrimAmount t 18 === 1234567890000000000
  pure ()

----------------------------------------------------------------------
-- Deployment
----------------------------------------------------------------------

-- | Bootstrap the core 'CoreState' + 'EmitterRegistry' (via 'setup') plus the NTT
-- 'NttManagerRegistry'. All deployments in a test share the one manager registry.
-- Also surfaces the @guardianGovernance@ party (read off the created 'CoreState')
-- — the guardian trust anchor a deployment pins at request time.
nttSetup : Script (Party, Party, ContractId CoreState)
nttSetup = do
  (operator, _, csId) <- setup
  _ <- submit operator do createCmd NttManagerRegistry with operator, nextId = 0
  Some cs <- queryContractId operator csId
  pure (operator, cs.guardianGovernance, csId)

-- | Register a core Emitter for @admin@, create a MockToken, and stand up an NTT
-- deployment via request -> operator approve. The manager address is derived
-- on-ledger at approval (no operator-supplied hash). Returns the pieces the
-- send/receive tests need.
deploy : Party -> Party -> Party -> TokenMode
      -> Script (ContractId NttManager, ContractId Emitter)
deploy operator guardianGovernance admin mode = do
  emitterCid <- registerEmitter operator admin
  Some em <- queryContractId admin emitterCid
  mockCid <- submit admin do createCmd MockToken with admin, manager = operator, mode
  let tokenCid = toInterfaceContractId @NttToken mockCid
  reqId <- submit admin do
    createCmd NttDeploymentRequest with
      admin
      operator
      guardianGovernance
      transceiverRegistrar = em.operator
      transceiverEmitterId = em.emitterId
      tokenCid
      mode
      tokenDecimals = 8
  mgrId <- submit operator do exerciseCmd reqId ApproveDeployment
  pure (mgrId, emitterCid)

-- | Two deployments get distinct, independent manager contracts with sequential
-- ids and on-ledger-derived, owner-bound addresses.
testNttDeployment : Script ()
testNttDeployment = do
  (operator, guardianGovernance, _) <- nttSetup
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  (mgrA, _) <- deploy operator guardianGovernance alice LockUnlock
  (mgrB, _) <- deploy operator guardianGovernance bob BurnMint
  Some ma <- queryContractId operator mgrA
  Some mb <- queryContractId operator mgrB
  ma.managerId === 0
  mb.managerId === 1
  ma.managerAddress === nttManagerAddressFor operator alice 0
  mb.managerAddress === nttManagerAddressFor operator bob 1
  assert (ma.managerAddress /= mb.managerAddress)

  -- Pin the manager-address encoding against the cross-language vector, and
  -- confirm the emitter/manager domain tags separate identical key ordinals.
  derivedAddressFromText (DomainTag nttManagerAddressTag) (RegistrarText "vector-operator::1220deadbeef") (OwnerText "vector-owner::1220cafebabe") (RegistryId 7)
    === "27d9c172814411dbdacf4842ae5de98cf78ce21e77def6f76f0f75387a28c93b"
  assert (derivedAddressFromText (DomainTag emitterAddressTag) (RegistrarText "p::1") (OwnerText "q::2") (RegistryId 0)
            /= derivedAddressFromText (DomainTag nttManagerAddressTag) (RegistrarText "p::1") (OwnerText "q::2") (RegistryId 0))

----------------------------------------------------------------------
-- Send
----------------------------------------------------------------------

testNttSend : Script ()
testNttSend = do
  (operator, guardianGovernance, _) <- nttSetup
  alice <- allocateParty "SendAlice"
  (mgrId, _) <- deploy operator guardianGovernance alice LockUnlock

  -- Configure the destination peer (chain 2).
  _ <- submit alice do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"

  -- Transfer by the manager's stable key (no cid tracking; the transceiver
  -- Emitter is resolved by key inside the choice).
  let doTransfer nonce = submit alice do
        exerciseByKeyCmd @NttManager (operator, alice, 0) Transfer with
          user = alice
          recipientChain = 2
          recipientAddress = b32 "ee"
          sourceToken = b32 "dd"
          rawAmount = 1000000
          nonce
          consistencyLevel = 0
          inputHoldingCids = []
          extraArgs = emptyExtraArgs
  _ <- doTransfer 7

  -- Outbound sequence advanced, the core Emitter published (sequence bumped),
  -- and the token was locked into custody.
  Some (_, m1) <- queryByKey @NttManager operator (operator, alice, 0)
  m1.outboundSequence === 1
  [(_, em)] <- query @Emitter alice
  em.sequence === 1
  [(_, h)] <- query @MockHolding alice
  h.owner === alice
  h.amount === 1000000

  -- A second transfer by the same key succeeds — the manager (and its transceiver)
  -- churn their cids but keep their keys.
  _ <- doTransfer 8
  Some (_, m2) <- queryByKey @NttManager operator (operator, alice, 0)
  m2.outboundSequence === 2
  pure ()

----------------------------------------------------------------------
-- Receive (+ replay protection)
----------------------------------------------------------------------

-- Signed NTT transfer VAA (guardian set 0, devnet guardian): source chain 2,
-- emitter (peer transceiver) 0x..cc, peer manager 0x..bb, our manager 0x..aa,
-- transfer of 1_000_000 @ 8 decimals of token 0x..dd to 0x..ee on chain 72.
-- Generated by node/pkg/cantonclient/vectorgen_test.go:TestGenerateNttVector.
nttTransferVAA : Bytes
nttTransferVAA = ""

-- | Pins the recipient-binding formula against fixed, non-Party text -- a live
-- Party's fingerprint is nondeterministic (freshly allocated each run) and
-- cannot be pinned into a constant, unlike the string literals here. Same
-- style as testNttDeployment's nttManagerAddressFor vector; Go side in
-- node/pkg/cantonclient/vectorgen_test.go:TestGenerateAddressVectors.
testRecipientAddressForVector : Script ()
testRecipientAddressForVector = do
  recipientAddressFromText "vector-recipient::1220deadbeef"
    === "dbd2d1b09ea5715be3e45d0e38e5c5c0f6fcd0f181d45a9620dfb20f8ae3a4d9"
  assert (recipientAddressFromText "vector-recipient::1220deadbeef"
            /= recipientAddressFromText "vector-recipient::1220cafebabe")

-- | 'Receive' verifies the VAA, checks the peer, and decodes the payload
-- against the real signed fixture -- then rejects a recipient whose
-- 'recipientAddressFor' doesn't match the fixture's baked-in recipientAddress
-- (0x..ee). This is the only receive-level case a static fixture can exercise
-- for the SUCCESS side of the check: a live Party's fingerprint is
-- nondeterministic, so no Party allocated in this (or any) test run can ever
-- hash to a value that was baked into an already-signed fixture ahead of time.
-- The match case itself is pinned in testRecipientAddressForVector above; a
-- real production Receive matches because the sender computed
-- recipientAddressFor over the ACTUAL recipient's Party-id text before the VAA
-- was ever signed, which this fixture-based test cannot reproduce.
testNttReceiveRecipientMismatchFails : Script ()
testNttReceiveRecipientMismatchFails = do
  (operator, guardianGovernance, _) <- nttSetup
  admin <- allocateParty "RecvAdmin"
  wrongRecipient <- allocateParty "WrongRecipient"
  -- Our manager address must match the VAA's recipientManager (0x..aa), which a
  -- registry-derived address cannot reproduce (party fingerprints are
  -- nondeterministic). Create the manager directly — deliberately using the
  -- operator+admin co-signature to force managerAddress = 0x..aa. Address
  -- DERIVATION is covered by testNttDeployment; this test pins receive semantics
  -- against the static signed fixture. The transceiver key is unused by Receive.
  mockCid <- submit admin do createCmd MockToken with admin, manager = operator, mode = BurnMint
  let tokenCid = toInterfaceContractId @NttToken mockCid
  mgrId <- submit (actAs operator <> actAs admin) do
    createCmd NttManager with
      operator
      admin
      guardianGovernance
      managerId = 999
      managerAddress = b32 "aa"
      transceiverRegistrar = operator
      transceiverEmitterId = 999
      tokenCid
      mode = BurnMint
      tokenDecimals = 8
      peers = Map.empty
      outboundSequence = 0
  mgrId <- submit admin do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"

  -- Verification (against the authentic, key-resolved CoreState), peer, and
  -- manager-binding checks all pass for this fixture; the recipient binding is
  -- the one gate that fails.
  submitMustFail operator do
    exerciseCmd mgrId Receive with
      vaaBytes = nttTransferVAA
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient = wrongRecipient
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  pure ()

-- | The guardian trust root is PINNED — the manager's admin-co-signed
-- @guardianGovernance@ anchor, resolved by key — not caller-supplied. A manager
-- pinned to a rogue governance party (one a hypothetically compromised operator
-- controls, self-authorizing both CoreState signatory slots) resolves that
-- party's CoreState, whose guardian set is NOT the devnet set — so the genuine
-- devnet-signed fixture VAA must fail AT VERIFICATION. The trySubmit message
-- assertion pins the failure to the guardian-set check specifically (a bare
-- submitMustFail would also pass on the recipient-binding gate, which no static
-- fixture can satisfy — see testNttReceiveRecipientMismatchFails). Before the
-- fix, 'Receive' plain-fetched an operator-supplied @coreStateCid@, so exactly
-- this rogue CoreState would have been accepted with an attacker-signed VAA;
-- the choice no longer takes any core-state reference at all.
testNttReceiveVerifiesAgainstPinnedGuardianSet : Script ()
testNttReceiveVerifiesAgainstPinnedGuardianSet = do
  (operator, _, _) <- nttSetup
  admin <- allocateParty "PinAdmin"
  recipient <- allocateParty "PinRecipient"
  rogueGov <- allocateParty "RogueGovernance"
  rogueObserver <- allocateParty "RogueObserver"
  -- A well-typed, ledger-valid CoreState — just not the authentic anchor: its
  -- guardian set 0 holds an address that is not the devnet guardian.
  _ <- submit (actAs operator <> actAs rogueGov) do
    createCmd (mkInitialCoreState operator rogueGov solanaGovernanceChainId defaultGovernanceContract
                 ["1111111111111111111111111111111111111111"] rogueObserver)
  mockCid <- submit admin do createCmd MockToken with admin, manager = operator, mode = BurnMint
  let tokenCid = toInterfaceContractId @NttToken mockCid
  mgrId <- submit (actAs operator <> actAs admin) do
    createCmd NttManager with
      operator
      admin
      guardianGovernance = rogueGov
      managerId = 998
      managerAddress = b32 "aa"
      transceiverRegistrar = operator
      transceiverEmitterId = 998
      tokenCid
      mode = BurnMint
      tokenDecimals = 8
      peers = Map.empty
      outboundSequence = 0
  mgrId <- submit admin do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"

  res <- trySubmit operator do
    exerciseCmd mgrId Receive with
      vaaBytes = nttTransferVAA
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  case res of
    Left (FailureStatusError fs) ->
      assertMsg ("expected a guardian-set verification failure, got: " <> fs.message)
        ("public key does not match guardian address" `isInfixOf` fs.message)
    Left err -> abort ("expected a guardian-set verification failure, got: " <> show err)
    Right _ -> abort "Receive succeeded against a rogue-anchored guardian set"

----------------------------------------------------------------------
-- Receive (matching recipient), live two-step harness
----------------------------------------------------------------------
--
-- Closes the "known test gap" noted above and in canton/README.md: no
-- pre-signed static VAA can ever match a freshly, nondeterministically
-- allocated Party's hash, so the MATCHING-recipient path through a real
-- 'Receive' call cannot be tested with one dpm-script invocation. Instead this
-- is a two-step, Go-orchestrated live-sandbox flow (see
-- node/pkg/watchers/canton/ntt_recipient_match_integration_test.go):
--
--   1. 'integrationNttReceiveMatchSetup' allocates the recipient (and
--      everything else 'Receive' needs) and returns 'recipientAddressFor
--      recipient' -- computed ON-LEDGER, from the ACTUAL allocated Party, so
--      there is no guessing involved.
--   2. Go decodes that hash and signs a FRESH NTT transfer VAA against it,
--      using the same well-known devnet guardian test key
--      node/pkg/cantonclient/vectorgen_test.go uses for every other fixture in
--      this package -- exactly the off-chain step a real sender takes.
--   3. 'integrationNttReceiveMatch' relays that fresh VAA against the SAME
--      manager/recipient allocated in step 1 (both dpm-script calls target the
--      same running sandbox, so the ledger state persists between them), and
--      asserts the mint landed on the matching recipient, plus replay
--      rejection on a second relay of the same VAA.

-- | Step 1: allocate everything 'Receive' needs and hand back the hash Go must
-- sign a fresh VAA against.
data NttReceiveMatchSetup = NttReceiveMatchSetup with
    mgrId            : ContractId NttManager
    operator         : Party
    recipient        : Party
    recipientAddress : Bytes32
  deriving (Eq, Show)

integrationNttReceiveMatchSetup : Script NttReceiveMatchSetup
integrationNttReceiveMatchSetup = do
  (operator, guardianGovernance, _) <- nttSetup
  admin <- allocateParty "MatchAdmin"
  recipient <- allocateParty "MatchRecipient"
  mockCid <- submit admin do createCmd MockToken with admin, manager = operator, mode = BurnMint
  let tokenCid = toInterfaceContractId @NttToken mockCid
  mgrId <- submit (actAs operator <> actAs admin) do
    createCmd NttManager with
      operator
      admin
      guardianGovernance
      managerId = 996
      managerAddress = b32 "aa"
      transceiverRegistrar = operator
      transceiverEmitterId = 996
      tokenCid
      mode = BurnMint
      tokenDecimals = 8
      peers = Map.empty
      outboundSequence = 0
  mgrId <- submit admin do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"
  pure NttReceiveMatchSetup with
    mgrId
    operator
    recipient
    recipientAddress = recipientAddressFor recipient

-- | Step 2 input: everything from step 1 plus the freshly signed VAA (as hex
-- 'Bytes') Go built against step 1's 'recipientAddress'.
data NttReceiveMatchInput = NttReceiveMatchInput with
    mgrId     : ContractId NttManager
    operator  : Party
    recipient : Party
    vaaBytes  : Bytes
  deriving (Eq, Show)

-- | Step 2: relay the freshly signed VAA. Succeeds -- proving 'recipient'
-- really does match when the sender computed the hash correctly -- and mints
-- to 'recipient'. A second relay of the same VAA is rejected (replay).
integrationNttReceiveMatch : NttReceiveMatchInput -> Script ()
integrationNttReceiveMatch input = do
  ntt <- submit input.operator do
    exerciseCmd input.mgrId Receive with
      vaaBytes = input.vaaBytes
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient = input.recipient
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  ntt.recipientChain === 72

  holdings <- query @MockHolding input.recipient
  case holdings of
    [(_, h)] -> do
      h.owner === input.recipient
      h.amount === ntt.amount
    _ -> abort "expected exactly one holding minted to the matching recipient"

  [(mgr2, _)] <- query @NttManager input.operator
  submitMustFail input.operator do
    exerciseCmd mgr2 Receive with
      vaaBytes = input.vaaBytes
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient = input.recipient
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  pure ()

----------------------------------------------------------------------
-- Transfer by a user other than admin
----------------------------------------------------------------------

-- | A party other than the deployment's admin can initiate Transfer ALONE --
-- admin is never an active party. This works because exercising Transfer
-- consumes NttManager (signatories operator, admin), and consuming a contract
-- makes its signatories' authority available to every nested action in the
-- choice body -- including the nested LockOrBurn (controller = operator, via
-- the token's `manager` field) and PublishMessage (controller = admin, the
-- transceiver Emitter's owner) -- with no discretionary sign-off from either
-- party at exercise time. The only real requirement is VISIBILITY: bob is not
-- a natural stakeholder of NttManager, the transceiver Emitter, or the token
-- contract, so those need to be explicitly disclosed to him -- a data
-- attachment obtainable from any party with read access (here, admin), not an
-- approval decision.
testNttTransferByDifferentUser : Script ()
testNttTransferByDifferentUser = do
  (operator, guardianGovernance, _) <- nttSetup
  admin <- allocateParty "TransferAdmin"
  bob <- allocateParty "TransferBob"
  (mgrId, emitterCid) <- deploy operator guardianGovernance admin LockUnlock
  [(mockCid, _)] <- query @MockToken admin
  mgrId <- submit admin do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"

  Some dMgr     <- queryDisclosure admin mgrId
  Some dEmitter <- queryDisclosure admin emitterCid
  Some dMock    <- queryDisclosure admin mockCid
  _ <- submitWithDisclosures bob [dMgr, dEmitter, dMock] do
    exerciseByKeyCmd @NttManager (operator, admin, 0) Transfer with
      user = bob
      recipientChain = 2
      recipientAddress = b32 "ee"
      sourceToken = b32 "dd"
      rawAmount = 1000000
      nonce = 1
      consistencyLevel = 0
      inputHoldingCids = []
      extraArgs = emptyExtraArgs

  Some (_, m) <- queryByKey @NttManager operator (operator, admin, 0)
  m.outboundSequence === 1

-- | Two negative cases, for two different reasons: (1) admin ALONE cannot
-- transfer on bob's behalf -- admin is never a controller, so submitting
-- without bob's authority fails regardless of disclosure. (2) bob ALONE
-- WITHOUT disclosure also fails, but for a completely different reason --
-- visibility, not authority: a non-stakeholder can't even resolve NttManager
-- by key ("no contract with that key was found"). Disclosure (as in
-- testNttTransferByDifferentUser) is what's actually missing here, not
-- admin's participation.
testNttTransferRequiresUserAuthority : Script ()
testNttTransferRequiresUserAuthority = do
  (operator, guardianGovernance, _) <- nttSetup
  admin <- allocateParty "ReqAdmin"
  bob <- allocateParty "ReqBob"
  (mgrId, _) <- deploy operator guardianGovernance admin LockUnlock
  _ <- submit admin do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"
  let doTransfer = exerciseByKeyCmd @NttManager (operator, admin, 0) Transfer with
        user = bob
        recipientChain = 2
        recipientAddress = b32 "ee"
        sourceToken = b32 "dd"
        rawAmount = 1000000
        nonce = 1
        consistencyLevel = 0
        inputHoldingCids = []
        extraArgs = emptyExtraArgs

  submitMustFail admin do doTransfer
  submitMustFail bob do doTransfer
  pure ()
