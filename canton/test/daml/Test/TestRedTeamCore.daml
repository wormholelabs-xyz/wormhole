----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

set0PubKeys : [(Int, Bytes)]
set0PubKeys = [(0, devnetGuardianPubKey)]

set1PubKeys : [(Int, Bytes)]
set1PubKeys =
  [(0, devnetGuardianPubKey), (1, redTeamGuardianPubKey1), (2, redTeamGuardianPubKey2), (3, redTeamGuardianPubKey3)]

checkAttackFailedWith : Text -> Text -> Either SubmitError a -> Script ()
checkAttackFailedWith attack expectedSubstring submitResult = do
  assertMsg (attack <> ": the expected failure text is empty") (expectedSubstring /= "")
  case submitResult of
    Left (FailureStatusError failureStatus) ->
      assertMsg (attack <> ": expected failure containing '" <> expectedSubstring <> "', got: " <> failureStatus.message)
        (expectedSubstring `T.isInfixOf` failureStatus.message)
    Left otherError ->
      assertMsg (attack <> ": expected failure containing '" <> expectedSubstring <> "', got: " <> show otherError)
        (expectedSubstring `T.isInfixOf` show otherError)
    Right _ -> abort (attack <> ": attack succeeded")

isAttackAccepted : Either SubmitError a -> Bool
isAttackAccepted submitResult = case submitResult of
  Left _ -> False
  Right _ -> True

-- | Aborts with every accepted attack name, so one run reports all of them.
checkNoAttackAccepted : Text -> [Text] -> Script ()
checkNoAttackAccepted finding acceptedAttacks =
  assertMsg (finding <> ": attacks accepted: " <> show acceptedAttacks) (null acceptedAttacks)

submitGovernance : Party -> ContractId CoreState -> Bytes -> [(Int, Bytes)] -> Script (ContractId CoreState)
submitGovernance operator coreStateCid encodedVAA pubKeys = submit operator do
  exerciseCmd coreStateCid SubmitGovernanceVAA with encodedVAA, pubKeys

checkGovernanceRejectedWith : Text -> Text -> Party -> ContractId CoreState -> Bytes -> [(Int, Bytes)] -> Script ()
checkGovernanceRejectedWith attack expectedSubstring operator coreStateCid encodedVAA pubKeys = do
  submitResult <- trySubmit operator do
    exerciseCmd coreStateCid SubmitGovernanceVAA with encodedVAA, pubKeys
  checkAttackFailedWith attack expectedSubstring submitResult

verifyVAA : Party -> ContractId CoreState -> Bytes -> [(Int, Bytes)] -> Script VAA
verifyVAA operator coreStateCid encodedVAA pubKeys = submit operator do
  exerciseCmd coreStateCid ParseAndVerifyVAA with verifier = operator, encodedVAA, pubKeys

checkVerifyRejectedWith : Text -> Text -> Party -> ContractId CoreState -> Bytes -> [(Int, Bytes)] -> Script ()
checkVerifyRejectedWith attack expectedSubstring operator coreStateCid encodedVAA pubKeys = do
  submitResult <- trySubmit operator do
    exerciseCmd coreStateCid ParseAndVerifyVAA with verifier = operator, encodedVAA, pubKeys
  checkAttackFailedWith attack expectedSubstring submitResult

upgradeToSet1 : Party -> ContractId CoreState -> Script (ContractId CoreState)
upgradeToSet1 operator coreStateCid = do
  set1CoreStateCid <- submitGovernance operator coreStateCid rtGuardianSetUpgradeToSet1 set0PubKeys
  Some set1CoreState <- queryContractId operator set1CoreStateCid
  set1CoreState.guardianSetIndex === 1
  pure set1CoreStateCid

-- | @byteCount@ bytes of 0xab as hex.
hexPayloadOfBytes : Int -> Bytes
hexPayloadOfBytes byteCount = mconcat (replicate byteCount "ab")

replaceByteAt : Int -> Bytes -> Bytes -> Bytes
replaceByteAt byteOffset replacementByte encoded =
  T.take (byteOffset * 2) encoded <> replacementByte <> T.drop (byteOffset * 2 + 2) encoded

----------------------------------------------------------------------
-- A1: fee bypass
----------------------------------------------------------------------

-- | A fee-charging registry or a raised message fee cannot be skipped by
-- omitting the CoreState or the allocation. Shadow-CoreState redirection on all
-- three paths: Test.TestFees.test*PinsGuardianGovernance.
testRedTeamA1FeeCannotBeSkipped : Script ()
testRedTeamA1FeeCannotBeSkipped = do
  (operator, guardianGovernance, coreStateCid) <- setup
  registrant <- allocateParty "RedTeamFeeRegistrant"
  emitterCid <- registerEmitter operator registrant
  feeRegistryCid <- submit (actAs operator <> actAs guardianGovernance) do
    createCmd (mkInitialEmitterRegistry operator guardianGovernance 500)
  feeRegistryDisclosure <- fromSome <$> queryDisclosure operator feeRegistryCid
  registerResult <- trySubmit (actAs registrant <> disclose feeRegistryDisclosure) do
    exerciseCmd feeRegistryCid RegisterEmitter with
      requester = registrant, payer = registrant, coreStateCid = None, feeAllocation = None
      expectedGuardianGovernance = None
  checkAttackFailedWith "A1 RegisterEmitter without CoreState" "registration fee due" registerResult

  feeRootRegistryCid <- submit operator do
    createCmd (mkInitialReplayRootRegistry operator guardianGovernance 300)
  feeRootRegistryDisclosure <- fromSome <$> queryDisclosure operator feeRootRegistryCid
  claimResult <- trySubmit (actAs registrant <> disclose feeRootRegistryDisclosure) do
    exerciseCmd feeRootRegistryCid ClaimReplayRoot with
      consumer = registrant, namespace = "redteam", splitThreshold = 4
      payer = registrant, coreStateCid = None, feeAllocation = None
  checkAttackFailedWith "A1 ClaimReplayRoot without CoreState" "claim fee due" claimResult

  feeCoreStateCid <- submitGovernance operator coreStateCid govSetFeeVAA set0PubKeys
  coreStateDisclosure <- fromSome <$> queryDisclosure operator feeCoreStateCid
  publishResult <- trySubmit (actAs registrant <> disclose coreStateDisclosure) do
    exerciseCmd emitterCid PublishMessage with
      nonce = 0, payload = "00", consistencyLevel = 0
      coreStateCid = feeCoreStateCid, payer = registrant, feeAllocation = None
  checkAttackFailedWith "A1 PublishMessage without allocation" "fee required" publishResult

----------------------------------------------------------------------
-- A6: guardian set
----------------------------------------------------------------------

testRedTeamA6GuardianSetUpgradeRules : Script ()
testRedTeamA6GuardianSetUpgradeRules = do
  (operator, _, coreStateCid) <- setup
  checkGovernanceRejectedWith "A6 upgrade skips an index" "index must be current + 1"
    operator coreStateCid rtGuardianSetUpgradeSkipsIndex set0PubKeys
  checkGovernanceRejectedWith "A6 upgrade to the same index" "index must be current + 1"
    operator coreStateCid rtGuardianSetUpgradeSameIndex set0PubKeys
  checkGovernanceRejectedWith "A6 upgrade from a wrong emitter chain" "wrong emitter chain"
    operator coreStateCid rtGuardianSetUpgradeWrongEmitterChain set0PubKeys
  checkGovernanceRejectedWith "A6 upgrade from a wrong emitter address" "wrong emitter address"
    operator coreStateCid rtGuardianSetUpgradeWrongEmitterAddress set0PubKeys
  checkGovernanceRejectedWith "A6 upgrade for another chain" "wrong target chain"
    operator coreStateCid rtGuardianSetUpgradeWrongTargetChain set0PubKeys
  checkGovernanceRejectedWith "A6 upgrade to an empty set" "empty set"
    operator coreStateCid rtGuardianSetUpgradeEmptySet set0PubKeys

  set1CoreStateCid <- upgradeToSet1 operator coreStateCid
  checkGovernanceRejectedWith "A6 upgrade to a lower index" "index must be current + 1"
    operator set1CoreStateCid rtGuardianSetUpgradeLowerIndexBySet1 set1PubKeys
  checkGovernanceRejectedWith "A6 replay of the applied upgrade" "not signed by current guardian set"
    operator set1CoreStateCid rtGuardianSetUpgradeToSet1 set0PubKeys

testRedTeamA6QuorumAndSignerOrder : Script ()
testRedTeamA6QuorumAndSignerOrder = do
  (operator, _, coreStateCid) <- setup
  set1CoreStateCid <- upgradeToSet1 operator coreStateCid
  checkGovernanceRejectedWith "A6 two of four signatures" "no quorum"
    operator set1CoreStateCid rtSetMessageFeeBySet1BelowQuorum set1PubKeys
  checkGovernanceRejectedWith "A6 duplicate signer index" "strictly ascending"
    operator set1CoreStateCid rtSetMessageFeeBySet1DuplicateSigner set1PubKeys
  checkGovernanceRejectedWith "A6 signatures out of order" "strictly ascending"
    operator set1CoreStateCid rtSetMessageFeeBySet1SignersOutOfOrder set1PubKeys
  checkGovernanceRejectedWith "A6 key 3 signs as guardian 0" "invalid signature for guardian index 0"
    operator set1CoreStateCid rtSetMessageFeeBySet1WrongKeyAtIndex set1PubKeys
  checkGovernanceRejectedWith "A6 key 3 signs as guardian 0 with its own public key"
    "public key does not match guardian address at index 0"
    operator set1CoreStateCid rtSetMessageFeeBySet1WrongKeyAtIndex
    [(0, redTeamGuardianPubKey3), (1, redTeamGuardianPubKey1), (2, redTeamGuardianPubKey2)]
  checkGovernanceRejectedWith "A6 signer index out of range" "guardian index out of range"
    operator set1CoreStateCid rtSetMessageFeeBySet1IndexOutOfRange (set1PubKeys <> [(7, redTeamGuardianPubKey3)])
  supersededSetVAA <- verifyVAA operator set1CoreStateCid rtSetMessageFeeBySet0AfterUpgrade set0PubKeys
  supersededSetVAA.guardianSetIndex === 0
  checkGovernanceRejectedWith "A6 governance by the superseded set" "not signed by current guardian set"
    operator set1CoreStateCid rtSetMessageFeeBySet0AfterUpgrade set0PubKeys

  feeCoreStateCid <- submitGovernance operator set1CoreStateCid rtSetMessageFeeBySet1Quorum set1PubKeys
  Some feeCoreState <- queryContractId operator feeCoreStateCid
  feeCoreState.messageFee === 7

-- | The superseded set verifies application VAAs through the whole expiry second
-- (EVM @Messages.sol@: rejects only when @expirationTime < block.timestamp@,
-- with @block.timestamp@ in whole seconds).
testRedTeamA6ExpiredGuardianSet : Script ()
testRedTeamA6ExpiredGuardianSet = do
  (operator, _, coreStateCid) <- setup
  set1CoreStateCid <- upgradeToSet1 operator coreStateCid
  verifiedAtUpgrade <- verifyVAA operator set1CoreStateCid rtAppMessageBySet0 set0PubKeys
  verifiedAtUpgrade.guardianSetIndex === 0
  passTime (seconds guardianSetExpirySeconds)
  verifiedAtExpiry <- verifyVAA operator set1CoreStateCid rtAppMessageBySet0 set0PubKeys
  verifiedAtExpiry.guardianSetIndex === 0
  passTime (microseconds 999999)
  verifiedAtLastMicrosecond <- verifyVAA operator set1CoreStateCid rtAppMessageBySet0 set0PubKeys
  verifiedAtLastMicrosecond.guardianSetIndex === 0
  passTime (microseconds 1)
  checkVerifyRejectedWith "A6 VAA signed by an expired set" "guardian set has expired"
    operator set1CoreStateCid rtAppMessageBySet0 set0PubKeys

----------------------------------------------------------------------
-- A9: malformed VAAs
----------------------------------------------------------------------

testRedTeamA9MalformedEncodings : Script ()
testRedTeamA9MalformedEncodings = do
  (operator, _, coreStateCid) <- setup
  _ <- verifyVAA operator coreStateCid govSetFeeVAA set0PubKeys
  let malformedCases =
        [ ("A9 truncated header", "sliceBytes", T.take 10 govSetFeeVAA)
        , ("A9 truncated signature", "sliceBytes: out of range", T.take ((6 + 30) * 2) govSetFeeVAA)
        , ("A9 body missing its last byte", "invalid signature", T.take (T.length govSetFeeVAA - 2) govSetFeeVAA)
        , ("A9 extra trailing byte", "invalid signature", govSetFeeVAA <> "00")
        , ("A9 signature count zero", "ArithmeticError", replaceByteAt 5 "00" govSetFeeVAA)
        , ("A9 signature count two", "invalid signature", replaceByteAt 5 "02" govSetFeeVAA)
        , ("A9 version two", "unsupported VAA version", replaceByteAt 0 "02" govSetFeeVAA)
        , ("A9 version zero", "unsupported VAA version", replaceByteAt 0 "00" govSetFeeVAA)
        , ("A9 odd hex length", "not a hex string", govSetFeeVAA <> "0")
        , ("A9 0x prefix", "invalid hex digit", "0x" <> govSetFeeVAA)
        , ("A9 non-hex payload byte", "not a hex string", T.take (T.length govSetFeeVAA - 2) govSetFeeVAA <> "zz")
        , ("A9 empty input", "sliceBytes: out of range", "")
        ]
  forA_ malformedCases \(attack, expectedSubstring, encodedVAA) ->
    checkVerifyRejectedWith attack expectedSubstring operator coreStateCid encodedVAA set0PubKeys
  forA_ malformedCases \(attack, expectedSubstring, encodedVAA) ->
    checkGovernanceRejectedWith (attack <> " (governance)") expectedSubstring operator coreStateCid encodedVAA set0PubKeys

testRedTeamA9MalformedGovernancePayloads : Script ()
testRedTeamA9MalformedGovernancePayloads = do
  (operator, _, coreStateCid) <- setup
  checkGovernanceRejectedWith "A9 TokenBridge module" "not the Core module"
    operator coreStateCid rtSetMessageFeeWrongModule set0PubKeys
  checkGovernanceRejectedWith "A9 RecoverChainId action" "unsupported action 5"
    operator coreStateCid rtRecoverChainIDUnsupported set0PubKeys
  checkGovernanceRejectedWith "A9 empty governance payload" "packet must be at least 35 bytes"
    operator coreStateCid rtGovernanceEmptyPayload set0PubKeys
  checkGovernanceRejectedWith "A9 truncated ContractUpgrade" "ContractUpgrade packet must be 67 bytes"
    operator coreStateCid rtContractUpgradeTruncated set0PubKeys
  checkGovernanceRejectedWith "A9 SetMessageFee of 2^64" "ArithmeticError"
    operator coreStateCid rtSetMessageFeeOverflowsInt64 set0PubKeys

-- | EVM GovernanceStructs.sol requires @encoded.length == index@ for every
-- action; a guardian-signed packet with trailing bytes must not apply.
testRedTeamA9GovernancePayloadExactLength : Script ()
testRedTeamA9GovernancePayloadExactLength = do
  (setFeeOperator, _, setFeeCoreStateCid) <- setup
  setFeeResult <- trySubmit setFeeOperator do
    exerciseCmd setFeeCoreStateCid SubmitGovernanceVAA with
      encodedVAA = rtSetMessageFeeTrailingByte, pubKeys = set0PubKeys
  (upgradeOperator, _, upgradeCoreStateCid) <- setup
  upgradeResult <- trySubmit upgradeOperator do
    exerciseCmd upgradeCoreStateCid SubmitGovernanceVAA with
      encodedVAA = rtGuardianSetUpgradeTrailingByte, pubKeys = set0PubKeys
  checkNoAttackAccepted "A9 governance payload with a trailing byte"
    ([ "SetMessageFee" | isAttackAccepted setFeeResult ] <> [ "GuardianSetUpgrade" | isAttackAccepted upgradeResult ])

-- | Runs 'parseGovernance' in a transaction so its abort is a submit error.
template GovernancePacketParser
  with
    parser : Party
  where
    signatory parser

    nonconsuming choice ParseGovernancePacket : GovernanceAction
      with
        packet : Bytes
      controller parser
      do pure (parseGovernance packet)

coreGovernanceHeader : Int -> Bytes
coreGovernanceHeader action = coreModule <> intToBytesN action 1 <> intToBytesN 75 2

guardianSetUpgradePacket : Int -> [Bytes20] -> Bytes
guardianSetUpgradePacket declaredKeyCount guardianKeys =
  coreGovernanceHeader 2 <> intToBytesN 1 4 <> intToBytesN declaredKeyCount 1 <> mconcat guardianKeys

-- | Exact packet lengths of sdk/vaa/payloads.go: ContractUpgrade 67,
-- GuardianSetUpgrade 40 + 20 * keys, SetMessageFee 67, TransferFees 99.
testParseGovernanceRequiresExactPacketLength : Script ()
testParseGovernanceRequiresExactPacketLength = do
  parser <- allocateParty "GovernancePacketParser"
  parserCid <- submit parser do createCmd GovernancePacketParser with parser
  let guardianKeyA = mconcat (replicate 20 "aa")
      guardianKeyB = mconcat (replicate 20 "bb")
      contractUpgrade = coreGovernanceHeader 1 <> mconcat (replicate 32 "c1")
      setMessageFee = coreGovernanceHeader 3 <> intToBytesN 7 32
      transferFees = coreGovernanceHeader 4 <> intToBytesN 9 32 <> mconcat (replicate 32 "d4")
      parsePacket packet = trySubmit parser do exerciseCmd parserCid ParseGovernancePacket with packet
      acceptedCases =
        [ (contractUpgrade, ContractUpgrade with chain = 75, newContract = mconcat (replicate 32 "c1"))
        , (guardianSetUpgradePacket 1 [guardianKeyA], GuardianSetUpgrade with chain = 75, newIndex = 1, newKeys = [guardianKeyA])
        , (guardianSetUpgradePacket 2 [guardianKeyA, guardianKeyB], GuardianSetUpgrade with chain = 75, newIndex = 1, newKeys = [guardianKeyA, guardianKeyB])
        , (setMessageFee, SetMessageFee with chain = 75, fee = 7)
        , (transferFees, TransferFees with chain = 75, amount = 9, recipient = mconcat (replicate 32 "d4"))
        ]
      rejectedCases =
        [ ("ContractUpgrade plus one byte", "ContractUpgrade packet must be 67 bytes", contractUpgrade <> "00")
        , ("ContractUpgrade minus one byte", "ContractUpgrade packet must be 67 bytes", T.take (66 * 2) contractUpgrade)
        , ("header minus one byte", "packet must be at least 35 bytes", T.take (34 * 2) contractUpgrade)
        , ("GuardianSetUpgrade without its key count", "GuardianSetUpgrade packet must be at least 40 bytes", T.take (39 * 2) (guardianSetUpgradePacket 1 []))
        , ("GuardianSetUpgrade plus one byte", "GuardianSetUpgrade packet must be 60 bytes", guardianSetUpgradePacket 1 [guardianKeyA] <> "00")
        , ("GuardianSetUpgrade plus one undeclared key", "GuardianSetUpgrade packet must be 60 bytes", guardianSetUpgradePacket 1 [guardianKeyA, guardianKeyB])
        , ("GuardianSetUpgrade missing a declared key", "GuardianSetUpgrade packet must be 80 bytes", guardianSetUpgradePacket 2 [guardianKeyA])
        , ("SetMessageFee plus one byte", "SetMessageFee packet must be 67 bytes", setMessageFee <> "00")
        , ("SetMessageFee plus one nibble", "SetMessageFee packet must be 67 bytes", setMessageFee <> "0")
        , ("SetMessageFee minus one byte", "SetMessageFee packet must be 67 bytes", T.take (66 * 2) setMessageFee)
        , ("TransferFees plus one byte", "TransferFees packet must be 99 bytes", transferFees <> "00")
        , ("TransferFees minus one byte", "TransferFees packet must be 99 bytes", T.take (98 * 2) transferFees)
        ]
  forA_ acceptedCases \(packet, expectedAction) -> do
    parsedAction <- submit parser do exerciseCmd parserCid ParseGovernancePacket with packet
    parsedAction === expectedAction
  forA_ rejectedCases \(attack, expectedSubstring, packet) -> do
    parseResult <- parsePacket packet
    checkAttackFailedWith attack expectedSubstring parseResult

-- | An uppercase re-encoding of a consumed VAA has the same digest: a replay
-- on both the governance and the integrator path.
testRedTeamA9HexCaseReplay : Script ()
testRedTeamA9HexCaseReplay = do
  (operator, _, coreStateCid) <- setup
  feeCoreStateCid <- submitGovernance operator coreStateCid govSetFeeVAA set0PubKeys
  checkGovernanceRejectedWith "A9 uppercase governance replay" "action already consumed"
    operator feeCoreStateCid (T.asciiToUpper govSetFeeVAA) set0PubKeys

  consumer <- allocateParty "RedTeamCaseConsumer"
  rootCid <- registerReplayRoot operator consumer "case" 128
  coreStateDisclosure <- fromSome <$> queryDisclosure operator feeCoreStateCid
  (_, consumedNodeCid) <- submit (actAs consumer <> disclose coreStateDisclosure) do
    exerciseCmd feeCoreStateCid VerifyAndConsumeVAA with
      encodedVAA = rtAppMessageBySet0, pubKeys = set0PubKeys
      consumer, namespace = "case", replayNodeCid = rootCid
  replayResult <- trySubmit (actAs consumer <> disclose coreStateDisclosure) do
    exerciseCmd feeCoreStateCid VerifyAndConsumeVAA with
      encodedVAA = T.asciiToUpper rtAppMessageBySet0, pubKeys = set0PubKeys
      consumer, namespace = "case", replayNodeCid = consumedNodeCid
  checkAttackFailedWith "A9 uppercase integrator replay" "digest already consumed" replayResult

testRedTeamA9EmptyApplicationPayloadVerifies : Script ()
testRedTeamA9EmptyApplicationPayloadVerifies = do
  (operator, _, coreStateCid) <- setup
  verified <- verifyVAA operator coreStateCid rtAppMessageEmptyPayloadBySet0 set0PubKeys
  verified.payload === ""
  verified.sequence === 2

-- | No core bridge caps the payload size. Each size publishes and takes the
-- next sequence.
testRedTeamA9PublishAcceptsAnyPayloadSize : Script ()
testRedTeamA9PublishAcceptsAnyPayloadSize = do
  (operator, _, coreStateCid) <- setup
  owner <- allocateParty "RedTeamPayloadSizeOwner"
  emitterCid <- registerEmitter operator owner
  let payloadByteCounts = [0, 750, 751, 65536]
      publishPayloadOfBytes (currentEmitterCid, expectedSequence) payloadByteCount = do
        (successorCid, message) <- publishVia operator coreStateCid owner currentEmitterCid 0 (hexPayloadOfBytes payloadByteCount) 0
        message.payload === hexPayloadOfBytes payloadByteCount
        message.sequence === expectedSequence
        pure (successorCid, expectedSequence + 1)
  (_, nextSequence) <- foldlA publishPayloadOfBytes (emitterCid, 0) payloadByteCounts
  nextSequence === length payloadByteCounts

-- | The watcher drops a message whose payload is not even-length hex
-- or whose nonce / consistency level is outside uint32 / uint8
-- (cantongrpc.go decodeWormholeMessage). PublishMessage must reject them:
-- an accepted one consumes a sequence number the guardians never sign.
testRedTeamA9PublishRejectsFieldsTheWatcherDrops : Script ()
testRedTeamA9PublishRejectsFieldsTheWatcherDrops = do
  (operator, _, coreStateCid) <- setup
  owner <- allocateParty "RedTeamUndecodableOwner"
  emitterCid <- registerEmitter operator owner
  coreStateDisclosure <- fromSome <$> queryDisclosure operator coreStateCid
  let undecodableCases =
        [ ("odd-length payload (1501 hex chars)", 0, mconcat (replicate 1501 "a"), 0)
        , ("non-hex payload", 0, "zz", 0)
        , ("nonce 2^32", 4294967296, "00", 0)
        , ("negative nonce", -1, "00", 0)
        , ("consistency level 256", 0, "00", 256)
        , ("negative consistency level", 0, "00", -1)
        ]
      tryPublish (currentEmitterCid, acceptedAttacks) (attack, nonce, payload, consistencyLevel) = do
        publishResult <- trySubmit (actAs owner <> disclose coreStateDisclosure) do
          exerciseCmd currentEmitterCid PublishMessage with
            nonce, payload, consistencyLevel
            coreStateCid, payer = owner, feeAllocation = None
        pure $ case publishResult of
          Right (successorCid, _) -> (successorCid, acceptedAttacks <> [attack])
          Left _ -> (currentEmitterCid, acceptedAttacks)
  (_, acceptedAttacks) <- foldlA tryPublish (emitterCid, []) undecodableCases
  checkNoAttackAccepted "A9 PublishMessage fields the watcher drops" acceptedAttacks

-- | Each field at its wire boundary publishes; one step past it aborts with a
-- named reason, and a rejected publish does not advance the sequence.
testRedTeamA9PublishFieldBoundaries : Script ()
testRedTeamA9PublishFieldBoundaries = do
  (operator, _, coreStateCid) <- setup
  owner <- allocateParty "RedTeamFieldBoundaryOwner"
  emitterCid <- registerEmitter operator owner
  coreStateDisclosure <- fromSome <$> queryDisclosure operator coreStateCid
  let rejectedCases =
        [ ("odd-length payload", "payload has an odd hex length", 0, "abc", 0)
        , ("uppercase payload", "payload is not lowercase hex", 0, "AB", 0)
        , ("0x-prefixed payload", "payload is not lowercase hex", 0, "0x00", 0)
        , ("non-hex payload", "payload is not lowercase hex", 0, "zz", 0)
        , ("751-byte non-hex payload", "payload is not lowercase hex", 0, mconcat (replicate 751 "zz"), 0)
        , ("1501-char odd-length payload", "payload has an odd hex length", 0, mconcat (replicate 1501 "a"), 0)
        , ("65537-char odd-length payload", "payload has an odd hex length", 0, mconcat (replicate 65537 "a"), 0)
        , ("nonce 2^32", "nonce exceeds uint32", 4294967296, "00", 0)
        , ("nonce -1", "nonce is negative", -1, "00", 0)
        , ("consistency level 256", "consistency level exceeds uint8", 0, "00", 256)
        , ("consistency level -1", "consistency level is negative", 0, "00", -1)
        ]
  forA_ rejectedCases \(attack, expectedSubstring, nonce, payload, consistencyLevel) -> do
    publishResult <- trySubmit (actAs owner <> disclose coreStateDisclosure) do
      exerciseCmd emitterCid PublishMessage with
        nonce, payload, consistencyLevel
        coreStateCid, payer = owner, feeAllocation = None
    checkAttackFailedWith ("A9 " <> attack) expectedSubstring publishResult
  (emitterAfterMaxima, maximaMessage) <- publishVia operator coreStateCid owner emitterCid 4294967295 "00" 255
  (maximaMessage.sequence, maximaMessage.nonce, maximaMessage.consistencyLevel) === (0, 4294967295, 255)
  (_, minimaMessage) <- publishVia operator coreStateCid owner emitterAfterMaxima 0 "" 0
  (minimaMessage.sequence, minimaMessage.nonce, minimaMessage.consistencyLevel) === (1, 0, 0)

----------------------------------------------------------------------
-- A14: Emitter created outside RegisterEmitter
----------------------------------------------------------------------

testRedTeamA14OperatorCannotForgeThirdPartyEmitter : Script ()
testRedTeamA14OperatorCannotForgeThirdPartyEmitter = do
  (operator, guardianGovernance, _) <- setup
  victim <- allocateParty "RedTeamVictimOwner"
  accomplice <- allocateParty "RedTeamAccomplice"
  victimEmitterCid <- registerEmitter operator victim
  Some victimEmitter <- queryContractId victim victimEmitterCid
  let forgedVictimEmitter = victimEmitter with sequence = 0
  forA_ [ ("operator alone", actAs operator)
        , ("operator and accomplice", actAs operator <> actAs accomplice)
        , ("operator and guardianGovernance", actAs operator <> actAs guardianGovernance) ]
    \(forgers, forgerAuthority) -> do
      forgeResult <- trySubmit forgerAuthority do createCmd forgedVictimEmitter
      checkAttackFailedWith ("A14 " <> forgers <> " creates the victim's emitter") "Authorization failure" forgeResult

-- | guardianGovernance co-signs every 'Emitter' (A14-2), so no subset of
-- operator, owner, and guardianGovernance can create one outside
-- 'RegisterEmitter': a rewound duplicate of an issued identity is refused.
testRedTeamA14ColludingOwnerCannotDuplicateEmitter : Script ()
testRedTeamA14ColludingOwnerCannotDuplicateEmitter = do
  (operator, guardianGovernance, coreStateCid) <- setup
  colludingOwner <- allocateParty "RedTeamColludingOwner"
  colludingEmitterCid <- registerEmitter operator colludingOwner
  operatorEmitterCid <- registerEmitter operator operator
  (_, firstMessage) <- publishVia operator coreStateCid colludingOwner colludingEmitterCid 1 "aa" 0
  (_, operatorMessage) <- publishVia operator coreStateCid operator operatorEmitterCid 2 "bb" 0
  let rewoundEmitterOf owner message = Emitter with
        operator, guardianGovernance, owner
        emitterId = message.emitterId
        emitterAddress = emitterAddressFor operator owner message.emitterId
        sequence = message.sequence
      duplicateAttempts =
        [ ("operator and owner", actAs operator <> actAs colludingOwner, rewoundEmitterOf colludingOwner firstMessage)
        , ("operator as its own owner", actAs operator, rewoundEmitterOf operator operatorMessage)
        , ("operator and guardianGovernance", actAs operator <> actAs guardianGovernance,
            rewoundEmitterOf colludingOwner firstMessage)
        ]
  forA_ duplicateAttempts \(colluders, colluderAuthority, rewoundEmitter) -> do
    duplicateResult <- trySubmit colluderAuthority do createCmd rewoundEmitter
    checkAttackFailedWith ("A14 " <> colluders <> " duplicates an issued emitter") "Authorization failure" duplicateResult
  guardianVisibleEmitters <- query @Emitter guardianGovernance
  length (filter (\(_, emitter) -> emitter.owner == colludingOwner) guardianVisibleEmitters) === 1
  length (filter (\(_, emitter) -> emitter.owner == operator) guardianVisibleEmitters) === 1

-- | Exactly operator, owner, and guardianGovernance sign an 'Emitter': all
-- three together can create one directly.
testRedTeamA14EmitterSignatoriesAreOperatorOwnerAndGovernance : Script ()
testRedTeamA14EmitterSignatoriesAreOperatorOwnerAndGovernance = do
  (operator, guardianGovernance, _) <- setup
  owner <- allocateParty "RedTeamSignatoryOwner"
  emitterCid <- submit (actAs operator <> actAs owner <> actAs guardianGovernance) do
    createCmd Emitter with
      operator, guardianGovernance, owner
      emitterId = 0
      emitterAddress = emitterAddressFor operator owner 0
      sequence = 0
  Some emitter <- queryContractId guardianGovernance emitterCid
  sort (signatory emitter) === sort [operator, owner, guardianGovernance]

-- | A registry reset with a reused id would give an honest owner's second
-- emitter the address and sequence 0 of its first. 'EmitterRegistry' is
-- co-signed by guardianGovernance, so the operator alone cannot create one that
-- names the real guardianGovernance. A registry under a rogue guardianGovernance
-- needs the rogue party's signature, and its emitters abort on the real
-- 'CoreState' pin: Test.TestGuardianVisibility.testRogueGovernanceEmitterCannotPublishOnRealCoreState.
testRedTeamA14OperatorCannotResetEmitterRegistry : Script ()
testRedTeamA14OperatorCannotResetEmitterRegistry = do
  (operator, guardianGovernance, coreStateCid) <- setup
  honestOwner <- allocateParty "RedTeamHonestOwner"
  firstEmitterCid <- registerEmitter operator honestOwner
  resetResult <- trySubmit (actAs operator) do
    createCmd (mkInitialEmitterRegistry operator guardianGovernance 0)
  checkAttackFailedWith "A14 operator alone resets the EmitterRegistry" "Authorization failure" resetResult

  [(realRegistryCid, realRegistry)] <- query @EmitterRegistry operator
  realRegistry.nextId === 1
  let operatorAloneAttacks =
        [ ("archives the real EmitterRegistry", void <$> trySubmit (actAs operator) do archiveCmd realRegistryCid)
        , ("sets the registration fee on the real EmitterRegistry", void <$> trySubmit (actAs operator) do
            exerciseCmd realRegistryCid SetRegistrationFee with newRegistrationFee = 0)
        ]
  forA_ operatorAloneAttacks \(attack, runAttack) -> do
    attackResult <- runAttack
    checkAttackFailedWith ("A14 operator alone " <> attack) "Authorization failure" attackResult
  [(survivingRegistryCid, survivingRegistry)] <- query @EmitterRegistry guardianGovernance
  survivingRegistryCid === realRegistryCid
  survivingRegistry.nextId === 1

  secondEmitterCid <- registerEmitter operator honestOwner
  (_, firstMessage) <- publishVia operator coreStateCid honestOwner firstEmitterCid 1 "aa" 0
  (_, secondMessage) <- publishVia operator coreStateCid honestOwner secondEmitterCid 2 "bb" 0
  firstMessage.emitterId === 0
  secondMessage.emitterId === 1
  assert (emitterAddressFor operator honestOwner secondMessage.emitterId
            /= emitterAddressFor operator honestOwner firstMessage.emitterId)

-- | guardianGovernance alone cannot create, archive, or re-price a registry:
-- each needs the operator's signature too.
testRedTeamA14GovernanceAloneCannotCreateOrArchiveRegistry : Script ()
testRedTeamA14GovernanceAloneCannotCreateOrArchiveRegistry = do
  (operator, guardianGovernance, _) <- setup
  [(realRegistryCid, _)] <- query @EmitterRegistry operator
  let governanceAloneAttacks =
        [ ("creates an EmitterRegistry", void <$> trySubmit (actAs guardianGovernance) do
            createCmd (mkInitialEmitterRegistry operator guardianGovernance 0))
        , ("archives the real EmitterRegistry", void <$> trySubmit (actAs guardianGovernance) do
            archiveCmd realRegistryCid)
        , ("sets the registration fee on the real EmitterRegistry", void <$> trySubmit (actAs guardianGovernance) do
            exerciseCmd realRegistryCid SetRegistrationFee with newRegistrationFee = 0)
        ]
  forA_ governanceAloneAttacks \(attack, runAttack) -> do
    attackResult <- runAttack
    checkAttackFailedWith ("A14 guardianGovernance alone " <> attack) "Authorization failure" attackResult
  [(survivingRegistryCid, survivingRegistry)] <- query @EmitterRegistry guardianGovernance
  survivingRegistryCid === realRegistryCid
  survivingRegistry.nextId === 0

----------------------------------------------------------------------
-- R1: rolled-back publish
----------------------------------------------------------------------

-- | Publishes inside @try@, then throws, to make the publish a rollback node.
template RollbackPublisher
  with
    owner : Party
  where
    signatory owner

    nonconsuming choice PublishThenRollBack : ()
      with
        emitterCid   : ContractId Emitter
        coreStateCid : ContractId CoreState
      controller owner
      do
        try do
          (_, rolledBackMessage) <- exercise emitterCid PublishMessage with
            nonce = 91, payload = "0bad", consistencyLevel = 0
            coreStateCid, payer = owner, feeAllocation = None
          throw (GeneralError ("red team rollback of sequence " <> show rolledBackMessage.sequence))
        catch
          GeneralError _ -> pure ()

-- | A stream that surfaced rolled-back publishes would yield two VAAs for one
-- (emitter, sequence). The engine rejects the rollback of the consuming
-- PublishMessage, and the emitter keeps sequence 0.
testRedTeamR1RollbackOfPublishRejected : Script ()
testRedTeamR1RollbackOfPublishRejected = do
  (operator, _, coreStateCid) <- setup
  owner <- allocateParty "RedTeamRollbackOwner"
  emitterCid <- registerEmitter operator owner
  publisherCid <- submit owner do createCmd RollbackPublisher with owner
  coreStateDisclosure <- fromSome <$> queryDisclosure operator coreStateCid
  rollbackResult <- trySubmit (actAs owner <> disclose coreStateDisclosure) do
    exerciseCmd publisherCid PublishThenRollBack with emitterCid, coreStateCid
  checkAttackFailedWith "R1 rolled-back publish" "rollback" rollbackResult
  (_, committedMessage) <- publishVia operator coreStateCid owner emitterCid 92 "600d" 0
  committedMessage.sequence === 0
