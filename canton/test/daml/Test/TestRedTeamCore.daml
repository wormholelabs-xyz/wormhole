----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

-- | Keys of set 1 that the upgrade does not carry over: devnet key 0 is a set 0 member.
set1NewGuardianPublicKeys : [GuardianPublicKey]
set1NewGuardianPublicKeys = [redTeamGuardianPubKey1, redTeamGuardianPubKey2, redTeamGuardianPubKey3]

checkAttackFailedWith : Text -> Text -> Either SubmitError a -> Script ()
checkAttackFailedWith attack expectedSubstring submitResult = do
  assertMsg (attack <> ": the expected failure text is empty") (expectedSubstring /= "")
  case submitResult of
    Left (FailureStatusError failureStatus) ->
      assertMsg (attack <> ": expected failure containing '" <> expectedSubstring <> "', got: " <> failureStatus.message)
        (expectedSubstring `T.isInfixOf` failureStatus.message)
    Left otherError ->
      assertMsg (attack <> ": expected failure containing '" <> expectedSubstring <> "', got: " <> show otherError)
        (expectedSubstring `T.isInfixOf` show otherError)
    Right _ -> abort (attack <> ": attack succeeded")

isAttackAccepted : Either SubmitError a -> Bool
isAttackAccepted submitResult = case submitResult of
  Left _ -> False
  Right _ -> True

-- | Aborts with every accepted attack name, so one run reports all of them.
checkNoAttackAccepted : Text -> [Text] -> Script ()
checkNoAttackAccepted finding acceptedAttacks =
  assertMsg (finding <> ": attacks accepted: " <> show acceptedAttacks) (null acceptedAttacks)

submitGovernance : Party -> ContractId CoreState -> EncodedVaa -> Script (ContractId CoreState)
submitGovernance submitter coreStateCid encodedVAA = submit submitter do
  exerciseCmd coreStateCid SubmitGovernanceVAA with submitter, encodedVAA

checkGovernanceRejectedWith : Text -> Text -> Party -> ContractId CoreState -> EncodedVaa -> Script ()
checkGovernanceRejectedWith attack expectedSubstring submitter coreStateCid encodedVAA = do
  submitResult <- trySubmit submitter do
    exerciseCmd coreStateCid SubmitGovernanceVAA with submitter, encodedVAA
  checkAttackFailedWith attack expectedSubstring submitResult

verifyVAA : Party -> ContractId CoreState -> EncodedVaa -> Script VAA
verifyVAA verifier coreStateCid encodedVAA = submit verifier do
  exerciseCmd coreStateCid ParseAndVerifyVAA with verifier, encodedVAA

checkVerifyRejectedWith : Text -> Text -> Party -> ContractId CoreState -> EncodedVaa -> Script ()
checkVerifyRejectedWith attack expectedSubstring verifier coreStateCid encodedVAA = do
  submitResult <- trySubmit verifier do
    exerciseCmd coreStateCid ParseAndVerifyVAA with verifier, encodedVAA
  checkAttackFailedWith attack expectedSubstring submitResult

-- | Applies 'rtGuardianSetUpgradeToSet1', then attaches the keys of its new guardians.
upgradeToSet1 : Party -> ContractId CoreState -> Script (ContractId CoreState)
upgradeToSet1 guardianGovernance coreStateCid = do
  upgradedCid <- submitGovernance guardianGovernance coreStateCid rtGuardianSetUpgradeToSet1
  Some upgradedState <- queryContractId guardianGovernance upgradedCid
  upgradedState.guardianSetIndex === 1
  attachedPublicKeyCount (fromSome (Map.lookup 1 upgradedState.guardianSets)) === 1
  set1CoreStateCid <- submit guardianGovernance do
    exerciseCmd upgradedCid AttachGuardianPublicKeys with
      submitter = guardianGovernance, targetGuardianSetIndex = 1, guardianPublicKeys = set1NewGuardianPublicKeys
  Some set1CoreState <- queryContractId guardianGovernance set1CoreStateCid
  attachedPublicKeyCount (fromSome (Map.lookup 1 set1CoreState.guardianSets)) === 4
  pure set1CoreStateCid

-- | @byteCount@ bytes of 0xab.
hexPayloadOfBytes : Int -> MessagePayload
hexPayloadOfBytes byteCount = parseHexTextOrAbort (mconcat (replicate byteCount "ab"))

encodedVaaByteLength : EncodedVaa -> Int
encodedVaaByteLength encodedVaa = byteLength (hexBytesOf encodedVaa)

replaceVaaByteAt : Int -> Int -> EncodedVaa -> EncodedVaa
replaceVaaByteAt byteOffset replacementByte encodedVaa =
  let encoded = hexBytesOf encodedVaa
  in parseHexBytesAsOrAbort (sliceBytes 0 byteOffset encoded <> intToHexByte replacementByte <> sliceFrom (byteOffset + 1) encoded)

oneZeroBytePayload : MessagePayload
oneZeroBytePayload = parseHexTextOrAbort "00"

takeVaaBytes : Int -> EncodedVaa -> EncodedVaa
takeVaaBytes byteCount encodedVaa = parseHexBytesAsOrAbort (sliceBytes 0 byteCount (hexBytesOf encodedVaa))

appendVaaBytes : EncodedVaa -> HexBytes -> EncodedVaa
appendVaaBytes encodedVaa suffixBytes = parseHexBytesAsOrAbort (hexBytesOf encodedVaa <> suffixBytes)

----------------------------------------------------------------------
-- A1: fee bypass
----------------------------------------------------------------------

-- | A fee-charging registry or a raised message fee cannot be skipped by
-- omitting the CoreState or the allocation. Shadow-CoreState redirection on all
-- three paths: Test.TestFees.test*PinsGuardianGovernance.
testRedTeamA1FeeCannotBeSkipped : Script ()
testRedTeamA1FeeCannotBeSkipped = do
  (guardianGovernance, coreStateCid) <- setup
  registrant <- allocateParty "RedTeamFeeRegistrant"
  emitterCid <- registerEmitter guardianGovernance registrant
  let registryParties = RegistryParties with guardianGovernance, onboardingFeeAdmin = guardianGovernance
  feeRegistryCid <- submit guardianGovernance do
    createCmd (mkInitialEmitterRegistry registryParties 500)
  feeRegistryDisclosure <- fromSome <$> queryDisclosure guardianGovernance feeRegistryCid
  registerResult <- trySubmit (actAs registrant <> disclose feeRegistryDisclosure) do
    exerciseCmd feeRegistryCid RegisterEmitter with
      requester = registrant, payer = registrant, coreStateCid = None, feeAllocation = None
      expectedGuardianGovernance = guardianGovernance
  checkAttackFailedWith "A1 RegisterEmitter without CoreState" "registration fee due" registerResult

  feeRootRegistryCid <- submit guardianGovernance do
    createCmd (mkInitialReplayRootRegistry registryParties 300)
  feeRootRegistryDisclosure <- fromSome <$> queryDisclosure guardianGovernance feeRootRegistryCid
  (claimedRootsNodeCid, claimedRootsNodeDisclosure) <- claimedRootsNodeCovering guardianGovernance registrant "redteam"
  claimResult <- trySubmit (actAs registrant <> disclose feeRootRegistryDisclosure <> disclose claimedRootsNodeDisclosure) do
    exerciseCmd feeRootRegistryCid ClaimReplayRoot with
      consumer = registrant, namespace = "redteam", splitThreshold = 4
      payer = registrant, coreStateCid = None, feeAllocation = None
      expectedGuardianGovernance = guardianGovernance, claimedRootsNodeCid
  checkAttackFailedWith "A1 ClaimReplayRoot without CoreState" "claim fee due" claimResult

  feeCoreStateCid <- submitGovernance guardianGovernance coreStateCid govSetFeeVAA
  coreStateDisclosure <- fromSome <$> queryDisclosure guardianGovernance feeCoreStateCid
  publishResult <- trySubmit (actAs registrant <> disclose coreStateDisclosure) do
    exerciseCmd emitterCid PublishMessage with
      nonce = 0, payload = parseHexTextOrAbort "00", consistencyLevel = 0
      coreStateCid = feeCoreStateCid, payer = registrant, feeAllocation = None
  checkAttackFailedWith "A1 PublishMessage without allocation" "fee required" publishResult

----------------------------------------------------------------------
-- A6: guardian set
----------------------------------------------------------------------

testRedTeamA6GuardianSetUpgradeRules : Script ()
testRedTeamA6GuardianSetUpgradeRules = do
  (guardianGovernance, coreStateCid) <- setup
  checkGovernanceRejectedWith "A6 upgrade skips an index" "index must be current + 1"
    guardianGovernance coreStateCid rtGuardianSetUpgradeSkipsIndex
  checkGovernanceRejectedWith "A6 upgrade to the same index" "index must be current + 1"
    guardianGovernance coreStateCid rtGuardianSetUpgradeSameIndex
  checkGovernanceRejectedWith "A6 upgrade from a wrong emitter chain" "wrong emitter chain"
    guardianGovernance coreStateCid rtGuardianSetUpgradeWrongEmitterChain
  checkGovernanceRejectedWith "A6 upgrade from a wrong emitter address" "wrong emitter address"
    guardianGovernance coreStateCid rtGuardianSetUpgradeWrongEmitterAddress
  checkGovernanceRejectedWith "A6 upgrade for another chain" "wrong target chain"
    guardianGovernance coreStateCid rtGuardianSetUpgradeWrongTargetChain
  checkGovernanceRejectedWith "A6 upgrade to an empty set" "empty set"
    guardianGovernance coreStateCid rtGuardianSetUpgradeEmptySet
  checkGovernanceRejectedWith "A6 upgrade with a zero address" "zero address at position 1"
    guardianGovernance coreStateCid rtGuardianSetUpgradeZeroAddress
  checkGovernanceRejectedWith "A6 upgrade to only a zero address" "zero address at position 0"
    guardianGovernance coreStateCid rtGuardianSetUpgradeOnlyZeroAddress
  checkGovernanceRejectedWith "A6 upgrade with a duplicate address" "duplicate address"
    guardianGovernance coreStateCid rtGuardianSetUpgradeDuplicateAddress

  set1CoreStateCid <- upgradeToSet1 guardianGovernance coreStateCid
  checkGovernanceRejectedWith "A6 upgrade to a lower index" "index must be current + 1"
    guardianGovernance set1CoreStateCid rtGuardianSetUpgradeLowerIndexBySet1
  checkGovernanceRejectedWith "A6 replay of the applied upgrade" "not signed by current guardian set"
    guardianGovernance set1CoreStateCid rtGuardianSetUpgradeToSet1

testRedTeamA6QuorumAndSignerOrder : Script ()
testRedTeamA6QuorumAndSignerOrder = do
  (guardianGovernance, coreStateCid) <- setup
  set1CoreStateCid <- upgradeToSet1 guardianGovernance coreStateCid
  checkGovernanceRejectedWith "A6 two of four signatures" "no quorum"
    guardianGovernance set1CoreStateCid rtSetMessageFeeBySet1BelowQuorum
  checkGovernanceRejectedWith "A6 duplicate signer index" "strictly ascending"
    guardianGovernance set1CoreStateCid rtSetMessageFeeBySet1DuplicateSigner
  checkGovernanceRejectedWith "A6 signatures out of order" "strictly ascending"
    guardianGovernance set1CoreStateCid rtSetMessageFeeBySet1SignersOutOfOrder
  checkGovernanceRejectedWith "A6 key 3 signs as guardian 0" "invalid signature for guardian index 0"
    guardianGovernance set1CoreStateCid rtSetMessageFeeBySet1WrongKeyAtIndex
  attachKey3AgainResult <- trySubmit guardianGovernance do
    exerciseCmd set1CoreStateCid AttachGuardianPublicKeys with
      submitter = guardianGovernance, targetGuardianSetIndex = 1, guardianPublicKeys = [redTeamGuardianPubKey3]
  checkAttackFailedWith "A6 key 3 attached a second time" "attach: public key already attached at position 3"
    attachKey3AgainResult
  checkGovernanceRejectedWith "A6 signer index out of range" "guardian index out of range"
    guardianGovernance set1CoreStateCid rtSetMessageFeeBySet1IndexOutOfRange
  supersededSetVAA <- verifyVAA guardianGovernance set1CoreStateCid rtSetMessageFeeBySet0AfterUpgrade
  supersededSetVAA.guardianSetIndex === 0
  checkGovernanceRejectedWith "A6 governance by the superseded set" "not signed by current guardian set"
    guardianGovernance set1CoreStateCid rtSetMessageFeeBySet0AfterUpgrade

  feeCoreStateCid <- submitGovernance guardianGovernance set1CoreStateCid rtSetMessageFeeBySet1Quorum
  Some feeCoreState <- queryContractId guardianGovernance feeCoreStateCid
  feeCoreState.messageFee === 7

-- | The superseded set verifies application VAAs through the whole expiry second
-- (EVM @Messages.sol@: rejects only when @expirationTime < block.timestamp@,
-- with @block.timestamp@ in whole seconds).
testRedTeamA6ExpiredGuardianSet : Script ()
testRedTeamA6ExpiredGuardianSet = do
  (guardianGovernance, coreStateCid) <- setup
  set1CoreStateCid <- upgradeToSet1 guardianGovernance coreStateCid
  verifiedAtUpgrade <- verifyVAA guardianGovernance set1CoreStateCid rtAppMessageBySet0
  verifiedAtUpgrade.guardianSetIndex === 0
  passTime (seconds guardianSetExpirySeconds)
  verifiedAtExpiry <- verifyVAA guardianGovernance set1CoreStateCid rtAppMessageBySet0
  verifiedAtExpiry.guardianSetIndex === 0
  passTime (microseconds 999999)
  verifiedAtLastMicrosecond <- verifyVAA guardianGovernance set1CoreStateCid rtAppMessageBySet0
  verifiedAtLastMicrosecond.guardianSetIndex === 0
  passTime (microseconds 1)
  checkVerifyRejectedWith "A6 VAA signed by an expired set" "guardian set has expired"
    guardianGovernance set1CoreStateCid rtAppMessageBySet0

----------------------------------------------------------------------
-- A9: malformed VAAs
----------------------------------------------------------------------

testRedTeamA9MalformedEncodings : Script ()
testRedTeamA9MalformedEncodings = do
  (guardianGovernance, coreStateCid) <- setup
  _ <- verifyVAA guardianGovernance coreStateCid govSetFeeVAA
  let malformedCases =
        -- Odd length, 0x prefix, non-hex and inputs under 57 bytes are
        -- unrepresentable in 'EncodedVaa': Test.TestByteTypes and
        -- canton/test/forged_byte_values_test.sh cover them.
        [ ("A9 truncated signature", "sliceBytes: out of range", takeVaaBytes 60 govSetFeeVAA)
        , ("A9 body missing its last byte", "invalid signature", takeVaaBytes (encodedVaaByteLength govSetFeeVAA - 1) govSetFeeVAA)
        , ("A9 extra trailing byte", "invalid signature", appendVaaBytes govSetFeeVAA (intToHexByte 0))
        , ("A9 signature count zero", "ArithmeticError", replaceVaaByteAt 5 0 govSetFeeVAA)
        , ("A9 signature count two", "invalid signature", replaceVaaByteAt 5 2 govSetFeeVAA)
        , ("A9 version two", "unsupported VAA version", replaceVaaByteAt 0 2 govSetFeeVAA)
        , ("A9 version zero", "unsupported VAA version", replaceVaaByteAt 0 0 govSetFeeVAA)
        ]
  forA_ malformedCases \(attack, expectedSubstring, encodedVAA) ->
    checkVerifyRejectedWith attack expectedSubstring guardianGovernance coreStateCid encodedVAA
  forA_ malformedCases \(attack, expectedSubstring, encodedVAA) ->
    checkGovernanceRejectedWith (attack <> " (governance)") expectedSubstring guardianGovernance coreStateCid encodedVAA

testRedTeamA9MalformedGovernancePayloads : Script ()
testRedTeamA9MalformedGovernancePayloads = do
  (guardianGovernance, coreStateCid) <- setup
  checkGovernanceRejectedWith "A9 TokenBridge module" "not the Core module"
    guardianGovernance coreStateCid rtSetMessageFeeWrongModule
  checkGovernanceRejectedWith "A9 RecoverChainId action" "unsupported action 5"
    guardianGovernance coreStateCid rtRecoverChainIDUnsupported
  checkGovernanceRejectedWith "A9 empty governance payload" "packet must be at least 35 bytes"
    guardianGovernance coreStateCid rtGovernanceEmptyPayload
  checkGovernanceRejectedWith "A9 truncated ContractUpgrade" "ContractUpgrade packet must be 67 bytes"
    guardianGovernance coreStateCid rtContractUpgradeTruncated
  checkGovernanceRejectedWith "A9 SetMessageFee of 2^64" "governance: SetMessageFee fee exceeds the Int range"
    guardianGovernance coreStateCid rtSetMessageFeeOverflowsInt64

-- | EVM GovernanceStructs.sol requires @encoded.length == index@ for every
-- action; a guardian-signed packet with trailing bytes must not apply.
testRedTeamA9GovernancePayloadExactLength : Script ()
testRedTeamA9GovernancePayloadExactLength = do
  (setFeeGovernance, setFeeCoreStateCid) <- setup
  setFeeResult <- trySubmit setFeeGovernance do
    exerciseCmd setFeeCoreStateCid SubmitGovernanceVAA with
      submitter = setFeeGovernance, encodedVAA = rtSetMessageFeeTrailingByte
  (upgradeGovernance, upgradeCoreStateCid) <- setup
  upgradeResult <- trySubmit upgradeGovernance do
    exerciseCmd upgradeCoreStateCid SubmitGovernanceVAA with
      submitter = upgradeGovernance, encodedVAA = rtGuardianSetUpgradeTrailingByte
  checkNoAttackAccepted "A9 governance payload with a trailing byte"
    ([ "SetMessageFee" | isAttackAccepted setFeeResult ] <> [ "GuardianSetUpgrade" | isAttackAccepted upgradeResult ])

-- | Runs 'parseGovernance' in a transaction so its abort is a submit error.
template GovernancePacketParser
  with
    parser : Party
  where
    signatory parser

    nonconsuming choice ParseGovernancePacket : GovernanceAction
      with
        packet : MessagePayload
      controller parser
      do pure (parseGovernance packet)

coreGovernanceHeader : Int -> HexBytes
coreGovernanceHeader action = coreModule <> intToBytesN action 1 <> intToBytesN 75 2

guardianSetUpgradePacket : Int -> [HexBytes] -> HexBytes
guardianSetUpgradePacket declaredKeyCount guardianKeys =
  coreGovernanceHeader 2 <> intToBytesN 1 4 <> intToBytesN declaredKeyCount 1 <> mconcat guardianKeys

-- | The uint256 SetMessageFee fee and TransferFees amount parse only below 2^63
-- (Daml Int max + 1); each larger word aborts with the field's range error.
testParseGovernanceBoundsUint256AmountsToInt : Script ()
testParseGovernanceBoundsUint256AmountsToInt = do
  parser <- allocateParty "GovernanceAmountParser"
  parserCid <- submit parser do createCmd GovernancePacketParser with parser
  let repeatedBytes count byteHex = parseHexTextOrAbort @HexBytes (mconcat (replicate count byteHex))
      maxIntAmount = 9223372036854775807
      maxIntWord = intToBytesN maxIntAmount 32
      twoPow63Word = repeatedBytes 24 "00" <> intToHexByte 128 <> repeatedBytes 7 "00"
      twoPow64Word = repeatedBytes 23 "00" <> intToHexByte 1 <> repeatedBytes 8 "00"
      twoPow255Word = intToHexByte 128 <> repeatedBytes 31 "00"
      maxUint256Word = repeatedBytes 32 "ff"
      recipient = repeatedBytes 32 "d4"
      setMessageFeePacket feeWord = coreGovernanceHeader 3 <> feeWord
      transferFeesPacket amountWord = coreGovernanceHeader 4 <> amountWord <> recipient
      parsePacket packetBytes = trySubmit parser do
        exerciseCmd parserCid ParseGovernancePacket with packet = parseHexBytesAsOrAbort packetBytes
      acceptedCases =
        [ ("SetMessageFee 0", setMessageFeePacket (intToBytesN 0 32), SetMessageFee with chain = 75, fee = 0)
        , ("SetMessageFee 2^63 - 1", setMessageFeePacket maxIntWord, SetMessageFee with chain = 75, fee = maxIntAmount)
        , ("TransferFees 0", transferFeesPacket (intToBytesN 0 32)
          , TransferFees with chain = 75, amount = 0, recipient = parseHexBytesAsOrAbort recipient)
        , ("TransferFees 2^63 - 1", transferFeesPacket maxIntWord
          , TransferFees with chain = 75, amount = maxIntAmount, recipient = parseHexBytesAsOrAbort recipient)
        ]
      oversizedWords =
        [ ("2^63", twoPow63Word)
        , ("2^64", twoPow64Word)
        , ("2^255", twoPow255Word)
        , ("2^256 - 1", maxUint256Word)
        ]
      rejectedCases =
        [ ("SetMessageFee " <> wordName, "governance: SetMessageFee fee exceeds the Int range", setMessageFeePacket amountWord)
        | (wordName, amountWord) <- oversizedWords ] ++
        [ ("TransferFees " <> wordName, "governance: TransferFees amount exceeds the Int range", transferFeesPacket amountWord)
        | (wordName, amountWord) <- oversizedWords ]
  byteLength maxIntWord === uint256WordBytes
  maxGovernanceAmount === maxIntAmount
  intToBytesN maxGovernanceAmount intWordBytes === parseHexTextOrAbort "7fffffffffffffff"
  forA_ acceptedCases \(caseName, packetBytes, expectedAction) -> do
    parseResult <- parsePacket packetBytes
    case parseResult of
      Right parsedAction -> parsedAction === expectedAction
      Left parseError -> abort (caseName <> ": rejected: " <> show parseError)
  forA_ rejectedCases \(caseName, expectedSubstring, packetBytes) -> do
    parseResult <- parsePacket packetBytes
    checkAttackFailedWith caseName expectedSubstring parseResult

-- | Exact packet lengths of sdk/vaa/payloads.go: ContractUpgrade 67,
-- GuardianSetUpgrade 40 + 20 * keys, SetMessageFee 67, TransferFees 99.
testParseGovernanceRequiresExactPacketLength : Script ()
testParseGovernanceRequiresExactPacketLength = do
  parser <- allocateParty "GovernancePacketParser"
  parserCid <- submit parser do createCmd GovernancePacketParser with parser
  let repeatedBytes count byteHex = parseHexTextOrAbort @HexBytes (mconcat (replicate count byteHex))
      takeBytes count packetBytes = sliceBytes 0 count packetBytes
      guardianKeyA = repeatedBytes 20 "aa"
      guardianKeyB = repeatedBytes 20 "bb"
      contractUpgrade = coreGovernanceHeader 1 <> repeatedBytes 32 "c1"
      setMessageFee = coreGovernanceHeader 3 <> intToBytesN 7 32
      transferFees = coreGovernanceHeader 4 <> intToBytesN 9 32 <> repeatedBytes 32 "d4"
      parsePacket packetBytes = trySubmit parser do
        exerciseCmd parserCid ParseGovernancePacket with packet = parseHexBytesAsOrAbort packetBytes
      acceptedCases =
        [ (contractUpgrade, ContractUpgrade with chain = 75, newContract = parseHexBytesAsOrAbort (repeatedBytes 32 "c1"))
        , (guardianSetUpgradePacket 1 [guardianKeyA], GuardianSetUpgrade with chain = 75, newIndex = 1, newKeys = map parseHexBytesAsOrAbort [guardianKeyA])
        , (guardianSetUpgradePacket 2 [guardianKeyA, guardianKeyB], GuardianSetUpgrade with chain = 75, newIndex = 1, newKeys = map parseHexBytesAsOrAbort [guardianKeyA, guardianKeyB])
        , (setMessageFee, SetMessageFee with chain = 75, fee = 7)
        , (transferFees, TransferFees with chain = 75, amount = 9, recipient = parseHexBytesAsOrAbort (repeatedBytes 32 "d4"))
        ]
      -- An odd trailing nibble is unrepresentable in 'MessagePayload' (Test.TestByteTypes).
      rejectedCases =
        [ ("ContractUpgrade plus one byte", "ContractUpgrade packet must be 67 bytes", contractUpgrade <> intToHexByte 0)
        , ("ContractUpgrade minus one byte", "ContractUpgrade packet must be 67 bytes", takeBytes 66 contractUpgrade)
        , ("header minus one byte", "packet must be at least 35 bytes", takeBytes 34 contractUpgrade)
        , ("GuardianSetUpgrade without its key count", "GuardianSetUpgrade packet must be at least 40 bytes", takeBytes 39 (guardianSetUpgradePacket 1 []))
        , ("GuardianSetUpgrade plus one byte", "GuardianSetUpgrade packet must be 60 bytes", guardianSetUpgradePacket 1 [guardianKeyA] <> intToHexByte 0)
        , ("GuardianSetUpgrade plus one undeclared key", "GuardianSetUpgrade packet must be 60 bytes", guardianSetUpgradePacket 1 [guardianKeyA, guardianKeyB])
        , ("GuardianSetUpgrade missing a declared key", "GuardianSetUpgrade packet must be 80 bytes", guardianSetUpgradePacket 2 [guardianKeyA])
        , ("SetMessageFee plus one byte", "SetMessageFee packet must be 67 bytes", setMessageFee <> intToHexByte 0)
        , ("SetMessageFee minus one byte", "SetMessageFee packet must be 67 bytes", takeBytes 66 setMessageFee)
        , ("TransferFees plus one byte", "TransferFees packet must be 99 bytes", transferFees <> intToHexByte 0)
        , ("TransferFees minus one byte", "TransferFees packet must be 99 bytes", takeBytes 98 transferFees)
        ]
  forA_ acceptedCases \(packetBytes, expectedAction) -> do
    parsedAction <- submit parser do
      exerciseCmd parserCid ParseGovernancePacket with packet = parseHexBytesAsOrAbort packetBytes
    parsedAction === expectedAction
  forA_ rejectedCases \(attack, expectedSubstring, packetBytes) -> do
    parseResult <- parsePacket packetBytes
    checkAttackFailedWith attack expectedSubstring parseResult

testRedTeamA9EmptyApplicationPayloadVerifies : Script ()
testRedTeamA9EmptyApplicationPayloadVerifies = do
  (guardianGovernance, coreStateCid) <- setup
  verified <- verifyVAA guardianGovernance coreStateCid rtAppMessageEmptyPayloadBySet0
  verified.payload === parseHexTextOrAbort ""
  verified.sequence === 2

-- | No core bridge caps the payload size. Each size publishes and takes the
-- next sequence.
testRedTeamA9PublishAcceptsAnyPayloadSize : Script ()
testRedTeamA9PublishAcceptsAnyPayloadSize = do
  (guardianGovernance, coreStateCid) <- setup
  owner <- allocateParty "RedTeamPayloadSizeOwner"
  emitterCid <- registerEmitter guardianGovernance owner
  let payloadByteCounts = [0, 750, 751, 65536]
      publishPayloadOfBytes (currentEmitterCid, expectedSequence) payloadByteCount = do
        (successorCid, message) <- publishVia guardianGovernance coreStateCid owner currentEmitterCid 0 (hexPayloadOfBytes payloadByteCount) 0
        message.payload === hexPayloadOfBytes payloadByteCount
        message.sequence === expectedSequence
        pure (successorCid, expectedSequence + 1)
  (_, nextSequence) <- foldlA publishPayloadOfBytes (emitterCid, 0) payloadByteCounts
  nextSequence === length payloadByteCounts

-- | The watcher drops a message whose nonce / consistency level is outside
-- uint32 / uint8 (cantongrpc.go decodeWormholeMessage). PublishMessage must
-- reject them: an accepted one consumes a sequence number the guardians never
-- sign. Malformed payloads: canton/test/forged_byte_values_test.sh.
testRedTeamA9PublishRejectsFieldsTheWatcherDrops : Script ()
testRedTeamA9PublishRejectsFieldsTheWatcherDrops = do
  (guardianGovernance, coreStateCid) <- setup
  owner <- allocateParty "RedTeamUndecodableOwner"
  emitterCid <- registerEmitter guardianGovernance owner
  coreStateDisclosure <- fromSome <$> queryDisclosure guardianGovernance coreStateCid
  let undecodableCases =
        [ ("nonce 2^32", 4294967296, oneZeroBytePayload, 0)
        , ("negative nonce", -1, oneZeroBytePayload, 0)
        , ("consistency level 256", 0, oneZeroBytePayload, 256)
        , ("negative consistency level", 0, oneZeroBytePayload, -1)
        ]
      tryPublish (currentEmitterCid, acceptedAttacks) (attack, nonce, payload, consistencyLevel) = do
        publishResult <- trySubmit (actAs owner <> disclose coreStateDisclosure) do
          exerciseCmd currentEmitterCid PublishMessage with
            nonce, payload, consistencyLevel
            coreStateCid, payer = owner, feeAllocation = None
        pure $ case publishResult of
          Right (successorCid, _) -> (successorCid, acceptedAttacks <> [attack])
          Left _ -> (currentEmitterCid, acceptedAttacks)
  (_, acceptedAttacks) <- foldlA tryPublish (emitterCid, []) undecodableCases
  checkNoAttackAccepted "A9 PublishMessage fields the watcher drops" acceptedAttacks

-- | Each field at its wire boundary publishes; one step past it aborts with a
-- named reason, and a rejected publish does not advance the sequence.
testRedTeamA9PublishFieldBoundaries : Script ()
testRedTeamA9PublishFieldBoundaries = do
  (guardianGovernance, coreStateCid) <- setup
  owner <- allocateParty "RedTeamFieldBoundaryOwner"
  emitterCid <- registerEmitter guardianGovernance owner
  coreStateDisclosure <- fromSome <$> queryDisclosure guardianGovernance coreStateCid
  let rejectedCases =
        [ ("nonce 2^32", "nonce exceeds uint32", 4294967296, oneZeroBytePayload, 0)
        , ("nonce -1", "nonce is negative", -1, oneZeroBytePayload, 0)
        , ("consistency level 256", "consistency level exceeds uint8", 0, oneZeroBytePayload, 256)
        , ("consistency level -1", "consistency level is negative", 0, oneZeroBytePayload, -1)
        ]
  forA_ rejectedCases \(attack, expectedSubstring, nonce, payload, consistencyLevel) -> do
    publishResult <- trySubmit (actAs owner <> disclose coreStateDisclosure) do
      exerciseCmd emitterCid PublishMessage with
        nonce, payload, consistencyLevel
        coreStateCid, payer = owner, feeAllocation = None
    checkAttackFailedWith ("A9 " <> attack) expectedSubstring publishResult
  (emitterAfterMaxima, maximaMessage) <- publishVia guardianGovernance coreStateCid owner emitterCid 4294967295 oneZeroBytePayload 255
  (maximaMessage.sequence, maximaMessage.nonce, maximaMessage.consistencyLevel) === (0, 4294967295, 255)
  (_, minimaMessage) <- publishVia guardianGovernance coreStateCid owner emitterAfterMaxima 0 (parseHexTextOrAbort "") 0
  (minimaMessage.sequence, minimaMessage.nonce, minimaMessage.consistencyLevel) === (1, 0, 0)

----------------------------------------------------------------------
-- A14: Emitter created outside RegisterEmitter
----------------------------------------------------------------------

testRedTeamA14PartyWithNoRoleCannotForgeThirdPartyEmitter : Script ()
testRedTeamA14PartyWithNoRoleCannotForgeThirdPartyEmitter = do
  (guardianGovernance, _) <- setup
  partyWithNoRole <- allocateParty "RedTeamPartyWithNoRole"
  victim <- allocateParty "RedTeamVictimOwner"
  accomplice <- allocateParty "RedTeamAccomplice"
  victimEmitterCid <- registerEmitter guardianGovernance victim
  Some victimEmitter <- queryContractId victim victimEmitterCid
  let forgedVictimEmitter = victimEmitter with sequence = 0
  forA_ [ ("party with no role alone", actAs partyWithNoRole)
        , ("party with no role and accomplice", actAs partyWithNoRole <> actAs accomplice)
        , ("party with no role and guardianGovernance", actAs partyWithNoRole <> actAs guardianGovernance) ]
    \(forgers, forgerAuthority) -> do
      forgeResult <- trySubmit forgerAuthority do createCmd forgedVictimEmitter
      checkAttackFailedWith ("A14 " <> forgers <> " creates the victim's emitter") "Authorization failure" forgeResult

-- | guardianGovernance co-signs every 'Emitter' (A14-2), so an owner without
-- guardianGovernance cannot create one outside 'RegisterEmitter': a rewound
-- duplicate of an issued identity is refused.
testRedTeamA14ColludingOwnerCannotDuplicateEmitter : Script ()
testRedTeamA14ColludingOwnerCannotDuplicateEmitter = do
  (guardianGovernance, coreStateCid) <- setup
  partyWithNoRole <- allocateParty "RedTeamPartyWithNoRole"
  colludingOwner <- allocateParty "RedTeamColludingOwner"
  colludingEmitterCid <- registerEmitter guardianGovernance colludingOwner
  partyWithNoRoleEmitterCid <- registerEmitter guardianGovernance partyWithNoRole
  (_, firstMessage) <- publishVia guardianGovernance coreStateCid colludingOwner colludingEmitterCid 1 (parseHexTextOrAbort "aa") 0
  (_, partyWithNoRoleMessage) <- publishVia guardianGovernance coreStateCid partyWithNoRole partyWithNoRoleEmitterCid 2 (parseHexTextOrAbort "bb") 0
  let rewoundEmitterOf owner message = Emitter with
        guardianGovernance, owner
        emitterId = message.emitterId
        emitterAddress = emitterAddressFor guardianGovernance owner message.emitterId
        sequence = message.sequence
      duplicateAttempts =
        [ ("owner alone", actAs colludingOwner, rewoundEmitterOf colludingOwner firstMessage)
        , ("party with no role and owner", actAs partyWithNoRole <> actAs colludingOwner, rewoundEmitterOf colludingOwner firstMessage)
        , ("party with no role as its own owner", actAs partyWithNoRole, rewoundEmitterOf partyWithNoRole partyWithNoRoleMessage)
        , ("party with no role and guardianGovernance", actAs partyWithNoRole <> actAs guardianGovernance,
            rewoundEmitterOf colludingOwner firstMessage)
        ]
  forA_ duplicateAttempts \(colluders, colluderAuthority, rewoundEmitter) -> do
    duplicateResult <- trySubmit colluderAuthority do createCmd rewoundEmitter
    checkAttackFailedWith ("A14 " <> colluders <> " duplicates an issued emitter") "Authorization failure" duplicateResult
  guardianVisibleEmitters <- query @Emitter guardianGovernance
  length (filter (\(_, emitter) -> emitter.owner == colludingOwner) guardianVisibleEmitters) === 1
  length (filter (\(_, emitter) -> emitter.owner == partyWithNoRole) guardianVisibleEmitters) === 1

-- | Exactly the owner and guardianGovernance sign an 'Emitter': both together
-- can create one directly.
testRedTeamA14EmitterSignatoriesAreOwnerAndGovernance : Script ()
testRedTeamA14EmitterSignatoriesAreOwnerAndGovernance = do
  (guardianGovernance, _) <- setup
  owner <- allocateParty "RedTeamSignatoryOwner"
  emitterCid <- submit (actAs owner <> actAs guardianGovernance) do
    createCmd Emitter with
      guardianGovernance, owner
      emitterId = 0
      emitterAddress = emitterAddressFor guardianGovernance owner 0
      sequence = 0
  Some emitter <- queryContractId guardianGovernance emitterCid
  sort (signatory emitter) === sort [owner, guardianGovernance]

-- | A registry reset with a reused id would give an honest owner's second
-- emitter the address and sequence 0 of its first. guardianGovernance is the
-- only signatory of 'EmitterRegistry', so a party with no role cannot create one
-- that names the real guardianGovernance. A registry under a rogue
-- guardianGovernance needs the rogue party's signature, and its emitters abort
-- on the real 'CoreState' pin:
-- Test.TestGuardianVisibility.testRogueGovernanceEmitterCannotPublishOnRealCoreState.
testRedTeamA14PartyWithNoRoleCannotResetEmitterRegistry : Script ()
testRedTeamA14PartyWithNoRoleCannotResetEmitterRegistry = do
  (guardianGovernance, coreStateCid) <- setup
  partyWithNoRole <- allocateParty "RedTeamPartyWithNoRole"
  honestOwner <- allocateParty "RedTeamHonestOwner"
  firstEmitterCid <- registerEmitter guardianGovernance honestOwner
  let registryParties = RegistryParties with guardianGovernance, onboardingFeeAdmin = partyWithNoRole
  resetResult <- trySubmit (actAs partyWithNoRole) do
    createCmd (mkInitialEmitterRegistry registryParties 0)
  checkAttackFailedWith "A14 party with no role resets the EmitterRegistry" "Authorization failure" resetResult

  [(realRegistryCid, realRegistry)] <- query @EmitterRegistry guardianGovernance
  realRegistry.nextId === 1
  realRegistryDisclosure <- fromSome <$> queryDisclosure guardianGovernance realRegistryCid
  let partyWithNoRoleAttacks =
        [ ("archives the real EmitterRegistry", void <$> trySubmit (actAs partyWithNoRole <> disclose realRegistryDisclosure) do
            archiveCmd realRegistryCid)
        , ("sets the registration fee on the real EmitterRegistry", void <$> trySubmit (actAs partyWithNoRole <> disclose realRegistryDisclosure) do
            exerciseCmd realRegistryCid SetRegistrationFee with newRegistrationFee = 0)
        ]
  forA_ partyWithNoRoleAttacks \(attack, runAttack) -> do
    attackResult <- runAttack
    checkAttackFailedWith ("A14 party with no role " <> attack) "Authorization failure" attackResult
  [(survivingRegistryCid, survivingRegistry)] <- query @EmitterRegistry guardianGovernance
  survivingRegistryCid === realRegistryCid
  survivingRegistry.nextId === 1

  secondEmitterCid <- registerEmitter guardianGovernance honestOwner
  (_, firstMessage) <- publishVia guardianGovernance coreStateCid honestOwner firstEmitterCid 1 (parseHexTextOrAbort "aa") 0
  (_, secondMessage) <- publishVia guardianGovernance coreStateCid honestOwner secondEmitterCid 2 (parseHexTextOrAbort "bb") 0
  firstMessage.emitterId === 0
  secondMessage.emitterId === 1
  assert (emitterAddressFor guardianGovernance honestOwner secondMessage.emitterId
            /= emitterAddressFor guardianGovernance honestOwner firstMessage.emitterId)

-- | A registry create or archive needs guardianGovernance: guardianGovernance
-- alone succeeds, a stranger fails.
testRedTeamA14RegistryNeedsGuardianGovernance : Script ()
testRedTeamA14RegistryNeedsGuardianGovernance = do
  (guardianGovernance, _) <- setup
  stranger <- allocateParty "RedTeamRegistryStranger"
  [(realRegistryCid, _)] <- query @EmitterRegistry guardianGovernance
  realRegistryDisclosure <- fromSome <$> queryDisclosure guardianGovernance realRegistryCid
  let registryParties = RegistryParties with guardianGovernance, onboardingFeeAdmin = stranger
      strangerAttacks =
        [ ("creates an EmitterRegistry", void <$> trySubmit (actAs stranger) do
            createCmd (mkInitialEmitterRegistry registryParties 0))
        , ("archives the real EmitterRegistry", void <$> trySubmit (actAs stranger <> disclose realRegistryDisclosure) do
            archiveCmd realRegistryCid)
        ]
  forA_ strangerAttacks \(attack, runAttack) -> do
    attackResult <- runAttack
    checkAttackFailedWith ("A14 stranger " <> attack) "Authorization failure" attackResult
  [(survivingRegistryCid, _)] <- query @EmitterRegistry guardianGovernance
  survivingRegistryCid === realRegistryCid
  secondRegistryCid <- submit guardianGovernance do createCmd (mkInitialEmitterRegistry registryParties 0)
  submit guardianGovernance do archiveCmd secondRegistryCid
  submit guardianGovernance do archiveCmd realRegistryCid
  remainingRegistries <- query @EmitterRegistry guardianGovernance
  remainingRegistries === []

----------------------------------------------------------------------
-- R1: rolled-back publish
----------------------------------------------------------------------

-- | Publishes inside @try@, then throws, to make the publish a rollback node.
template RollbackPublisher
  with
    owner : Party
  where
    signatory owner

    nonconsuming choice PublishThenRollBack : ()
      with
        emitterCid   : ContractId Emitter
        coreStateCid : ContractId CoreState
      controller owner
      do
        try do
          (_, rolledBackMessage) <- exercise emitterCid PublishMessage with
            nonce = 91, payload = parseHexTextOrAbort "0bad", consistencyLevel = 0
            coreStateCid, payer = owner, feeAllocation = None
          throw (GeneralError ("red team rollback of sequence " <> show rolledBackMessage.sequence))
        catch
          GeneralError _ -> pure ()

-- | A stream that surfaced rolled-back publishes would yield two VAAs for one
-- (emitter, sequence). The engine rejects the rollback of the consuming
-- PublishMessage, and the emitter keeps sequence 0.
testRedTeamR1RollbackOfPublishRejected : Script ()
testRedTeamR1RollbackOfPublishRejected = do
  (guardianGovernance, coreStateCid) <- setup
  owner <- allocateParty "RedTeamRollbackOwner"
  emitterCid <- registerEmitter guardianGovernance owner
  publisherCid <- submit owner do createCmd RollbackPublisher with owner
  coreStateDisclosure <- fromSome <$> queryDisclosure guardianGovernance coreStateCid
  rollbackResult <- trySubmit (actAs owner <> disclose coreStateDisclosure) do
    exerciseCmd publisherCid PublishThenRollBack with emitterCid, coreStateCid
  checkAttackFailedWith "R1 rolled-back publish" "rollback" rollbackResult
  (_, committedMessage) <- publishVia guardianGovernance coreStateCid owner emitterCid 92 (parseHexTextOrAbort "600d") 0
  committedMessage.sequence === 0

----------------------------------------------------------------------
-- F1-core: fee registry code runs with the authority of the allocation controllers
----------------------------------------------------------------------

data FeeChargePoint = ChargeOnPublish | ChargeOnRegisterEmitter | ChargeOnClaimReplayRoot
  deriving (Eq, Show, Enum, Bounded)

allFeeChargePoints : [FeeChargePoint]
allFeeChargePoints = [minBound .. maxBound]

-- | 10^-10 units. The message fee is what 'govSetFeeVAA' sets.
feeDueAtChargePoint : FeeChargePoint -> Int
feeDueAtChargePoint chargePoint = case chargePoint of
  ChargeOnPublish -> 1000
  ChargeOnRegisterEmitter -> 500
  ChargeOnClaimReplayRoot -> 300

data MessageFeeAtSetup = MessageFeeZero | MessageFeeRaised
  deriving (Eq, Show)

-- | A bridge whose registries charge a fee, with a mock fee registry.
data PaidChargeBridge = PaidChargeBridge with
    guardianGovernance          : Party
    feeRecipient                : Party
    feeRegistryAdmin            : Party
    feeInstrument               : InstrumentId
    coreStateCid                : ContractId CoreState
    feeEmitterRegistryCid       : ContractId EmitterRegistry
    feeReplayRootRegistryCid    : ContractId ReplayRootRegistry
    publisher                   : Party
    publisherEmitterCid         : ContractId Emitter
    guardianGovernanceEmitterCid : ContractId Emitter

setupPaidChargeBridge : MessageFeeAtSetup -> Script PaidChargeBridge
setupPaidChargeBridge messageFeeAtSetup = do
  feeRegistryAdmin <- allocateParty "F1HostileFeeRegistryAdmin"
  let feeInstrument = InstrumentId with admin = feeRegistryAdmin, id = "MOCK"
  (guardianGovernance, genesisCoreStateCid) <- setupWithInstrument (Some feeInstrument)
  Some genesisCoreState <- queryContractId guardianGovernance genesisCoreStateCid
  publisher <- allocateParty "F1Publisher"
  publisherEmitterCid <- registerEmitter guardianGovernance publisher
  guardianGovernanceEmitterCid <- registerEmitter guardianGovernance guardianGovernance
  let registryParties = RegistryParties with guardianGovernance, onboardingFeeAdmin = guardianGovernance
  feeEmitterRegistryCid <- submit guardianGovernance do
    createCmd (mkInitialEmitterRegistry registryParties (feeDueAtChargePoint ChargeOnRegisterEmitter))
  feeReplayRootRegistryCid <- submit guardianGovernance do
    createCmd (mkInitialReplayRootRegistry registryParties (feeDueAtChargePoint ChargeOnClaimReplayRoot))
  coreStateCid <- case messageFeeAtSetup of
    MessageFeeZero -> pure genesisCoreStateCid
    MessageFeeRaised -> submitGovernance guardianGovernance genesisCoreStateCid govSetFeeVAA
  Some coreState <- queryContractId guardianGovernance coreStateCid
  coreState.messageFee === (if messageFeeAtSetup == MessageFeeRaised then feeDueAtChargePoint ChargeOnPublish else 0)
  pure PaidChargeBridge with
    guardianGovernance, feeRecipient = genesisCoreState.feeRecipient
    feeRegistryAdmin, feeInstrument, coreStateCid, feeEmitterRegistryCid
    feeReplayRootRegistryCid, publisher, publisherEmitterCid, guardianGovernanceEmitterCid

-- | Charges @payer@ at @chargePoint@ with @feeAllocation@. @publisher@ is the
-- emitter owner, requester or consumer. An archived registry gives a
-- contract-not-found failure.
submitPaidCharge : PaidChargeBridge -> FeeChargePoint -> Party -> (ContractId Allocation, ExtraArgs) -> [Disclosure] -> Script (Either SubmitError ())
submitPaidCharge bridge chargePoint payer feeAllocation extraDisclosures = do
  coreStateDisclosure <- fromSome <$> queryDisclosure bridge.guardianGovernance bridge.coreStateCid
  let submitOptions disclosures = actAs bridge.publisher <> actAs payer <> discloseMany (disclosures <> extraDisclosures)
  case chargePoint of
    ChargeOnPublish -> void <$> trySubmit (submitOptions [coreStateDisclosure]) do
      exerciseCmd bridge.publisherEmitterCid PublishMessage with
        nonce = 0, payload = parseHexTextOrAbort "00", consistencyLevel = 0
        coreStateCid = bridge.coreStateCid, payer, feeAllocation = Some feeAllocation
    ChargeOnRegisterEmitter -> do
      registryDisclosure <- queryDisclosure bridge.guardianGovernance bridge.feeEmitterRegistryCid
      void <$> trySubmit (submitOptions (coreStateDisclosure :: optionalToList registryDisclosure)) do
        exerciseCmd bridge.feeEmitterRegistryCid RegisterEmitter with
          requester = bridge.publisher, payer
          coreStateCid = Some bridge.coreStateCid, feeAllocation = Some feeAllocation
          expectedGuardianGovernance = bridge.guardianGovernance
    ChargeOnClaimReplayRoot -> do
      registryDisclosure <- queryDisclosure bridge.guardianGovernance bridge.feeReplayRootRegistryCid
      (claimedRootsNodeCid, claimedRootsNodeDisclosure) <- claimedRootsNodeCovering bridge.guardianGovernance bridge.publisher "f1-core"
      void <$> trySubmit (submitOptions (coreStateDisclosure :: claimedRootsNodeDisclosure :: optionalToList registryDisclosure)) do
        exerciseCmd bridge.feeReplayRootRegistryCid ClaimReplayRoot with
          consumer = bridge.publisher, namespace = "f1-core", splitThreshold = 4
          payer, coreStateCid = Some bridge.coreStateCid, feeAllocation = Some feeAllocation
          expectedGuardianGovernance = bridge.guardianGovernance, claimedRootsNodeCid

-- | 'checkAttackFailedWith' as a value: 'Some' description when the outcome is
-- not a failure that contains @expectedSubstring@.
describeUnexpectedOutcome : Text -> Text -> Either SubmitError a -> Optional Text
describeUnexpectedOutcome attack expectedSubstring submitResult = case submitResult of
  Right _ -> Some (attack <> ": accepted")
  Left (FailureStatusError failureStatus)
    | expectedSubstring `T.isInfixOf` failureStatus.message -> None
    | otherwise -> Some (attack <> ": failed with: " <> failureStatus.message)
  Left otherError
    | expectedSubstring `T.isInfixOf` show otherError -> None
    | otherwise -> Some (attack <> ": failed with: " <> show otherError)

checkFeeRecipientIsADistinctCustodyParty : PaidChargeBridge -> Script ()
checkFeeRecipientIsADistinctCustodyParty bridge = do
  assertMsg "feeRecipient is guardianGovernance" (bridge.feeRecipient /= bridge.guardianGovernance)

-- | Fee registry code runs with the authority of the allocation controllers. It
-- must not get guardianGovernance authority on any paid charge.
testRedTeamF1FeeRegistryCannotActAsGuardianGovernance : Script ()
testRedTeamF1FeeRegistryCannotActAsGuardianGovernance = do
  bridge <- setupPaidChargeBridge MessageFeeRaised
  let probedParties = [("guardianGovernance", bridge.guardianGovernance)]
  unexpectedOutcomes <- forA [ (chargePoint, probed) | chargePoint <- allFeeChargePoints, probed <- probedParties ]
    \(chargePoint, (probedPartyName, probedParty)) -> do
      hostileAllocation <- allocateWithFeeRegistryAttack bridge.feeRegistryAdmin bridge.publisher bridge.feeRecipient
        bridge.feeInstrument (feeToDecimal (feeDueAtChargePoint chargePoint)) (CreateProbeSignedBy probedParty)
      attackResult <- submitPaidCharge bridge chargePoint bridge.publisher hostileAllocation []
      pure (describeUnexpectedOutcome ("F1-core " <> show chargePoint <> " probe signed by " <> probedPartyName)
        "Authorization failure" attackResult)
  checkNoAttackAccepted "F1-core" (catOptionals unexpectedOutcomes)
  guardianGovernanceProbes <- query @RegistryAuthorityProbe bridge.guardianGovernance
  guardianGovernanceProbes === []
  Some publisherEmitter <- queryContractId bridge.publisher bridge.publisherEmitterCid
  publisherEmitter.sequence === 0
  Some feeEmitterRegistry <- queryContractId bridge.guardianGovernance bridge.feeEmitterRegistryCid
  feeEmitterRegistry.nextId === 0
  collectedFees <- mockBalance bridge.feeRegistryAdmin bridge.feeRecipient bridge.feeInstrument
  collectedFees === 0.0

-- | With guardianGovernance authority, fee registry code could publish on any
-- emitter that guardianGovernance owns, and the guardians would sign it.
testRedTeamF1FeeRegistryCannotPublishOnGuardianGovernanceEmitter : Script ()
testRedTeamF1FeeRegistryCannotPublishOnGuardianGovernanceEmitter = do
  bridge <- setupPaidChargeBridge MessageFeeZero
  guardianGovernanceEmitterDisclosure <- fromSome <$> queryDisclosure bridge.guardianGovernance bridge.guardianGovernanceEmitterCid
  let forgedPublish = PublishOnEmitter with
        targetEmitterCid = bridge.guardianGovernanceEmitterCid
        coreStateCid = bridge.coreStateCid
        forgedPayload = parseHexTextOrAbort "f0"
  unexpectedOutcomes <- forA [ChargeOnRegisterEmitter, ChargeOnClaimReplayRoot] \chargePoint -> do
    hostileAllocation <- allocateWithFeeRegistryAttack bridge.feeRegistryAdmin bridge.publisher bridge.feeRecipient
      bridge.feeInstrument (feeToDecimal (feeDueAtChargePoint chargePoint)) forgedPublish
    attackResult <- submitPaidCharge bridge chargePoint bridge.publisher hostileAllocation [guardianGovernanceEmitterDisclosure]
    pure (describeUnexpectedOutcome ("F1-core " <> show chargePoint <> " publishes on the guardianGovernance emitter")
      "Authorization failure" attackResult)
  checkNoAttackAccepted "F1-core" (catOptionals unexpectedOutcomes)
  Some guardianGovernanceEmitter <- queryContractId bridge.guardianGovernance bridge.guardianGovernanceEmitterCid
  guardianGovernanceEmitter.sequence === 0

-- | Positive control for the probe harness. The fee registry acts as the fee
-- recipient, which holds only collected fees of its own instrument.
testFeeRegistryActsOnlyAsFeeCustody : Script ()
testFeeRegistryActsOnlyAsFeeCustody = do
  bridge <- setupPaidChargeBridge MessageFeeRaised
  checkFeeRecipientIsADistinctCustodyParty bridge
  forA_ allFeeChargePoints \chargePoint -> do
    probeAllocation <- allocateWithFeeRegistryAttack bridge.feeRegistryAdmin bridge.publisher bridge.feeRecipient
      bridge.feeInstrument (feeToDecimal (feeDueAtChargePoint chargePoint)) (CreateProbeSignedBy bridge.feeRecipient)
    chargeResult <- submitPaidCharge bridge chargePoint bridge.publisher probeAllocation []
    case chargeResult of
      Right () -> pure ()
      Left chargeError -> abort (show chargePoint <> ": paid charge rejected: " <> show chargeError)
  feeCustodyProbes <- query @RegistryAuthorityProbe bridge.feeRecipient
  map (\(_, probe) -> probe.probedParty) feeCustodyProbes === replicate (length allFeeChargePoints) bridge.feeRecipient

-- | A privileged payer is an allocation controller, so a fee charge must not
-- accept it. At fee 0 no registry code runs and the payer stays valid.
testRedTeamF1PrivilegedPartyCannotPayAFee : Script ()
testRedTeamF1PrivilegedPartyCannotPayAFee = do
  bridge <- setupPaidChargeBridge MessageFeeRaised
  let privilegedPayers =
        [ (bridge.guardianGovernance, "fee payer must not be guardianGovernance")
        ]
  unexpectedOutcomes <- forA [ (chargePoint, payer) | chargePoint <- allFeeChargePoints, payer <- privilegedPayers ]
    \(chargePoint, (payer, expectedFailure)) -> do
      hostileAllocation <- allocateWithFeeRegistryAttack bridge.feeRegistryAdmin payer bridge.feeRecipient
        bridge.feeInstrument (feeToDecimal (feeDueAtChargePoint chargePoint)) (CreateProbeSignedBy payer)
      attackResult <- submitPaidCharge bridge chargePoint payer hostileAllocation []
      pure (describeUnexpectedOutcome ("F1-core " <> show chargePoint <> ": " <> expectedFailure) expectedFailure attackResult)
  checkNoAttackAccepted "F1-core privileged payer" (catOptionals unexpectedOutcomes)
  guardianGovernanceProbes <- query @RegistryAuthorityProbe bridge.guardianGovernance
  guardianGovernanceProbes === []

  (guardianGovernance, freeCoreStateCid) <- setup
  freePublisher <- allocateParty "F1FreePublisher"
  freeEmitterCid <- registerEmitter guardianGovernance freePublisher
  freeCoreStateDisclosure <- fromSome <$> queryDisclosure guardianGovernance freeCoreStateCid
  (_, freeMessage) <- submit (actAs freePublisher <> actAs guardianGovernance <> disclose freeCoreStateDisclosure) do
    exerciseCmd freeEmitterCid PublishMessage with
      nonce = 0, payload = parseHexTextOrAbort "00", consistencyLevel = 0
      coreStateCid = freeCoreStateCid, payer = guardianGovernance, feeAllocation = None
  freeMessage.sequence === 0

data ExpectedCoreStateCreate
  = CoreStateCreateCommits
  | CoreStateCreateRejectedByEnsure
  | CoreStateCreateRejectedForMissingAuthority
  deriving (Eq, Show)

-- | The fee recipient co-signs 'CoreState'. The fee recipient is not
-- guardianGovernance. The fee instrument admin is neither guardianGovernance
-- nor the fee recipient.
testCoreStateFeeRecipientIsADistinctCustodyParty : Script ()
testCoreStateFeeRecipientIsADistinctCustodyParty = do
  guardianGovernance <- allocateParty "F1GenesisGovernance"
  feeCustody <- allocateParty "F1GenesisFeeCustody"
  feeInstrumentAdmin <- allocateParty "F1GenesisFeeInstrumentAdmin"
  let genesisState feeRecipient admin = mkInitialCoreState guardianGovernance
        solanaGovernanceChainId defaultGovernanceContract
        (GenesisGuardianSet with guardianSetIndex = 0, guardians = [devnetGenesisGuardian])
        (InstrumentId with admin, id = "UNUSED") feeRecipient
      bothSigners = actAs guardianGovernance <> actAs feeCustody
      -- Columns: case name | submitters | feeRecipient | fee instrument admin | expected outcome
      genesisCases =
        [ ("feeRecipient is guardianGovernance", bothSigners, guardianGovernance, feeInstrumentAdmin,
            CoreStateCreateRejectedByEnsure)
        , ("fee instrument admin is guardianGovernance", bothSigners, feeCustody, guardianGovernance,
            CoreStateCreateRejectedByEnsure)
        , ("fee instrument admin is feeCustody", bothSigners, feeCustody, feeCustody, CoreStateCreateRejectedByEnsure)
        , ("guardianGovernance alone", actAs guardianGovernance, feeCustody, feeInstrumentAdmin,
            CoreStateCreateRejectedForMissingAuthority)
        , ("feeCustody alone", actAs feeCustody, feeCustody, feeInstrumentAdmin, CoreStateCreateRejectedForMissingAuthority)
        , ("guardianGovernance and feeCustody", bothSigners, feeCustody, feeInstrumentAdmin, CoreStateCreateCommits)
        ]
  unexpectedOutcomes <- forA genesisCases \(caseName, submitters, feeRecipient, admin, expectedOutcome) -> do
    createResult <- trySubmit submitters do createCmd (genesisState feeRecipient admin)
    pure (describeUnexpectedCoreStateCreate caseName expectedOutcome createResult)
  checkNoAttackAccepted "F1-core CoreState genesis" (catOptionals unexpectedOutcomes)
  [(_, committedGenesisState)] <- query @CoreState guardianGovernance
  sort (signatory committedGenesisState) === sort [guardianGovernance, feeCustody]

-- | 'Some' description when @createResult@ does not match @expectedOutcome@.
describeUnexpectedCoreStateCreate : Text -> ExpectedCoreStateCreate -> Either SubmitError a -> Optional Text
describeUnexpectedCoreStateCreate caseName expectedOutcome createResult = case (expectedOutcome, createResult) of
  (CoreStateCreateCommits, Right _) -> None
  (CoreStateCreateCommits, Left createError) -> Some (caseName <> ": rejected: " <> show createError)
  (CoreStateCreateRejectedByEnsure, Left (FailureStatusError failureStatus))
    | "PreconditionFailed" `T.isInfixOf` failureStatus.errorId -> None
  (CoreStateCreateRejectedForMissingAuthority, Left (AuthorizationError _)) -> None
  (_, Right _) -> Some (caseName <> ": accepted")
  (_, Left createError) -> Some (caseName <> ": expected " <> show expectedOutcome <> ", got: " <> show createError)

-- | The 'CoreState' ensure holds the invariants that the genesis signers
-- otherwise check by hand. Each row breaks exactly one invariant.
testCoreStateEnsureRejectsInconsistentGenesis : Script ()
testCoreStateEnsureRejectsInconsistentGenesis = do
  guardianGovernance <- allocateParty "EnsureGovernance"
  feeCustody <- allocateParty "EnsureFeeCustody"
  feeInstrumentAdmin <- allocateParty "EnsureFeeInstrumentAdmin"
  let consistentGenesisState = mkInitialCoreState guardianGovernance solanaGovernanceChainId
        defaultGovernanceContract (GenesisGuardianSet with guardianSetIndex = 0, guardians = [devnetGenesisGuardian])
        (InstrumentId with admin = feeInstrumentAdmin, id = "UNUSED") feeCustody
      bothSigners = actAs guardianGovernance <> actAs feeCustody
      -- Columns: case name | submitters | CoreState | expected outcome
      genesisCases =
        [ ("negative message fee", bothSigners, (consistentGenesisState with messageFee = -1),
            CoreStateCreateRejectedByEnsure)
        , ("no guardian set at guardianSetIndex", bothSigners, (consistentGenesisState with guardianSetIndex = 1),
            CoreStateCreateRejectedByEnsure)
        , ("zero message fee and guardian set 0", bothSigners, consistentGenesisState, CoreStateCreateCommits)
        ]
  unexpectedOutcomes <- forA genesisCases \(caseName, submitters, candidateState, expectedOutcome) -> do
    createResult <- trySubmit submitters do createCmd candidateState
    pure (describeUnexpectedCoreStateCreate caseName expectedOutcome createResult)
  checkNoAttackAccepted "CoreState ensure" (catOptionals unexpectedOutcomes)

-- | B1: the fee instrument admin signs every fee allocation, so the fee
-- registry body runs with its authority. With guardianGovernance as the admin,
-- an unrelated payer's paid claim publishes on a guardianGovernance emitter.
-- Genesis must reject that admin. If genesis commits, the forged publish must
-- still fail.
testRedTeamF1FeeInstrumentAdminCannotPublishOnGuardianGovernanceEmitter : Script ()
testRedTeamF1FeeInstrumentAdminCannotPublishOnGuardianGovernanceEmitter = do
  guardianGovernance <- allocateParty "B1Governance"
  feeCustody <- allocateParty "B1FeeCustody"
  unrelatedPayer <- allocateParty "B1UnrelatedPayer"
  let guardianGovernanceInstrument = InstrumentId with admin = guardianGovernance, id = "GG-ADMINISTERED"
      registryParties = RegistryParties with guardianGovernance, onboardingFeeAdmin = guardianGovernance
  genesisResult <- trySubmit (actAs guardianGovernance <> actAs feeCustody) do
    createCmd (mkInitialCoreState guardianGovernance solanaGovernanceChainId defaultGovernanceContract
      (GenesisGuardianSet with guardianSetIndex = 0, guardians = [devnetGenesisGuardian]) guardianGovernanceInstrument feeCustody)
  case genesisResult of
    Left _ -> checkNoAttackAccepted "B1 genesis"
      (optionalToList (describeUnexpectedCoreStateCreate "fee instrument admin is guardianGovernance"
        CoreStateCreateRejectedByEnsure genesisResult))
    Right coreStateCid -> do
      _ <- submit guardianGovernance do createCmd (mkInitialEmitterRegistry registryParties 0)
      guardianGovernanceEmitterCid <- registerEmitter guardianGovernance guardianGovernance
      replayRootRegistryCid <- submit guardianGovernance do
        createCmd (mkInitialReplayRootRegistry registryParties (feeDueAtChargePoint ChargeOnClaimReplayRoot))
      claimedRootsNodeCid <- submit guardianGovernance do createCmd (mkInitialClaimedRootsNode guardianGovernance)
      forgedPublishAllocation <- allocateWithFeeRegistryAttack guardianGovernance unrelatedPayer feeCustody
        guardianGovernanceInstrument (feeToDecimal (feeDueAtChargePoint ChargeOnClaimReplayRoot))
        PublishOnEmitter with
          targetEmitterCid = guardianGovernanceEmitterCid
          coreStateCid
          forgedPayload = parseHexTextOrAbort "f0"
      coreStateDisclosure <- fromSome <$> queryDisclosure guardianGovernance coreStateCid
      registryDisclosure <- fromSome <$> queryDisclosure guardianGovernance replayRootRegistryCid
      emitterDisclosure <- fromSome <$> queryDisclosure guardianGovernance guardianGovernanceEmitterCid
      claimedRootsNodeDisclosure <- fromSome <$> queryDisclosure guardianGovernance claimedRootsNodeCid
      attackResult <- trySubmit (actAs unrelatedPayer
          <> discloseMany [coreStateDisclosure, registryDisclosure, emitterDisclosure, claimedRootsNodeDisclosure]) do
        exerciseCmd replayRootRegistryCid ClaimReplayRoot with
          consumer = unrelatedPayer, namespace = "b1", splitThreshold = 4
          payer = unrelatedPayer, coreStateCid = Some coreStateCid, feeAllocation = Some forgedPublishAllocation
          expectedGuardianGovernance = guardianGovernance, claimedRootsNodeCid
      checkNoAttackAccepted "B1 forged publish on the guardianGovernance emitter"
        (optionalToList (describeUnexpectedOutcome "paid ClaimReplayRoot"
          "fee instrument admin must not be guardianGovernance" attackResult))
      Some guardianGovernanceEmitter <- queryContractId guardianGovernance guardianGovernanceEmitterCid
      guardianGovernanceEmitter.sequence === 0
      abort "B1: genesis accepted guardianGovernance as the fee instrument admin"

-- | 'chargeFee' rejects each privileged party before it fetches the
-- allocation, independent of the 'CoreState' ensure. Each rejected row breaks
-- exactly one rule.
testChargeFeeRejectsEachPrivilegedParty : Script ()
testChargeFeeRejectsEachPrivilegedParty = do
  harnessOwner <- allocateParty "DirectChargeHarnessOwner"
  guardianGovernance <- allocateParty "DirectChargeGovernance"
  feeCustody <- allocateParty "DirectChargeFeeCustody"
  feeInstrumentAdmin <- allocateParty "DirectChargeFeeInstrumentAdmin"
  payer <- allocateParty "DirectChargePayer"
  harnessCid <- submit harnessOwner do createCmd DirectFeeChargeHarness with harnessOwner
  let feeDue = 1000
      instrumentAdministeredBy admin = InstrumentId with admin, id = "MOCK"
      validInstrument = instrumentAdministeredBy feeInstrumentAdmin
      validParties = FeeChargeParties with guardianGovernance, feeRecipient = feeCustody, payer
      -- Columns: case name | parties | instrument | expected failure ("" = commits)
      chargeCases =
        [ ("payer is guardianGovernance", (validParties with payer = guardianGovernance), validInstrument,
            "fee payer must not be guardianGovernance")
        , ("fee recipient is guardianGovernance", (validParties with feeRecipient = guardianGovernance), validInstrument,
            "fee recipient must not be guardianGovernance")
        , ("fee instrument admin is guardianGovernance", validParties, instrumentAdministeredBy guardianGovernance,
            "fee instrument admin must not be guardianGovernance")
        , ("fee instrument admin is feeCustody", validParties, instrumentAdministeredBy feeCustody,
            "fee instrument admin must not be feeCustody")
        , ("no privileged party", validParties, validInstrument, "")
        ]
  unexpectedOutcomes <- forA chargeCases \(caseName, parties, instrument, expectedFailure) -> do
    feeAllocation <- mintAndAllocate feeInstrumentAdmin payer feeCustody validInstrument (feeToDecimal feeDue)
    chargeResult <- trySubmit (actAs harnessOwner <> actAs parties.payer <> actAs parties.feeRecipient) do
      exerciseCmd harnessCid ChargeFeeDirectly with
        feeChargeParties = parties, feeInstrument = instrument, feeDue, feeAllocation = Some feeAllocation
    pure $ case (expectedFailure, chargeResult) of
      ("", Right _) -> None
      ("", Left chargeError) -> Some (caseName <> ": rejected: " <> show chargeError)
      _ -> describeUnexpectedOutcome caseName expectedFailure chargeResult
  checkNoAttackAccepted "chargeFee privileged parties" (catOptionals unexpectedOutcomes)
  collectedFees <- mockBalance feeInstrumentAdmin feeCustody validInstrument
  collectedFees === feeToDecimal feeDue

-- | The 'CoreState' charge choices reject a guardianGovernance payer when a fee is due.
testRedTeamF1CoreStateChargeChoicesRejectPrivilegedPayer : Script ()
testRedTeamF1CoreStateChargeChoicesRejectPrivilegedPayer = do
  bridge <- setupPaidChargeBridge MessageFeeRaised
  let payer = bridge.guardianGovernance
      expectedFailure = "fee payer must not be guardianGovernance"
  unexpectedOutcomes <- forA ["ChargeMessageFee", "ChargeFee"] \chargeChoice -> do
    feeAllocation <- mintAndAllocate bridge.feeRegistryAdmin payer bridge.feeRecipient bridge.feeInstrument
      (feeToDecimal (feeDueAtChargePoint ChargeOnPublish))
    coreStateDisclosure <- fromSome <$> queryDisclosure bridge.guardianGovernance bridge.coreStateCid
    chargeResult <- trySubmit (actAs payer <> disclose coreStateDisclosure) $
      if chargeChoice == "ChargeMessageFee"
        then void (exerciseCmd bridge.coreStateCid ChargeMessageFee with payer, feeAllocation = Some feeAllocation)
        else void (exerciseCmd bridge.coreStateCid ChargeFee with
          payer, fee = feeDueAtChargePoint ChargeOnPublish, feeAllocation = Some feeAllocation)
    pure (describeUnexpectedOutcome (chargeChoice <> ": " <> expectedFailure) expectedFailure chargeResult)
  checkNoAttackAccepted "F1-core CoreState charge choices" (catOptionals unexpectedOutcomes)
  collectedFees <- mockBalance bridge.feeRegistryAdmin bridge.feeRecipient bridge.feeInstrument
  collectedFees === 0.0

-- | Every charge point pays the fee recipient, and guardianGovernance holds no fees.
testFeeCustodyReceivesFeesOnEveryChargePoint : Script ()
testFeeCustodyReceivesFeesOnEveryChargePoint = do
  bridge <- setupPaidChargeBridge MessageFeeRaised
  checkFeeRecipientIsADistinctCustodyParty bridge
  forA_ allFeeChargePoints \chargePoint -> do
    feeAllocation <- mintAndAllocate bridge.feeRegistryAdmin bridge.publisher bridge.feeRecipient
      bridge.feeInstrument (feeToDecimal (feeDueAtChargePoint chargePoint))
    chargeResult <- submitPaidCharge bridge chargePoint bridge.publisher feeAllocation []
    case chargeResult of
      Right () -> pure ()
      Left chargeError -> abort (show chargePoint <> ": paid charge rejected: " <> show chargeError)
  feeCustodyBalance <- mockBalance bridge.feeRegistryAdmin bridge.feeRecipient bridge.feeInstrument
  feeCustodyBalance === feeToDecimal (sum (map feeDueAtChargePoint allFeeChargePoints))
  guardianGovernanceBalance <- mockBalance bridge.feeRegistryAdmin bridge.guardianGovernance bridge.feeInstrument
  guardianGovernanceBalance === 0.0
