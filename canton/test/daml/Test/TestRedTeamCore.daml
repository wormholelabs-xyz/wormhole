{-# OPTIONS_GHC -Wno-deprecated-exceptions #-}
-- | Red-team tests for the core bridge (findings in canton/REDTEAM.md). Each
-- test asserts that its attack FAILS; a failing test is an open finding.
-- Signed VAA literals are generated and drift-guarded by
-- node/pkg/cantonclient/redteam_vectorgen_test.go. Guardian set 0 is devnet
-- key 0; 'rtGuardianSetUpgradeToSet1' installs set 1 = devnet keys 0..3.
module Test.TestRedTeamCore where

import Daml.Script
import DA.Action (foldlA, void)
import DA.Assert ((===))
import DA.Exception (GeneralError(..), throw)
import DA.Foldable (forA_)
import DA.List (sort)
import DA.Optional (fromSome)
import DA.Text qualified as T
import DA.Time (microseconds, seconds)
import Wormhole.Core.Bytes
import Wormhole.Core.Governance
import Wormhole.Core.GuardianSet (guardianSetExpirySeconds)
import Wormhole.Core.Setup
import Wormhole.Core.State
import Wormhole.Core.VAA (VAA)
import Test.TestCore (setup, registerEmitter, publishVia, govSetFeeVAA, devnetGuardianPubKey)
import Test.TestReplay (registerReplayRoot)

