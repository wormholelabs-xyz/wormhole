-- | Daml Script tests and devnet bootstrap for the Wormhole core bridge.
--
-- @setup@ is referenced by @daml.yaml@'s @init-script@ and seeds a devnet
-- guardianGovernance + 'CoreState' with the standard Tilt/devnet guardian
-- (address 0xbeFA429d57cD18b7F8A4d91A2da9AB4AF05d0FBe).
module Test.TestCore where

import Daml.Script
import DA.Assert ((===))
import DA.Date (Month(Jan), date)
import DA.Either (isRight)
import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Optional (fromOptional, fromSome)
import DA.Text qualified as T
import DA.Time (addRelTime, microseconds, seconds, time)
import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Wormhole.Core.Bytes
import Wormhole.Core.Governance (GovernanceAction(..))
import Wormhole.Core.GuardianSet
import Wormhole.Core.State
import Wormhole.Core.Setup
import Wormhole.Core.VAA ()   -- HasField instances for VAA record-dot access

-- The well-known devnet guardian address used across Wormhole's Tilt setup.
devnetGuardian : GuardianAddress
devnetGuardian = parseHexTextOrAbort "befa429d57cd18b7f8a4d91a2da9ab4af05d0fbe"

-- 65-byte uncompressed secp256k1 public key of the devnet guardian.
devnetGuardianPubKey : GuardianPublicKey
devnetGuardianPubKey = parseHexTextOrAbort "04d4a4629979f0c9fa0f0bb54edf33f87c8c5a1f42c0350a30d68f7e967023e34e495a8ebf5101036d0fd66e3b0a8c7c61b65fceeaf487ab3cd1b5b7b50beb7970"

-- | The devnet guardian with its public key attached.
devnetGuardianMember : GuardianSetMember
devnetGuardianMember = GuardianSetMember with address = devnetGuardian, publicKey = Some devnetGuardianPubKey

devnetGenesisGuardian : GenesisGuardian
devnetGenesisGuardian = GenesisGuardian with address = devnetGuardian, publicKey = devnetGuardianPubKey

unkeyedMembersOf : [GuardianAddress] -> [GuardianSetMember]
unkeyedMembersOf = map (\address -> GuardianSetMember with address, publicKey = None)

-- A real governance VAA — SetMessageFee(chain=75, fee=1000), emitted by the
-- standard governance emitter (chain 1, 0x..04) and signed by the devnet
-- guardian (set 0). Generated by node/pkg/cantonclient/vectorgen_test.go.
govSetFeeVAA : EncodedVaa
govSetFeeVAA = parseHexTextOrAbort ""

-- | Ethereum mainnet core getCurrentGuardianSetIndex() on 2026-11-18.
nonZeroGenesisGuardianSetIndex : Int
nonZeroGenesisGuardianSetIndex = 7

-- | 'govSetFeeVAA' with header guardian set index 7 and sequence 7, signed by the
-- devnet guardian. Generated by node/pkg/cantonclient/vectorgen_test.go.
govSetFeeVAASignedBySet7 : EncodedVaa
govSetFeeVAASignedBySet7 = parseHexTextOrAbort ""

-- | GuardianSetUpgrade(chain 0, new index 8, keys = [devnet key 1]), header
-- index 7, sequence 8, signed by the devnet guardian. Generated by
-- node/pkg/cantonclient/vectorgen_test.go.
govGuardianSetUpgrade7To8VAA : EncodedVaa
govGuardianSetUpgrade7To8VAA = parseHexTextOrAbort ""

-- | Bootstrap a devnet 'CoreState', 'EmitterRegistry', and 'ReplayRootRegistry'.
-- guardianGovernance and the fee custody party sign the 'CoreState';
-- guardianGovernance alone signs both registries (single parties here; k-of-n
-- threshold parties in production).
-- Returns @(guardianGovernance, coreState)@; @guardianGovernance@ is the
-- watcher's --cantonReadAsParty and the first party for bootstrap.sh.
setup : Script (Party, ContractId CoreState)
setup = setupWithInstrument None

-- | 'setup' with a caller-supplied fee instrument (Test.TestFees provides a
-- mock-token instrument; plain 'setup' uses a placeholder that is never
-- validated because all fees default to 0). The fee recipient is a separate
-- fee custody party, matching production custody. The placeholder admin is a
-- party that signs nothing: the 'CoreState' ensure rejects
-- guardianGovernance and feeCustody as the fee instrument admin.
setupWithInstrument : Optional InstrumentId -> Script (Party, ContractId CoreState)
setupWithInstrument = setupWithPartyLabel ""

-- | 'setupWithInstrument' with @partyLabel@ appended to each party hint, so a
-- script can run again on one participant.
setupWithPartyLabel : Text -> Optional InstrumentId -> Script (Party, ContractId CoreState)
setupWithPartyLabel partyLabel = setupWithGenesisGuardianSetIndex partyLabel 0

-- | 'setupWithPartyLabel' with the genesis guardian set (the devnet guardian) at @genesisIndex@.
setupAtGuardianSetIndex : Text -> Int -> Script (Party, ContractId CoreState)
setupAtGuardianSetIndex partyLabel genesisIndex = setupWithGenesisGuardianSetIndex partyLabel genesisIndex None

setupWithGenesisGuardianSetIndex : Text -> Int -> Optional InstrumentId -> Script (Party, ContractId CoreState)
setupWithGenesisGuardianSetIndex partyLabel genesisIndex mInstrument = do
  guardianGovernance <- allocateParty ("GuardianGovernance" <> partyLabel)
  feeCustody <- allocateParty ("FeeCustody" <> partyLabel)
  onboardingFeeAdmin <- allocateParty ("OnboardingFeeAdmin" <> partyLabel)
  placeholderFeeInstrumentAdmin <- allocateParty ("UnusedFeeInstrumentAdmin" <> partyLabel)
  let feeInstrument = fromOptional (InstrumentId with admin = placeholderFeeInstrumentAdmin, id = "UNUSED") mInstrument
      registryParties = RegistryParties with guardianGovernance, onboardingFeeAdmin
  csId <- submit (actAs guardianGovernance <> actAs feeCustody) do
    createCmd (mkInitialCoreState guardianGovernance solanaGovernanceChainId
                 defaultGovernanceContract
                 GenesisGuardianSet with guardianSetIndex = genesisIndex, guardians = [devnetGenesisGuardian]
                 feeInstrument feeCustody)
  _ <- submit guardianGovernance do createCmd (mkInitialEmitterRegistry registryParties 0)
  _ <- submit guardianGovernance do createCmd (mkInitialReplayRootRegistry registryParties 0)
  pure (guardianGovernance, csId)

-- | Register an emitter for @owner@, the production way: the requester submits
-- alone against the disclosed 'EmitterRegistry' (served off-ledger by the
-- disclosure service — simulated here by querying as guardianGovernance);
-- guardianGovernance's co-signature on the 'Emitter' is inherited from the
-- registry. Zero-fee registries need no CoreState reference.
registerEmitter : Party -> Party -> Script (ContractId Emitter)
registerEmitter guardianGovernance owner = do
  [(regCid, _)] <- query @EmitterRegistry guardianGovernance
  regDisc <- fromSome <$> queryDisclosure guardianGovernance regCid
  (_, emCid) <- submit (actAs owner <> disclose regDisc) do
    exerciseCmd regCid RegisterEmitter with
      requester = owner
      payer = owner    -- direct registration: own payer, controller set collapses
      coreStateCid = None
      feeAllocation = None
      expectedGuardianGovernance = guardianGovernance
  pure emCid

-- | Publish with the referenced 'CoreState' disclosed (the fee read is on
-- every publish; at fee 0 no allocation is attached). The disclosure is
-- fetched as guardianGovernance — the disclosure-service simulation. Returns
-- the successor 'Emitter' cid and 'WormholeMessage'; the caller threads the cid
-- into the next publish with no ACS re-resolution.
publishVia : Party -> ContractId CoreState -> Party -> ContractId Emitter -> Int -> MessagePayload -> Int -> Script (ContractId Emitter, WormholeMessage)
publishVia guardianGovernance csId owner emCid nonce payload consistencyLevel = do
  csDisc <- fromSome <$> queryDisclosure guardianGovernance csId
  submit (actAs owner <> disclose csDisc) do
    exerciseCmd emCid PublishMessage with
      nonce, payload, consistencyLevel
      coreStateCid = csId
      payer = owner
      feeAllocation = None

-- | Apply a governance VAA with @submitter@ as the submitter; the 'CoreState'
-- disclosure comes from guardianGovernance.
submitGovernanceAs : Party -> Party -> ContractId CoreState -> EncodedVaa -> Script (ContractId CoreState)
submitGovernanceAs guardianGovernance submitter csId encodedVAA = do
  csDisc <- fromSome <$> queryDisclosure guardianGovernance csId
  submit (actAs submitter <> disclose csDisc) do
    exerciseCmd csId SubmitGovernanceVAA with submitter, encodedVAA

-- | Publishing increments the per-emitter sequence and yields the expected
-- 'WormholeMessage'. The message carries the emitter's identity components
-- (the watcher derives the 32-byte address as keccak256 over them); the second
-- publish addresses the sequence-bumped successor directly via the cid
-- 'PublishMessage' returns — no ACS re-resolution needed.
testPublishMessage : Script ()
testPublishMessage = do
  (guardianGovernance, csId) <- setup
  alice <- allocateParty "Alice"
  emitterId <- registerEmitter guardianGovernance alice
  Some em <- queryContractId alice emitterId
  em.emitterId === 0
  em.emitterAddress === emitterAddressFor guardianGovernance alice 0

  (em0Cid, msg0) <- publishVia guardianGovernance csId alice emitterId 7 (parseHexTextOrAbort "deadbeef") 0
  msg0.registrar === guardianGovernance
  msg0.owner === alice
  msg0.emitterId === 0
  msg0.sequence === 0
  msg0.nonce === 7
  msg0.payload === parseHexTextOrAbort "deadbeef"

  -- Thread the returned successor cid directly; no ACS re-resolution.
  (_, msg1) <- publishVia guardianGovernance csId alice em0Cid 8 (parseHexTextOrAbort "cafe") 0
  msg1.sequence === 1
  msg1.registrar === guardianGovernance
  msg1.owner === alice
  msg1.emitterId === 0
  pure ()

-- | 'PublishMessage' returns the sequence-bumped successor's cid directly, so
-- a caller can publish again in the same script with no ACS re-resolution —
-- the defect this template regresses against was the cid being discarded.
testPublishReturnsLiveEmitter : Script ()
testPublishReturnsLiveEmitter = do
  (guardianGovernance, csId) <- setup
  alice <- allocateParty "LiveEmitterAlice"
  emitterId <- registerEmitter guardianGovernance alice

  (em0Cid, msg0) <- publishVia guardianGovernance csId alice emitterId 7 (parseHexTextOrAbort "deadbeef") 0
  msg0.registrar === guardianGovernance
  msg0.owner === alice
  msg0.emitterId === 0
  msg0.sequence === 0
  msg0.nonce === 7
  msg0.consistencyLevel === 0
  msg0.payload === parseHexTextOrAbort "deadbeef"

  -- No re-resolution: publish again directly off the cid PublishMessage
  -- returned above.
  (_, msg1) <- publishVia guardianGovernance csId alice em0Cid 8 (parseHexTextOrAbort "cafe") 0
  msg1.sequence === msg0.sequence + 1

-- | Emitter ids are allocated sequentially and yield distinct, owner-bound
-- addresses; the registry's counter advances.
testRegistryAllocation : Script ()
testRegistryAllocation = do
  (guardianGovernance, _) <- setup
  alice <- allocateParty "AllocAlice"
  bob <- allocateParty "AllocBob"
  aliceEm <- registerEmitter guardianGovernance alice
  bobEm <- registerEmitter guardianGovernance bob
  Some a <- queryContractId alice aliceEm
  Some b <- queryContractId bob bobEm
  a.emitterId === 0
  b.emitterId === 1
  assert (a.emitterAddress /= b.emitterAddress)
  [(_, reg)] <- query @EmitterRegistry guardianGovernance
  reg.nextId === 2

-- | Pins the canonical emitter-address encoding against the cross-language test
-- vector (node/pkg/cantonclient/vectorgen_test.go TestCantonDamlFixtures and
-- pkg/watchers/canton/watcher_test.go). If this fails, the Daml and Go encoders
-- have diverged — fix BOTH and regenerate the vector.
testAddressVector : Script ()
testAddressVector =
  hexTextOf (derivedAddressFromText
      (DomainTag emitterAddressTag)
      (RegistrarText "vector-registrar::1220deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef")
      (OwnerText "vector-owner::1220cafebabe")
      (RegistryId 7))
    === "37311031ac421fbccc74c1df19ad5635cbefd1a82db60d613eb62a158f504d35"

-- | A party cannot forge an existing emitter's address. The address includes
-- the @owner@, and the 'Emitter' is owner-co-signed, so:
--   (a) a forger alone cannot create a contract carrying the owner's address
--       (missing the owner's and guardianGovernance's signatures); and
--   (b) even with guardianGovernance, the best a forger can do is a contract
--       with a DIFFERENT owner, which derives a different (untrusted) address.
-- This is the invariant guardians verify by replay.
testImpersonationBlocked : Script ()
testImpersonationBlocked = do
  (guardianGovernance, _) <- setup
  alice <- allocateParty "VictimAlice"
  mallory <- allocateParty "Mallory"
  aliceEm <- registerEmitter guardianGovernance alice
  Some a <- queryContractId alice aliceEm

  -- (a) Mallory alone cannot forge Alice's address.
  submitMustFail mallory do
    createCmd Emitter with
      guardianGovernance = a.guardianGovernance, owner = alice
      emitterId = 0
      emitterAddress = a.emitterAddress, sequence = 0

  -- (b) Mallory without guardianGovernance cannot create an emitter.
  submitMustFail mallory do
    createCmd Emitter with
      guardianGovernance = a.guardianGovernance, owner = mallory
      emitterId = 0
      emitterAddress = emitterAddressFor guardianGovernance mallory 0, sequence = 0

  -- (c) With guardianGovernance, a same-id emitter for Mallory has a different address.
  malloryEm <- submit (actAs mallory <> actAs guardianGovernance) do
    createCmd Emitter with
      guardianGovernance = a.guardianGovernance, owner = mallory
      emitterId = 0
      emitterAddress = emitterAddressFor guardianGovernance mallory 0, sequence = 0
  Some m <- queryContractId mallory malloryEm
  assert (m.emitterAddress /= a.emitterAddress)

-- | Range bounds of 'EmitterRegistry' and 'Emitter': ids stay below 2^53, so
-- every tool reads them exactly; the sequence successor fits Int.
testEmitterIdBounds : Script ()
testEmitterIdBounds = do
  (guardianGovernance, _) <- setup
  owner <- allocateParty "BoundsOwner"
  [(_, genesisRegistry)] <- query @EmitterRegistry guardianGovernance
  let maxEmitterIdLiteral = 9007199254740991
      maxEmitterSequenceLiteral = 9223372036854775806
      maxOnboardingFeeLiteral = 10000000000000000
      allSignatories = actAs owner <> actAs guardianGovernance
      registryWith registrationFee nextId = genesisRegistry with registrationFee, nextId
      emitterWith emitterId sequence = Emitter with
        guardianGovernance, owner, emitterId
        -- emitterAddressFor rejects a negative id; the ensure clause is under test.
        emitterAddress = emitterAddressFor guardianGovernance owner (max 0 emitterId)
        sequence
      registryCases =
        [ ("registry nextId -1", registryWith 0 (-1), False)
        , ("registry nextId 0", registryWith 0 0, True)
        , ("registry nextId maxEmitterId + 1", registryWith 0 (maxEmitterIdLiteral + 1), True)
        , ("registry nextId maxEmitterId + 2", registryWith 0 (maxEmitterIdLiteral + 2), False)
        , ("registration fee -1", registryWith (-1) 0, False)
        , ("registration fee 0", registryWith 0 0, True)
        , ("registration fee maxOnboardingFee", registryWith maxOnboardingFeeLiteral 0, True)
        , ("registration fee maxOnboardingFee + 1", registryWith (maxOnboardingFeeLiteral + 1) 0, False)
        ]
      emitterCases =
        [ ("emitter id -1", emitterWith (-1) 0, False)
        , ("emitter id 0", emitterWith 0 0, True)
        , ("emitter id maxEmitterId", emitterWith maxEmitterIdLiteral 0, True)
        , ("emitter id maxEmitterId + 1", emitterWith (maxEmitterIdLiteral + 1) 0, False)
        , ("sequence -1", emitterWith 0 (-1), False)
        , ("sequence 0", emitterWith 0 0, True)
        , ("sequence maxEmitterSequence", emitterWith 0 maxEmitterSequenceLiteral, True)
        , ("sequence maxEmitterSequence + 1", emitterWith 0 (maxEmitterSequenceLiteral + 1), False)
        ]
      checkCreateOutcome caseName expectAccepted createResult = case (expectAccepted, createResult) of
        (True, Right _) -> pure ()
        (True, Left createError) -> abort (caseName <> ": rejected: " <> show createError)
        (False, Right _) -> abort (caseName <> ": accepted")
        (False, Left createError) ->
          assertMsg (caseName <> ": expected a template precondition failure, got: " <> show createError)
            ("precondition" `T.isInfixOf` show createError)
  forA_ registryCases \(caseName, registry, expectAccepted) -> do
    createResult <- trySubmit allSignatories do createCmd registry
    checkCreateOutcome caseName expectAccepted createResult
  forA_ emitterCases \(caseName, emitter, expectAccepted) -> do
    createResult <- trySubmit allSignatories do createCmd emitter
    checkCreateOutcome caseName expectAccepted createResult

  -- The last id is issued; the registry then holds maxEmitterId + 1 and issues no more.
  lastIdRegistryCid <- submit guardianGovernance do
    createCmd (registryWith 0 maxEmitterIdLiteral)
  lastIdRegistryDisclosure <- fromSome <$> queryDisclosure guardianGovernance lastIdRegistryCid
  (exhaustedRegistryCid, lastEmitterCid) <- submit (actAs owner <> disclose lastIdRegistryDisclosure) do
    exerciseCmd lastIdRegistryCid RegisterEmitter with
      requester = owner, payer = owner, coreStateCid = None, feeAllocation = None
      expectedGuardianGovernance = guardianGovernance
  Some lastEmitter <- queryContractId owner lastEmitterCid
  lastEmitter.emitterId === maxEmitterIdLiteral
  exhaustedRegistryDisclosure <- fromSome <$> queryDisclosure guardianGovernance exhaustedRegistryCid
  exhaustedResult <- trySubmit (actAs owner <> disclose exhaustedRegistryDisclosure) do
    exerciseCmd exhaustedRegistryCid RegisterEmitter with
      requester = owner, payer = owner, coreStateCid = None, feeAllocation = None
      expectedGuardianGovernance = guardianGovernance
  checkCreateOutcome "registration after maxEmitterId" False exhaustedResult

-- | Genesis needs the guardianGovernance and fee custody signatures.
testGenesisRequiresGuardianGovernance : Script ()
testGenesisRequiresGuardianGovernance = do
  guardianGovernance <- allocateParty "GenesisGovernance"
  feeCustody <- allocateParty "GenesisFeeCustody"
  placeholderFeeInstrumentAdmin <- allocateParty "GenesisUnusedFeeInstrumentAdmin"
  stranger <- allocateParty "GenesisStranger"
  let feeInstrument = InstrumentId with admin = placeholderFeeInstrumentAdmin, id = "UNUSED"
      genesisState = mkInitialCoreState guardianGovernance solanaGovernanceChainId
                       defaultGovernanceContract
                       GenesisGuardianSet with guardianSetIndex = 0, guardians = [devnetGenesisGuardian]
                       feeInstrument feeCustody
  submitMustFail stranger do createCmd genesisState
  submitMustFail guardianGovernance do createCmd genesisState
  submitMustFail feeCustody do createCmd genesisState
  _ <- submit (actAs guardianGovernance <> actAs feeCustody) do createCmd genesisState
  pure ()

-- | Pairs each case with its position, for a unique party hint per case.
numberCases : [a] -> [(Int, a)]
numberCases cases = zip [0 .. length cases - 1] cases

-- | Genesis installs the guardian set at the supplied global index, current and never expiring.
testGenesisInstallsGuardianSetAtInitialIndex : Script ()
testGenesisInstallsGuardianSetAtInitialIndex =
  forA_ (numberCases [0, 1, nonZeroGenesisGuardianSetIndex, maxGuardianSetIndex]) \(caseNumber, genesisIndex) -> do
    (guardianGovernance, csId) <- setupAtGuardianSetIndex ("GenesisIndexCase" <> show caseNumber) genesisIndex
    Some coreState <- queryContractId guardianGovernance csId
    coreState.guardianSetIndex === genesisIndex
    Map.keys coreState.guardianSets === [genesisIndex]
    let genesisSet = fromSome (Map.lookup genesisIndex coreState.guardianSets)
    guardianAddressesOf genesisSet === [devnetGuardian]
    genesisSet.expirationTime === None

data VAAVerificationCase = VAAVerificationCase with
    caseName : Text
    genesisIndex : Int
    encodedVAA : EncodedVaa
    expectedSigningSetIndex : Optional Int  -- None: verification must fail

-- | 'ParseAndVerifyVAA' resolves the signing set by the global index in the VAA header.
testVerifyVAAResolvesSigningSetByGlobalIndex : Script ()
testVerifyVAAResolvesSigningSetByGlobalIndex = do
  let cases =
        [ VAAVerificationCase "set 7 VAA, genesis 7" nonZeroGenesisGuardianSetIndex govSetFeeVAASignedBySet7 (Some 7)
        , VAAVerificationCase "set 0 VAA, genesis 7" nonZeroGenesisGuardianSetIndex govSetFeeVAA None
        , VAAVerificationCase "set 7 VAA, genesis 0" 0 govSetFeeVAASignedBySet7 None
        , VAAVerificationCase "set 0 VAA, genesis 0" 0 govSetFeeVAA (Some 0)
        ]
  forA_ (numberCases cases) \(caseNumber, verificationCase) -> do
    (guardianGovernance, csId) <- setupAtGuardianSetIndex ("VerifyCase" <> show caseNumber) verificationCase.genesisIndex
    result <- trySubmit guardianGovernance do
      exerciseCmd csId ParseAndVerifyVAA with
        verifier = guardianGovernance
        encodedVAA = verificationCase.encodedVAA
    case (verificationCase.expectedSigningSetIndex, result) of
      (Some expectedIndex, Right vaa) -> vaa.guardianSetIndex === expectedIndex
      (None, Left verifyError) ->
        assertMsg (verificationCase.caseName <> ": expected an unknown index, got: " <> show verifyError)
          ("unknown guardian set index" `T.isInfixOf` show verifyError)
      _ -> abort ("unexpected verification outcome: " <> verificationCase.caseName)

-- | From a genesis at index 7: governance signed by set 7 applies, the 7 to 8
-- upgrade applies, and an upgrade signed by set 0 fails.
testGovernanceFromNonZeroGenesis : Script ()
testGovernanceFromNonZeroGenesis = do
  (guardianGovernance, csId) <- setupAtGuardianSetIndex "GovernanceAt7" nonZeroGenesisGuardianSetIndex
  submitMustFail guardianGovernance do
    exerciseCmd csId SubmitGovernanceVAA with
      submitter = guardianGovernance
      encodedVAA = govGuardianSetUpgradeVAA
  feeCsId <- submit guardianGovernance do
    exerciseCmd csId SubmitGovernanceVAA with
      submitter = guardianGovernance
      encodedVAA = govSetFeeVAASignedBySet7
  Some feeState <- queryContractId guardianGovernance feeCsId
  feeState.messageFee === 1000
  upgradedAt <- getTime
  upgradedCsId <- submit guardianGovernance do
    exerciseCmd feeCsId SubmitGovernanceVAA with
      submitter = guardianGovernance
      encodedVAA = govGuardianSetUpgrade7To8VAA
  Some upgradedState <- queryContractId guardianGovernance upgradedCsId
  upgradedState.guardianSetIndex === 8
  Map.keys upgradedState.guardianSets === [7, 8]
  guardianAddressesOf (fromSome (Map.lookup 8 upgradedState.guardianSets)) === [devnetGuardianSet1Key]
  (fromSome (Map.lookup 8 upgradedState.guardianSets)).expirationTime === None
  (fromSome (Map.lookup 7 upgradedState.guardianSets)).expirationTime
    === Some (addRelTime upgradedAt (seconds guardianSetExpirySeconds))

-- | From a genesis at index 7, only new index 8 upgrades.
testGuardianSetUpgradeIndexFromNonZeroGenesis : Script ()
testGuardianSetUpgradeIndexFromNonZeroGenesis = do
  guardianGovernance <- allocateParty "UpgradeIndexGovernance"
  feeCustody <- allocateParty "UpgradeIndexFeeCustody"
  placeholderFeeInstrumentAdmin <- allocateParty "UpgradeIndexUnusedFeeInstrumentAdmin"
  now <- getTime
  let feeInstrument = InstrumentId with admin = placeholderFeeInstrumentAdmin, id = "UNUSED"
      genesisState = mkInitialCoreState guardianGovernance solanaGovernanceChainId
                       defaultGovernanceContract
                       GenesisGuardianSet with
                         guardianSetIndex = nonZeroGenesisGuardianSetIndex
                         guardians = [devnetGenesisGuardian]
                       feeInstrument feeCustody
      upgradeTo newIndex = applyGovernance genesisState now
        (GuardianSetUpgrade with chain = 0, newIndex, newKeys = [devnetGuardianSet1Key])
  forA_ [(0, False), (6, False), (7, False), (8, True), (9, False), (maxGuardianSetIndex, False)]
    \(newIndex, isAccepted) -> isRight (upgradeTo newIndex) === isAccepted

-- | @addressCount@ distinct non-zero 20-byte addresses: 1, 2, 3, ... big-endian.
distinctGuardianAddresses : Int -> [GuardianAddress]
distinctGuardianAddresses addressCount = map (\position -> parseHexBytesAsOrAbort (intToBytesN (position + 1) 20)) [0 .. addressCount - 1]

checkCoreStateCreateOutcome : Text -> Bool -> Either SubmitError a -> Script ()
checkCoreStateCreateOutcome caseName expectAccepted createResult = case (expectAccepted, createResult) of
  (True, Right _) -> pure ()
  (True, Left createError) -> abort (caseName <> ": rejected: " <> show createError)
  (False, Right _) -> abort ("CoreState precondition admitted: " <> caseName)
  (False, Left createError) ->
    assertMsg (caseName <> ": expected a template precondition failure, got: " <> show createError)
      ("precondition" `T.isInfixOf` show createError)

currentGuardianSetFixture : GuardianSet
currentGuardianSetFixture = GuardianSet with members = [devnetGuardianMember], expirationTime = None

expiredGuardianSetFixture : GuardianSet
expiredGuardianSetFixture = currentGuardianSetFixture with expirationTime = Some (time (date 2026 Jan 1) 0 0 0)

-- | A raw 'CoreState' create with @storedSets@; the other fields come from 'mkInitialCoreState'.
tryCreateCoreStateWithGuardianSets : Text -> Int -> Map.Map Int GuardianSet -> Script (Either SubmitError (ContractId CoreState))
tryCreateCoreStateWithGuardianSets partyLabel currentIndex storedSets = do
  guardianGovernance <- allocateParty ("PreconditionGovernance" <> partyLabel)
  feeCustody <- allocateParty ("PreconditionFeeCustody" <> partyLabel)
  placeholderFeeInstrumentAdmin <- allocateParty ("PreconditionUnusedFeeInstrumentAdmin" <> partyLabel)
  let feeInstrument = InstrumentId with admin = placeholderFeeInstrumentAdmin, id = "UNUSED"
      genesisState = mkInitialCoreState guardianGovernance solanaGovernanceChainId
                       defaultGovernanceContract
                       GenesisGuardianSet with guardianSetIndex = 0, guardians = [devnetGenesisGuardian]
                       feeInstrument feeCustody
  trySubmit (actAs guardianGovernance <> actAs feeCustody) do
    -- A governance digest lifts the genesis key rule, so each row tests the set rules alone.
    createCmd genesisState with
      guardianSetIndex = currentIndex, guardianSets = storedSets
      consumedGovernance = Map.singleton (parseHexTextOrAbort (mconcat (replicate 64 "a"))) 0

-- | The 'CoreState' template precondition rejects each malformed guardian set map.
testCoreStatePreconditionRejectsMalformedGuardianSets : Script ()
testCoreStatePreconditionRejectsMalformedGuardianSets = do
  let currentSet = currentGuardianSetFixture
      expiredSet = expiredGuardianSetFixture
      rejectedCases =
        [ ("index below 0", -1, Map.fromList [(-1, currentSet)])
        , ("index above uint32", maxGuardianSetIndex + 1, Map.fromList [(maxGuardianSetIndex + 1, currentSet)])
        , ("current index has no set", 7, Map.fromList [(0, currentSet)])
        , ("current set expires", 7, Map.fromList [(7, expiredSet)])
        , ("current set is empty", 7, Map.fromList [(7, currentSet with members = unkeyedMembersOf [])])
        , ("current set has 256 guardians", 7, Map.fromList [(7, currentSet with members = unkeyedMembersOf (distinctGuardianAddresses 256))])
        , ("zero address", 7, Map.fromList [(7, currentSet with members = unkeyedMembersOf [zeroGuardianAddress])])
        , ("zero address after a valid address", 7, Map.fromList [(7, currentSet with members = unkeyedMembersOf [devnetGuardian, zeroGuardianAddress])])
        , ("duplicate address", 7, Map.fromList [(7, currentSet with members = unkeyedMembersOf [devnetGuardian, devnetGuardianSet1Key, devnetGuardian])])
        , ("set above current index", 7, Map.fromList [(7, currentSet), (8, currentSet)])
        , ("previous set never expires", 7, Map.fromList [(6, currentSet), (7, currentSet)])
        , ("previous index below 0", 7, Map.fromList [(-1, expiredSet), (7, currentSet)])
        , ("previous set is empty", 7, Map.fromList [(6, expiredSet with members = unkeyedMembersOf []), (7, currentSet)])
        , ("previous set has a zero address", 7, Map.fromList [(6, expiredSet with members = unkeyedMembersOf [zeroGuardianAddress]), (7, currentSet)])
        ]
  forA_ (numberCases rejectedCases) \(caseNumber, (caseName, currentIndex, storedSets)) ->
    tryCreateCoreStateWithGuardianSets ("Rejected" <> show caseNumber) currentIndex storedSets
      >>= checkCoreStateCreateOutcome caseName False

-- | The 'CoreState' template precondition admits each boundary of the index and count ranges.
testCoreStatePreconditionAcceptsBoundaryGuardianSets : Script ()
testCoreStatePreconditionAcceptsBoundaryGuardianSets = do
  let currentSet = currentGuardianSetFixture
      acceptedCases =
        [ ("index 0", 0, Map.fromList [(0, currentSet)])
        , ("index maxGuardianSetIndex", maxGuardianSetIndex, Map.fromList [(maxGuardianSetIndex, currentSet)])
        , ("255 guardians", 7, Map.fromList [(7, currentSet with members = unkeyedMembersOf (distinctGuardianAddresses 255))])
        , ("expired set 6 and current set 7", 7, Map.fromList [(6, expiredGuardianSetFixture), (7, currentSet)])
        ]
  forA_ (numberCases acceptedCases) \(caseNumber, (caseName, currentIndex, storedSets)) ->
    tryCreateCoreStateWithGuardianSets ("Accepted" <> show caseNumber) currentIndex storedSets
      >>= checkCoreStateCreateOutcome caseName True

-- | Each property of the shared guardian address validator, with its error text.
-- Byte-shape cases: Test.TestByteTypes and canton/test/forged_byte_values_test.sh.
testCheckGuardianAddressesAreWellFormed : Script ()
testCheckGuardianAddressesAreWellFormed = do
  let cases =
        [ ("one address", [devnetGuardian], None)
        , ("255 distinct addresses", distinctGuardianAddresses 255, None)
        , ("empty", [], Some "empty set")
        , ("256 distinct addresses", distinctGuardianAddresses 256, Some "more than 255 guardians")
        , ("zero address", [zeroGuardianAddress], Some "zero address at position 0")
        , ("zero address at position 1", [devnetGuardian, zeroGuardianAddress], Some "zero address at position 1")
        , ("duplicate address", [devnetGuardian, devnetGuardianSet1Key, devnetGuardian], Some "duplicate address")
        ]
  forA_ cases \(caseName, addresses, expectedErrorFragment) ->
    case (expectedErrorFragment, checkGuardianAddressesAreWellFormed addresses) of
      (None, Right ()) -> pure ()
      (Some fragment, Left message) | fragment `T.isInfixOf` message -> pure ()
      (_, outcome) -> abort (caseName <> ": unexpected outcome " <> show outcome)

-- | 'applyGovernance' rejects an upgrade to a malformed guardian set.
testGuardianSetUpgradeRejectsMalformedAddresses : Script ()
testGuardianSetUpgradeRejectsMalformedAddresses = do
  guardianGovernance <- allocateParty "UpgradeAddressGovernance"
  feeCustody <- allocateParty "UpgradeAddressFeeCustody"
  placeholderFeeInstrumentAdmin <- allocateParty "UpgradeAddressUnusedFeeInstrumentAdmin"
  now <- getTime
  let feeInstrument = InstrumentId with admin = placeholderFeeInstrumentAdmin, id = "UNUSED"
      genesisState = mkInitialCoreState guardianGovernance solanaGovernanceChainId
                       defaultGovernanceContract
                       GenesisGuardianSet with guardianSetIndex = 0, guardians = [devnetGenesisGuardian]
                       feeInstrument feeCustody
      upgradeTo newKeys = applyGovernance genesisState now (GuardianSetUpgrade with chain = 0, newIndex = 1, newKeys)
  forA_
    [ ([zeroGuardianAddress], "zero address at position 0")
    , ([devnetGuardianSet1Key, zeroGuardianAddress], "zero address at position 1")
    , ([devnetGuardianSet1Key, devnetGuardianSet1Key], "duplicate address")
    , ([], "empty set")
    ] \(newKeys, fragment) -> case upgradeTo newKeys of
        Left message | fragment `T.isInfixOf` message -> pure ()
        outcome -> abort ("upgrade admitted or wrong error: " <> show (newKeys, fmap (.guardianSetIndex) outcome))
  isRight (upgradeTo [devnetGuardianSet1Key]) === True

-- | A payload above the 750 bytes of whitepaper 0004 publishes (EVM parity).
testPublishAcceptsPayloadAbove750Bytes : Script ()
testPublishAcceptsPayloadAbove750Bytes = do
  (guardianGovernance, csId) <- setup
  bob <- allocateParty "Bob"
  emitterId <- registerEmitter guardianGovernance bob
  let payloadOf751Bytes = parseHexTextOrAbort (mconcat (replicate 751 "ff"))
  (_, message) <- publishVia guardianGovernance csId bob emitterId 0 payloadOf751Bytes 0
  message.payload === payloadOf751Bytes
  message.sequence === 0

-- | Sanity check on quorum thresholds (EVM parity: floor(n*2/3)+1).
testQuorum : Script ()
testQuorum = do
  quorum 1 === 1
  quorum 3 === 3
  quorum 4 === 3
  quorum 19 === 13
  pure ()

-- | The current guardian set is installed at index 0 and never expires.
testInitialGuardianSet : Script ()
testInitialGuardianSet = do
  (guardianGovernance, csId) <- setup
  Some cs <- queryContractId guardianGovernance csId
  cs.guardianSetIndex === 0
  let gs = fromSome (Map.lookup 0 cs.guardianSets)
  guardianAddressesOf gs === [devnetGuardian]
  gs.expirationTime === None

-- | On-chain VAA verification accepts a genuine guardian signature: parses the
-- VAA and verifies it against guardian set 0 (the devnet guardian). This
-- exercises the full keccak256 + DER + secp256k1WithEcdsaOnly path.
testParseAndVerifyVAA : Script ()
testParseAndVerifyVAA = do
  (guardianGovernance, csId) <- setup
  vaa <- submit guardianGovernance do
    exerciseCmd csId ParseAndVerifyVAA with
      verifier = guardianGovernance
      encodedVAA = govSetFeeVAA
  vaa.guardianSetIndex === 0
  vaa.emitterChain === 1
  vaa.sequence === 1

-- | ParseAndVerifyVAA is genuinely permissionless: an external party with no
-- relationship to CoreState (not guardianGovernance or the fee custody party, its
-- only two stakeholders) verifies a VAA as itself, given only CoreState disclosed to it
-- -- a data attachment, not an approval.
testParseAndVerifyVAAByExternalVerifier : Script ()
testParseAndVerifyVAAByExternalVerifier = do
  (guardianGovernance, csId) <- setup
  tokenBridge <- allocateParty "ExternalTokenBridge"
  Some dCs <- queryDisclosure guardianGovernance csId
  vaa <- submitWithDisclosures tokenBridge [dCs] do
    exerciseCmd csId ParseAndVerifyVAA with
      verifier = tokenBridge
      encodedVAA = govSetFeeVAA
  vaa.guardianSetIndex === 0
  vaa.emitterChain === 1
  vaa.sequence === 1

-- | Integration entrypoint, invoked by the Go integration test via `dpm script`
-- against a live sandbox/participant. Same scenario as
-- 'testParseAndVerifyVAAByExternalVerifier'; returns the external verifier's
-- party id so the Go test can sanity-check it (a real, hosted party).
integrationParseAndVerifyVAAByExternalVerifier : Script Party
integrationParseAndVerifyVAAByExternalVerifier = do
  (guardianGovernance, csId) <- setup
  tokenBridge <- allocateParty "IntegrationExternalVerifier"
  Some dCs <- queryDisclosure guardianGovernance csId
  vaa <- submitWithDisclosures tokenBridge [dCs] do
    exerciseCmd csId ParseAndVerifyVAA with
      verifier = tokenBridge
      encodedVAA = govSetFeeVAA
  vaa.guardianSetIndex === 0
  vaa.emitterChain === 1
  vaa.sequence === 1
  pure tokenBridge

-- | A SetMessageFee governance VAA verifies and updates the message fee. A
-- relayer submits alone with the 'CoreState' disclosed (guardianGovernance's
-- authority is inherited from the archived contract).
testGovernanceSetMessageFee : Script ()
testGovernanceSetMessageFee = do
  (guardianGovernance, csId) <- setup
  relayer <- allocateParty "SetFeeRelayer"
  newCsId <- submitGovernanceAs guardianGovernance relayer csId govSetFeeVAA
  Some cs <- queryContractId guardianGovernance newCsId
  cs.messageFee === 1000

-- | Governance replay protection (the 'consumedGovernance' set) still rejects
-- a resubmitted governance VAA.
testGovernanceReplayRejected : Script ()
testGovernanceReplayRejected = do
  (guardianGovernance, csId) <- setup
  newCsId <- submit guardianGovernance do
    exerciseCmd csId SubmitGovernanceVAA with
      submitter = guardianGovernance
      encodedVAA = govSetFeeVAA
  submitMustFail guardianGovernance do
    exerciseCmd newCsId SubmitGovernanceVAA with
      submitter = guardianGovernance
      encodedVAA = govSetFeeVAA

-- | GuardianSetUpgrade(0 -> 1) to deterministic devnet key 1, signed by set 0.
-- Generated by node/hack/canton_localnet_vaa (-kind guardian-set-upgrade -sequence 2).
govGuardianSetUpgradeVAA : EncodedVaa
govGuardianSetUpgradeVAA = parseHexTextOrAbort ""

-- | TransferFees(chain 75, amount 9, recipient d4 x 32) signed by set 0, sequence 4.
-- Generated and drift-guarded by node/pkg/cantonclient/vectorgen_test.go.
govTransferFeesVAA : EncodedVaa
govTransferFeesVAA = parseHexTextOrAbort ""

-- | ContractUpgrade(chain 75, new contract c1 x 32) signed by set 0
-- (node/hack/canton_localnet_vaa -kind contract-upgrade -new-contract c1..c1 -sequence 5).
govContractUpgradeVAA : EncodedVaa
govContractUpgradeVAA = parseHexTextOrAbort ""

-- | Address and 65-byte public key of deterministic devnet key 1 (guardian set 1).
devnetGuardianSet1Key : GuardianAddress
devnetGuardianSet1Key = parseHexTextOrAbort "88d7d8b32a9105d228100e72dffe2fae0705d31c"

devnetGuardianSet1PubKey : GuardianPublicKey
devnetGuardianSet1PubKey = parseHexTextOrAbort "04de9544a079988df10b0c847a401862b62d8074b02b994ed5a4f96e6078ee048bd5fd0b55e75345d60511e8d822f8b618c5e8e1fa7a9db841014a8a091f7c4119"

-- | Message VAA signed by guardian set 1 (node/hack/canton_localnet_vaa -kind message -sequence 7).
set1MessageVAA : EncodedVaa
set1MessageVAA = parseHexTextOrAbort ""

-- | SetMessageFee(chain 75, fee 0) signed by set 0 (node/hack/canton_localnet_vaa -kind set-message-fee -sequence 3).
set0SetFeeZeroVAA : EncodedVaa
set0SetFeeZeroVAA = parseHexTextOrAbort ""

-- | After a GuardianSetUpgrade, set 1 verifies, set 0 verifies until now + 86400 s, and
-- governance signed by set 0 is rejected at once (current set only).
testGuardianSetUpgradeExpiry : Script ()
testGuardianSetUpgradeExpiry = do
  (guardianGovernance, csId) <- setup
  upgradedAt <- getTime
  newCsId <- submit guardianGovernance do
    exerciseCmd csId SubmitGovernanceVAA with
      submitter = guardianGovernance
      encodedVAA = govGuardianSetUpgradeVAA
  Some cs <- queryContractId guardianGovernance newCsId
  cs.guardianSetIndex === 1
  guardianAddressesOf (fromSome (Map.lookup 1 cs.guardianSets)) === [devnetGuardianSet1Key]
  (fromSome (Map.lookup 1 cs.guardianSets)).expirationTime === None
  (fromSome (Map.lookup 0 cs.guardianSets)).expirationTime
    === Some (addRelTime upgradedAt (seconds guardianSetExpirySeconds))
  attachedCsId <- submit guardianGovernance do
    exerciseCmd newCsId AttachGuardianPublicKeys with
      submitter = guardianGovernance, targetGuardianSetIndex = 1, guardianPublicKeys = [devnetGuardianSet1PubKey]
  let verifyWith encodedVAA = exerciseCmd attachedCsId ParseAndVerifyVAA with
        verifier = guardianGovernance
        encodedVAA
  set1Vaa <- submit guardianGovernance do verifyWith set1MessageVAA
  set1Vaa.guardianSetIndex === 1
  set0Vaa <- submit guardianGovernance do verifyWith govSetFeeVAA
  set0Vaa.guardianSetIndex === 0
  submitMustFail guardianGovernance do
    exerciseCmd attachedCsId SubmitGovernanceVAA with
      submitter = guardianGovernance
      encodedVAA = set0SetFeeZeroVAA
  -- EVM boundary in whole seconds: accepted through the last microsecond of the expiry second.
  passTime (seconds guardianSetExpirySeconds)
  getTime >>= (=== addRelTime upgradedAt (seconds guardianSetExpirySeconds))
  _ <- submit guardianGovernance do verifyWith govSetFeeVAA
  passTime (microseconds 999999)
  _ <- submit guardianGovernance do verifyWith govSetFeeVAA
  passTime (microseconds 1)
  submitMustFail guardianGovernance do verifyWith govSetFeeVAA
  set1VaaAfterExpiry <- submit guardianGovernance do verifyWith set1MessageVAA
  set1VaaAfterExpiry.guardianSetIndex === 1

-- | Integration entrypoint, invoked by the Go integration test via
-- `dpm script` (NOT by `dpm test`): set up the bridge, register an emitter,
-- publish one message (nonce 42, payload 0x11223344) by cid, and return the
-- guardianGovernance party so the watcher can read the ledger as it. The emitter address
-- is not chosen here: the watcher derives it from the message's identity
-- components, which the Go test recomputes.
integrationPublish : Script Party
integrationPublish = do
  (guardianGovernance, csId) <- setup
  owner <- allocateParty "IntegrationEmitter"
  emId <- registerEmitter guardianGovernance owner
  _ <- publishVia guardianGovernance csId owner emId 42 (parseHexTextOrAbort "11223344") 0
  pure guardianGovernance

-- | Exercise the auto-generated Archive choice on each template (for coverage).
-- guardianGovernance archives the registry; no other party can.
testArchives : Script ()
testArchives = do
  (guardianGovernance, csId) <- setup
  stranger <- allocateParty "ArchStranger"
  Some cs <- queryContractId guardianGovernance csId
  -- CoreState is co-signed, so archiving needs guardianGovernance and feeRecipient.
  submitMustFail guardianGovernance do archiveCmd csId
  submit (actAs guardianGovernance <> actAs cs.feeRecipient) do archiveCmd csId
  bob <- allocateParty "ArchBob"
  emId <- registerEmitter guardianGovernance bob
  -- Emitter is signed by the owner and guardianGovernance; both must authorize.
  submitMustFail bob do archiveCmd emId
  submit (actAs bob <> actAs guardianGovernance) do archiveCmd emId
  [(regId, _)] <- query @EmitterRegistry guardianGovernance
  regDisclosure <- fromSome <$> queryDisclosure guardianGovernance regId
  submitMustFail (actAs stranger <> disclose regDisclosure) do archiveCmd regId
  submit guardianGovernance do archiveCmd regId
  pure ()
