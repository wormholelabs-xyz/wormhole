# Build & test the Wormhole Global Accountant Solana program.
#
# The program is loaded by mollusk-svm in integration tests, so the SBF
# binary must exist before `cargo test` runs.

# Exported into every recipe so `cargo test` finds the freshly-built `.so`.
export SBF_OUT_DIR := justfile_directory() / "target/deploy"

# Pre-built `solana-noreplay` artefact required by the real-CPI e2e targets
# below. Override via the env if you keep the noreplay checkout elsewhere.
NOREPLAY_SO := env_var_or_default("NOREPLAY_SO", env_var("HOME") / "WormholeLabs/CoreTeam/solana-noreplay/target/deploy/solana_noreplay.so")

# Default recipe: list available targets with their docstrings.
default:
    @just --list

# Two build targets. Keep the split unambiguous:
#
#   * build-dev   — test/dev build with `test-only-open-digest` exposed. This
#                   is what `test` depends on; the resulting `.so` exposes
#                   the `OpenDigest` arm for direct mollusk test drives. The
#                   noreplay and Shim CPIs are real in both builds — mocks were
#                   retired in favour of sibling-program fixtures loaded by
#                   mollusk.
#   * build-prod  — production build with `test-only-open-digest` OFF. The
#                   `open_digest` direct entrypoint is not in the dispatch
#                   table. Shape that will ship to mainnet.

[doc("Dev build with `test-only-open-digest` exposed for mollusk tests.")]
build-dev: build-test-fixtures
    cargo build-sbf --features bpf-entrypoint,test-only-open-digest

[doc("Production-shape SBF build — no test-only features.")]
build-prod:
    cargo build-sbf --features bpf-entrypoint

[doc("Alias for `build-dev`; CI should call build-dev/build-prod explicitly.")]
build: build-dev

# The mollusk suite CPIs into two sibling programs:
#   * solana_noreplay.so       (real replay-protection bitmap program)
#   * wormhole_verify_vaa_shim.so (real Verify VAA Shim)
# The canonical `.so` files are hash-pinned under
# `programs/global-accountant/tests/fixtures/`. The mollusk test harness
# verifies each fixture's SHA-256 against a hard-coded constant in
# `tests/common/mollusk_fixtures.rs` before loading; drift panics with the
# recompute-and-update recipe inline in the failure message.
#
# To intentionally regenerate a fixture:
#   1. Build the upstream program (cd <sibling-repo> && cargo build-sbf).
#   2. Copy the resulting .so over tests/fixtures/<name>.so.
#   3. Recompute the digest:
#        shasum -a 256 programs/global-accountant/tests/fixtures/<name>.so
#   4. Update the corresponding *_SO_SHA256 constant in mollusk_fixtures.rs.
#   5. Commit both the .so and the const update in the same change.
#
# For local iteration without rebaking the fixture, point an env override at
# your locally-built .so:
#   GA_NOREPLAY_SO=/path/to/solana_noreplay.so cargo test ...
#   GA_VERIFY_VAA_SHIM_SO=/path/to/wormhole_verify_vaa_shim.so cargo test ...
# The override skips the SHA-256 check (active-development escape hatch).
#
# Retained as a no-op for compatibility with the previous workflow; nothing
# depends on it anymore beyond `build-dev`'s vestigial wire-up.

[doc("No-op kept for compatibility — test fixtures are hash-pinned, see comment block.")]
build-test-fixtures:
    @echo "test fixtures are hash-pinned under tests/fixtures/ — no rebuild needed"
    @echo "to regenerate, see the comment block above this recipe in the justfile"

[doc("Mollusk integration tests (builds dev-shape .so for OpenDigest direct entry).")]
test: build-dev
    cargo test --features test-only-open-digest

# Surfpool E2E test against a Solana mainnet fork. surfpool boots with
# `--rpc-url` pointing at mainnet so the Verify VAA Shim, the Core Bridge,
# and the active `GuardianSet` PDA lazy-fetch from upstream. The test deploys
# the production-shape `.so` (no `mock-vaa`) so the real Shim CPI is exercised
# end-to-end against a real historical VAA. The DigestAccount PDA the test
# closes is hand-crafted via the `surfnet_setAccount` cheatcode (the prod-shape
# build does not expose `open_digest`).
#
# Default datasource: the public RPC from
# `~/WormholeLabs/CoreTeam/w7-registry/chains/mainnet/solana.yaml`. surfpool
# v1.2.1 cannot inject the `Origin` header that the labsapis proxy requires,
# so the proxy is not the default — override with `GA_E2E_DATASOURCE_RPC=<url>`
# for an endpoint that does not enforce CORS.
#
# Build features: the test crate is configured with the workspace default of
# `mock-vaa,test-only-open-digest,mock-noreplay` enabled — these affect only
# the program binary, not the host-side test code, so the test compiles fine
# either way. The deployed `.so` comes from `build-prod`, i.e. *neither*
# feature on, so the real `close_digest` CPI is what executes inside the simnet.

[doc("Surfpool E2E: close_digest against a real historical VAA on mainnet fork.")]
test-e2e-mainnet-fork: build-prod
    cargo test --features test-only-open-digest \
        --test surfpool_e2e_mainnet_fork -- --ignored --nocapture

# VAA-replay corpus. Replays a curated set of historical mainnet VAAs
# (~7 fixtures in `tests/fixtures/`) against the production-shape `.so`. Each
# test owns its own surfpool subprocess for isolation. Three corpus entries
# (GS1, GS4, GS5) target the historical guardian-set ceiling concern and are
# expected to fail at the Shim CPI — they assert the failure rather than
# success, so a Shim policy change will flip them and surface a regression.
#
# Same build/datasource story as `test-e2e-mainnet-fork`.

[doc("Surfpool E2E: replay ~7 historical VAAs (GS1/GS4/GS5 are expected-fail).")]
test-e2e-vaa-corpus: build-prod
    cargo test --features test-only-open-digest \
        --test surfpool_e2e_vaa_corpus -- --ignored --nocapture

# Surfpool e2e for `submit_observations` driven against the real
# `solana-noreplay` program. Deploys both `global_accountant.so` (production
# shape — no mock-noreplay) and `solana_noreplay.so`, drives 13 distinct
# guardian observations end-to-end, and asserts the bitmap bit gets set in
# the real noreplay PDA. A 14th submission must fail with `AlreadyAccounted`
# via the direct-read pre-check.

[doc("Surfpool E2E: submit_observations driven against the real solana-noreplay.")]
test-e2e-submit-obs: _require-noreplay-so build-prod
    cargo test --features test-only-open-digest \
        --test surfpool_e2e_submit_observations_real_noreplay -- --ignored --nocapture

# Surfpool e2e for `submit_vaas` driven against the real Verify VAA Shim and
# real `solana-noreplay` programs. Deploys both `global_accountant.so`
# (production shape) and `solana_noreplay.so`, pre-posts the signatures of a
# historical Token Bridge transfer VAA via the Shim's `PostSignatures`, and
# calls `submit_vaas` to apply the transfer.

[doc("Surfpool E2E: submit_vaas against real Verify VAA Shim + real noreplay.")]
test-e2e-submit-vaas: _require-noreplay-so build-prod
    cargo test --features test-only-open-digest \
        --test surfpool_e2e_submit_vaas -- --ignored --nocapture

# Unified surfpool E2E target. Each test binary owns its own surfpool
# subprocess for PDA isolation and per-test failure scoping. CI runs this
# target so every layer is exercised in one job with a single warm cargo
# cache and a single warm surfpool mainnet-account cache.
#
# `--test-threads=1` is honoured by every leaf target to keep CI
# deterministic — bound port allocation under load was flaky with parallel
# surfpool boots. Bump locally with `RUST_TEST_THREADS=N` if your network
# can take more.

[doc("All four surfpool E2E layers. CI runs this for one-job, one-cache coverage.")]
test-e2e: test-e2e-mainnet-fork test-e2e-vaa-corpus test-e2e-submit-obs test-e2e-submit-vaas
    @echo "All surfpool E2E layers green."

# Private prerequisite: fail fast with a helpful message if the noreplay .so
# is missing. Underscore prefix hides this from `just --list`.
[private]
_require-noreplay-so:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{ NOREPLAY_SO }}" ]; then
        echo "ERROR: {{ NOREPLAY_SO }} not found." >&2
        echo "Rebuild via: cd ~/WormholeLabs/CoreTeam/solana-noreplay && just build" >&2
        exit 1
    fi

# SBF-target type-check. There is no upstream `cargo check-sbf`, but
# `cargo build-sbf` registers the platform-tools compiler with rustup (e.g.
# `1.89.0-sbpf-solana-v1.52`), which can drive a plain `cargo check` against
# the real `sbpf-solana-solana` target. This checks the exact cfg shape that
# ships (`target_os = "solana"` arms, real syscall declarations) without the
# cost of a full `build-sbf`, and without the host-side cfg fallbacks that
# `cargo check` on the host exercises. Both feature shapes are covered,
# mirroring the clippy/clippy-prod split. The toolchain name embeds the
# platform-tools version, so it is discovered rather than hard-coded.
#
# Note: clippy cannot run on this toolchain (Anza ships no cargo-clippy for
# platform-tools, and rustup cannot add components to custom toolchains).
# RUSTFLAGS=-Dwarnings promotes the compiler's own lints to errors on the SBF
# target; `clippy-sbf` below approximates clippy coverage of the SBF arms.

[doc("Type-check against the real SBF target (sbpf-solana-solana), warnings denied.")]
check:
    #!/usr/bin/env bash
    set -euo pipefail
    toolchain=$(rustup toolchain list | awk '/sbpf-solana/ {print $1; exit}')
    if [ -z "${toolchain}" ]; then
        echo "ERROR: no sbpf-solana platform-tools toolchain found in rustup." >&2
        echo "Run 'cargo build-sbf' once to install it." >&2
        exit 1
    fi
    echo "Using toolchain: ${toolchain}"
    export RUSTFLAGS="-Dwarnings"
    cargo "+${toolchain}" check --locked --target sbpf-solana-solana \
        -p global-accountant --features bpf-entrypoint,test-only-open-digest
    cargo "+${toolchain}" check --locked --target sbpf-solana-solana \
        -p global-accountant --features bpf-entrypoint

# SBF-arm clippy. The platform-tools toolchain ships no clippy, but upstream
# nightly clippy knows the tier-3 `bpfel-unknown-none` target, which sets
# `target_arch = "bpf"` — the second arm of the crate's cfg pattern
# (`any(target_os = "solana", target_arch = "bpf")`), kept precisely so this
# recipe can lint the SBF-shaped code (syscalls, entrypoint, no_std). Tier 3
# ships no prebuilt core/alloc, hence nightly + rust-src + `-Zbuild-std`.
#
# Caveats, recorded so nobody is surprised later:
#   * Approximation: code gated *exclusively* on `target_os = "solana"` is
#     invisible here. The crate's convention is the `any(...)` pattern, which
#     keeps coverage effectively total — maintain that convention.
#   * Nightly: clippy lint names drift (e.g. workspace lint tables may emit
#     `renamed_and_removed_lints` warnings). Supplementary gate only; the
#     stable host `clippy`/`clippy-prod` targets remain authoritative.

[doc("Nightly clippy of the SBF-shaped code via bpfel-unknown-none.")]
clippy-sbf:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! cargo +nightly clippy --version >/dev/null 2>&1; then
        echo "ERROR: nightly clippy not available." >&2
        echo "Run 'rustup component add clippy --toolchain nightly'." >&2
        exit 1
    fi
    if ! rustup component list --toolchain nightly --installed 2>/dev/null | grep -q rust-src; then
        echo "ERROR: rust-src not installed for nightly (required by -Zbuild-std)." >&2
        echo "Run 'rustup component add rust-src --toolchain nightly'." >&2
        exit 1
    fi
    cargo +nightly clippy --locked -Zbuild-std=core,alloc --target bpfel-unknown-none \
        -p global-accountant -p global-accountant-definitions \
        --features bpf-entrypoint,test-only-open-digest -- -D warnings
    cargo +nightly clippy --locked -Zbuild-std=core,alloc --target bpfel-unknown-none \
        -p global-accountant -p global-accountant-definitions \
        --features bpf-entrypoint -- -D warnings

[doc("Clippy with the dev feature combo (matches build-dev).")]
clippy:
    cargo clippy --all-targets --features test-only-open-digest -- -D warnings

# Production-shape clippy. Mirrors `build-prod` — no test features enabled,
# so this catches lint regressions that the default `clippy` target would
# miss because it always exercises the dev feature combo. CI should run both
# targets; a regression that only trips here means the production build is
# affected.

[doc("Production-shape clippy — no test features, catches regressions clippy misses.")]
clippy-prod:
    cargo clippy -p global-accountant -- -D warnings
    cargo clippy -p global-accountant-definitions -- -D warnings

[doc("cargo clean.")]
clean:
    cargo clean
