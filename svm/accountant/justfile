# Build & test the Wormhole Global Accountant Solana program.
#
# The program is loaded by mollusk-svm in integration tests, so the SBF
# binary must exist before `cargo test` runs.
#
# Two build paths, deliberately separate:
#   `just build-devnet` values below; what `test`, `check`, `clippy` use
#   `just build`       deploy build; every address and key comes from the
#                      caller's environment, and a missing one aborts

# Exported into every recipe so `cargo test` finds the freshly-built `.so`.
export SBF_OUT_DIR := justfile_directory() / "target/deploy"

# Test-environment addresses and keys, read by `crates/definitions` and the two
# program crates via `env!` at compile time. Variable names match
# `wormhole-svm-definitions` (`from-env`) and `solana-noreplay`.
#
# Mainnet Core Bridge and shim (the fixtures are mainnet data), devnet NoReplay
# (its only deployment). That mix is a test environment, not any one network.
# `ACCOUNTANT_PROGRAM_ID` is the mollusk/surfpool fixture address, asserted
# against each `declare_id!` at compile time. `BACKFILL_AUTHORITY` is the
# deterministic test keypair `Keypair::new_from_array([1u8; 32])`.
#
# Plain variables, not exports. `build` below has to see an empty environment
# when the caller has set nothing, so a deploy artifact can never inherit a test
# value by accident.
TEST_BRIDGE_ADDRESS := "worm2ZoG2kUd4vFXhvjh93UUH596ayRfgQ2MgjNMTth"
TEST_VERIFY_VAA_SHIM_PROGRAM_ID := "EFaNWErqAtVWufdNb7yofSHHfWFos843DFpu4JBw24at"
TEST_NOREPLAY_PROGRAM_ID := "repMHgR5BEpGLeZvM5iGoNNDPw4eu2BS6sXJzaC8K4t"
TEST_ACCOUNTANT_PROGRAM_ID := "YMN9Qj5jPNp7j14VPcML1B6xGgcPWVZUGLFU3Mnyfaf"
TEST_BACKFILL_AUTHORITY := "AKnL4NNf3DGWZJS6cPknBuEGnVsV4A4m5tgebLHaRSZ9"

# Names the deploy build requires in the caller's environment.
DEPLOY_VARS := "BRIDGE_ADDRESS VERIFY_VAA_SHIM_PROGRAM_ID NOREPLAY_PROGRAM_ID \
    ACCOUNTANT_PROGRAM_ID BACKFILL_AUTHORITY"

# Prefix that puts the test values into one command's environment.
test_env := "BRIDGE_ADDRESS=" + TEST_BRIDGE_ADDRESS + \
    " VERIFY_VAA_SHIM_PROGRAM_ID=" + TEST_VERIFY_VAA_SHIM_PROGRAM_ID + \
    " NOREPLAY_PROGRAM_ID=" + TEST_NOREPLAY_PROGRAM_ID + \
    " ACCOUNTANT_PROGRAM_ID=" + TEST_ACCOUNTANT_PROGRAM_ID + \
    " BACKFILL_AUTHORITY=" + TEST_BACKFILL_AUTHORITY

# Default recipe: list available targets with their docstrings.
default:
    @just --list

# `build-devnet` and `build` compile identical code. They differ only in where the
# compile-time addresses and keys come from. The older dev/prod split gated the
# `test-only-open-digest` feature on/off; with `open_digest` removed entirely
# (canonical digest record now emitted via `sol_log_data`), no feature
# difference remains.
#
# Anchor programs build fine under plain `cargo build-sbf` (still an ordinary
# SBF cdylib under the hood). The old `--features bpf-entrypoint` flag is
# gone: Anchor's entrypoint is present by default and only suppressed via
# `no-entrypoint` (see `programs/global-accountant/Cargo.toml`), the inverse
# of the old opt-in polarity.

[doc("SBF build with the values above. Devnet NoReplay, but MAINNET Core Bridge and the test authority key -- see the comment above them.")]
build-devnet:
    {{test_env}} cargo build-sbf

# Deploy build. Every compile-time address and key comes from the caller's
# environment; a missing one aborts before `cargo` runs. Verify the result with
# `just verify-authority <so-path> <operator-pubkey>` before a mainnet deploy.
[doc("SBF build for deploy. Every address and key must be set in the environment.")]
build:
    #!/usr/bin/env bash
    set -euo pipefail
    missing=()
    for v in {{DEPLOY_VARS}}; do
        [ -n "${!v:-}" ] || missing+=("${v}")
    done
    if [ ${#missing[@]} -ne 0 ]; then
        echo "ERROR: deploy build needs these set in the environment:" >&2
        printf '  %s\n' "${missing[@]}" >&2
        echo "Run 'just build-devnet' for a devnet/test artifact." >&2
        exit 1
    fi
    cargo build-sbf

[doc("Alias of `build` (deploy build), preserved for existing scripts.")]
build-prod: build

# The mollusk suite CPIs into the real `solana_noreplay.so` and
# `wormhole_verify_vaa_shim.so`, embedded by `crates/test-fixtures` with a
# pinned SHA-256 each; drift panics with the regen recipe (see that crate's
# `src/lib.rs`).
#
# For local iteration without rebaking the fixture, point an env override at
# your locally-built .so:
#   GA_NOREPLAY_SO=/path/to/solana_noreplay.so just test
#   GA_VERIFY_VAA_SHIM_SO=/path/to/wormhole_verify_vaa_shim.so just test
# The override skips the SHA-256 check (active-development escape hatch).

[doc("Mollusk integration tests.")]
test: build-devnet
    {{test_env}} cargo test

# Verify a deploy-ready `.so` enforces a specific operator authority pubkey,
# independent of the `BACKFILL_AUTHORITY` compiled into this source tree.
# Runs the target `.so`'s authority check inside a mollusk-hosted SBF VM.
# Run against the actual production artifact and intended operator pubkey
# before every mainnet deploy.
[doc("Verify a deploy-ready .so enforces a specific operator authority pubkey.")]
verify-authority so_path pubkey:
    {{test_env}} GA_VERIFY_SO={{so_path}} GA_EXPECT_AUTHORITY_BASE58={{pubkey}} \
        cargo test -p global-accountant-backfill --test artifact_authority_check \
        -- --ignored --nocapture verify_so_enforces_specific_operator_authority

# SBF-target type-check. There is no upstream `cargo check-sbf`, but
# `cargo build-sbf` registers the platform-tools compiler with rustup (e.g.
# `1.89.0-sbpf-solana-v1.52`), which can drive a plain `cargo check` against
# the real `sbpf-solana-solana` target. This checks the exact cfg shape that
# ships (`target_os = "solana"` arms, real syscall declarations) without the
# cost of a full `build-sbf`. The toolchain name embeds the platform-tools
# version, so it is discovered rather than hard-coded.
#
# Note: clippy cannot run on this toolchain (Anza ships no cargo-clippy for
# platform-tools, and rustup cannot add components to custom toolchains).
# RUSTFLAGS=-Dwarnings promotes the compiler's own lints to errors on the SBF
# target; `clippy-sbf` below approximates clippy coverage of the SBF arms.

[doc("Type-check against the real SBF target (sbpf-solana-solana), warnings denied. With no arguments, checks every program; pass program names to narrow (e.g. `just check global-accountant`).")]
check *programs:
    #!/usr/bin/env bash
    set -euo pipefail
    toolchain=$(rustup toolchain list | awk '/sbpf-solana/ {print $1; exit}')
    if [ -z "${toolchain}" ]; then
        echo "ERROR: no sbpf-solana platform-tools toolchain found in rustup." >&2
        echo "Run 'cargo build-sbf' once to install it." >&2
        exit 1
    fi

    # Package names, not directory names: a manifest's `name` can differ from
    # its directory.
    all=()
    for m in programs/*/Cargo.toml; do
        all+=("$(awk -F'"' '/^name = /{print $2; exit}' "${m}")")
    done
    if [ ${#all[@]} -eq 0 ]; then
        echo "ERROR: no program manifests found under programs/*/Cargo.toml." >&2
        exit 1
    fi

    # bash 3.2 (macOS default) rejects `"${arr[@]}"` on an empty array under
    # `set -u`; check the length before any such expansion.
    requested=({{programs}})
    targets=()
    if [ ${#requested[@]} -eq 0 ]; then
        targets=("${all[@]}")
    else
        for name in "${requested[@]}"; do
            match=""
            for p in "${all[@]}"; do
                if [ "${p}" = "${name}" ]; then
                    match="${p}"
                    break
                fi
            done
            if [ -z "${match}" ]; then
                echo "ERROR: unknown program '${name}'. Available:" >&2
                printf '  %s\n' "${all[@]}" >&2
                exit 1
            fi
            targets+=("${match}")
        done
    fi

    args=()
    for t in "${targets[@]}"; do
        args+=(-p "${t}")
    done

    echo "Using toolchain: ${toolchain}"
    export RUSTFLAGS="-Dwarnings"
    {{test_env}} cargo "+${toolchain}" check --locked --target sbpf-solana-solana "${args[@]}"

# `clippy-sbf` (nightly clippy against the tier-3 `bpfel-unknown-none` target
# via `-Zbuild-std=core,alloc`) is gone as of the anchor-lang 1.1.2 migration.
# It only ever worked because the pinocchio-era crates were `no_std`
# (`#![cfg_attr(any(target_os = "solana", target_arch = "bpf"), no_std)]`),
# so a bare `core`+`alloc` sysroot sufficed. Anchor is not `no_std`-compatible
# (`anchor-derive-accounts`' generated code alone reaches for
# `std::collections::BTreeSet`), and `bpfel-unknown-none` — "none" meaning no
# OS/std support — has no `std` to build, even under `-Zbuild-std`. Only
# Anza's platform-tools toolchain (used by `build`/`check` above) carries a
# custom sysroot with SBF-target `std` support. `crates/definitions` alone
# stays `no_std` (anchor-free), but it is a small, already-portable leaf crate
# with no syscalls of its own; `check` above remains the sole SBF-target lint
# pass for the workspace (clippy itself is still unavailable there — Anza
# ships no `cargo-clippy` for platform-tools).

[doc("Clippy against the host build.")]
clippy:
    {{test_env}} cargo clippy --all-targets -- -D warnings

# Surfpool e2e suite (tests/surfpool/, one binary, all tests `#[ignore]`).
# Single-threaded: each test spawns its own surfpool plus program deploys.
# The upgrade_contract module is a two-step flow with its own recipes below.

# Both programs hold a `surfpool` target, so each recipe names its package.

[doc("Surfpool e2e: submit_vaas and submit_observations against a fresh surfpool.")]
e2e: build-devnet
    {{test_env}} cargo test -p global-accountant --test surfpool -- --ignored --test-threads=1 --skip upgrade_contract --nocapture

# Two-step upgrade_contract e2e. Step 1 leaves a detached surfpool running and
# records its pid + RPC URL in target/e2e-upgrade-contract.json; step 2 targets
# that instance; stop kills it. See tests/surfpool/upgrade_contract.rs.

[doc("upgrade_contract e2e step 1: start surfpool, deploy the accountant as upgradeable (authority = upgrade PDA), stage the buffer.")]
e2e-upgrade-deploy: build-devnet
    {{test_env}} cargo test -p global-accountant --test surfpool upgrade_contract::deploy_upgradeable_accountant -- --ignored --exact --nocapture

[doc("upgrade_contract e2e step 2: sign and submit the UpgradeContract VAA against the running surfpool.")]
e2e-upgrade-submit:
    {{test_env}} cargo test -p global-accountant --test surfpool upgrade_contract::submit_upgrade_vaa -- --ignored --exact --nocapture

[doc("Surfpool e2e: the backfill lifecycle and the cost probes.")]
e2e-backfill: build-devnet
    {{test_env}} cargo test -p global-accountant-backfill --test surfpool -- --ignored --test-threads=1 --nocapture

[doc("upgrade_contract e2e: kill the surfpool from step 1.")]
e2e-upgrade-stop:
    #!/usr/bin/env bash
    set -euo pipefail
    state="target/e2e-upgrade-contract.json"
    if [ ! -f "${state}" ]; then
        echo "no ${state}; nothing to stop"
        exit 0
    fi
    pid=$(python3 -c "import json; print(json.load(open('${state}'))['surfpool_pid'])")
    kill "${pid}" 2>/dev/null && echo "killed surfpool pid ${pid}" || echo "surfpool pid ${pid} already gone"
    rm -f "${state}"

[doc("Audit Cargo.lock against the RustSec advisory database.")]
audit:
    cargo audit

[doc("cargo clean.")]
clean:
    cargo clean
